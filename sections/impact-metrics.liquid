<div
  class="vt-impact-metrics{% if section.settings.full_width %} full-width{% endif %}"
  id="vtImpactMetrics-{{ section.id }}"
  style="
    --bg-color: {{ section.settings.bg_color | default: '#F8F9DC' }};
    --heading-color: {{ section.settings.heading_color | default: '#003225' }};
    --subtitle-color: {{ section.settings.subtitle_color | default: '#224E09' }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --cards-margin-top: {{ section.settings.cards_margin_top | default: 64 }}px;
  "
>
  <div class="vt-impact-metrics__container">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-impact-metrics {
    width: 100%;
    background-color: var(--bg-color, #F8F9DC);
    color: var(--subtitle-color, #224E09);
    padding-top: var(--padding-top, 80px);
    padding-bottom: var(--padding-bottom, 80px);
    box-sizing: border-box;
  }

  .vt-impact-metrics__container {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    padding-left: 34px;
    padding-right: 34px;
  }

  .vt-impact-metrics:not(.full-width) .vt-impact-metrics__container {
    max-width: 1200px;
  }

  .vt-impact-metrics.full-width .vt-impact-metrics__container {
    max-width: 100%;
  }

  @media screen and (max-width: 768px) {
    .vt-impact-metrics__container {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  /* Ensure shopify-block wrappers stretch full width */
  .vt-impact-metrics__container > .shopify-block,
  .vt-impact-metrics .group > .shopify-block {
    width: 100% !important;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Header heading default color and styles */
  .vt-impact-metrics .vt-heading-group {
    color: var(--heading-color, #003225);
  }

  .vt-impact-metrics .vt-heading-group .vt-heading {
    color: inherit;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Header subtitle styling - consistent with rich-text */
  .vt-impact-metrics .vt-paragraph:not(.vt-stat-card .vt-paragraph) {
    color: var(--subtitle-color, #224E09);
    margin-top: 0;
    margin-bottom: 0;
  }

  .vt-impact-metrics .vt-paragraph:not(.vt-stat-card .vt-paragraph) p {
    color: inherit;
    margin: 0;
  }

  /* Cards group spacing from header */
  .vt-impact-metrics__container > .group:not(:first-child),
  .vt-impact-metrics__container > .grid-group:not(:first-child),
  .vt-impact-metrics__container > .shopify-block:not(:first-child) > .group,
  .vt-impact-metrics__container > .shopify-block:not(:first-child) > .grid-group {
    margin-top: var(--cards-margin-top, 64px) !important;
  }

  /* Desktop swiper-wrapper transparent behavior */
  @media screen and (min-width: 769px) {
    .vt-impact-metrics .group > .swiper-wrapper,
    .vt-impact-metrics .grid-group > .swiper-wrapper {
      display: contents !important;
    }
    .vt-impact-metrics .vt-metrics-swiper-pagination {
      display: none !important;
    }
  }

  /* Mobile Swiper horizontal scroll */
  @media screen and (max-width: 768px) {
    .vt-impact-metrics {
      padding-top: calc(var(--padding-top, 80px) * 0.6);
      padding-bottom: calc(var(--padding-bottom, 80px) * 0.6);
      overflow-x: clip;
    }

    .vt-impact-metrics__container {
      padding-left: 20px;
      padding-right: 20px;
      overflow: visible;
    }

    .vt-impact-metrics__container > .group:not(:first-child),
    .vt-impact-metrics__container > .grid-group:not(:first-child),
    .vt-impact-metrics__container > .shopify-block:not(:first-child) > .group,
    .vt-impact-metrics__container > .shopify-block:not(:first-child) > .grid-group {
      margin-top: calc(var(--cards-margin-top, 64px) * 0.6) !important;
    }

    .vt-impact-metrics .swiper.vt-impact-metrics-swiper {
      overflow: visible !important;
      width: 100% !important;
      touch-action: pan-y;
      display: block !important;
    }

    .vt-impact-metrics .swiper-wrapper {
      display: flex !important;
      flex-direction: row !important;
      align-items: stretch !important;
      box-sizing: border-box !important;
    }

    .vt-impact-metrics .swiper-slide {
      flex: 0 0 82% !important;
      flex-shrink: 0 !important;
      flex-grow: 0 !important;
      height: auto !important;
      align-self: stretch !important;
      box-sizing: border-box !important;
      display: flex !important;
      flex-direction: column !important;
      width: 82% !important;
      max-width: 320px !important;
    }

    .vt-impact-metrics .swiper-slide > .vt-stat-card,
    .vt-impact-metrics .swiper-slide.vt-stat-card {
      width: 82% !important;
      max-width: 320px !important;
      flex: 0 0 82% !important;
      height: auto !important;
      align-self: stretch !important;
    }

    .vt-impact-metrics [data-mobile-columns="2"] .swiper-slide,
    .vt-impact-metrics [data-mobile-columns="2"] .swiper-slide.vt-stat-card {
      width: calc((100% - 12px) / 2) !important;
      max-width: none !important;
      flex: 0 0 calc((100% - 12px) / 2) !important;
    }

    /* Hide Swiper Pagination dots completely on mobile (as requested) */
    .vt-impact-metrics .vt-metrics-swiper-pagination {
      display: none !important;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function setupMetricsSwiper() {
      var sectionEl = document.getElementById('vtImpactMetrics-{{ section.id }}');
      if (!sectionEl) return;

      var firstCard = sectionEl.querySelector('.vt-stat-card');
      if (!firstCard) return;

      var cardsGroup = firstCard.closest('.grid-group, .group');
      if (!cardsGroup) return;

      var enableSwipeMobile = cardsGroup.getAttribute('data-enable-swipe-mobile') !== 'false';
      if (!enableSwipeMobile) return;

      function wrapSlidesIfNeeded() {
        var wrapper = cardsGroup.querySelector(':scope > .swiper-wrapper');
        if (!wrapper) {
          wrapper = document.createElement('div');
          wrapper.className = 'swiper-wrapper';

          var children = Array.from(cardsGroup.children);
          children.forEach(function(child) {
            child.classList.add('swiper-slide');
            wrapper.appendChild(child);
          });
          cardsGroup.appendChild(wrapper);
          cardsGroup.classList.add('swiper', 'vt-impact-metrics-swiper');
        }
      }

      function handleResizeOrInit() {
        var isMobile = window.innerWidth <= 768;

        if (isMobile) {
          wrapSlidesIfNeeded();

          if (typeof Swiper === 'undefined') {
            setTimeout(setupMetricsSwiper, 50);
            return;
          }

          if (cardsGroup.swiper) {
            cardsGroup.swiper.update();
            return;
          }

          var spaceBetween = 16;
          var groupGapMobile = cardsGroup.style.getPropertyValue('--grid-gap-h-m') || cardsGroup.style.getPropertyValue('--group-gap-h-m');
          if (groupGapMobile) {
            var parsed = parseInt(groupGapMobile, 10);
            if (!isNaN(parsed)) spaceBetween = parsed;
          }

          new Swiper(cardsGroup, {
            slidesPerView: 'auto',
            spaceBetween: spaceBetween,
            centeredSlides: false,
            grabCursor: true,
            watchSlidesProgress: true,
            speed: 400,
            touchEventsTarget: 'wrapper'
          });
        } else {
          if (cardsGroup.swiper) {
            cardsGroup.swiper.destroy(true, true);
            cardsGroup.swiper = null;
          }
        }
      }

      handleResizeOrInit();

      if (!cardsGroup._hasResizeListener) {
        cardsGroup._hasResizeListener = true;
        var resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(handleResizeOrInit, 150);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMetricsSwiper);
    } else {
      setupMetricsSwiper();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        setupMetricsSwiper();
      }
    });

    document.addEventListener('shopify:block:select', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        var sectionEl = document.getElementById('vtImpactMetrics-{{ section.id }}');
        if (sectionEl) {
          var swiperEl = sectionEl.querySelector('.swiper');
          if (swiperEl && swiperEl.swiper) {
            swiperEl.swiper.update();
          }
        }
      }
    });
  })();
</script>

