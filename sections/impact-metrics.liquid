<div
  class="vt-impact-metrics{% if section.settings.full_width %} full-width{% endif %}"
  id="vtImpactMetrics-{{ section.id }}"
  style="
    --bg-color: {{ section.settings.bg_color | default: 'var(--color-white, #F8F9DC)' }};
    --heading-color: {{ section.settings.heading_color | default: 'var(--color-black, #003225)' }};
    --subtitle-color: {{ section.settings.subtitle_color | default: 'var(--color-primary, #224E09)' }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-horizontal: {{ section.settings.padding_horizontal | default: 34 }}px;
    --block-gap: {{ section.settings.block_gap | default: section.settings.cards_margin_top | default: 64 }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 48 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    --padding-horizontal-mobile: {{ section.settings.padding_horizontal_mobile | default: 20 }}px;
    --block-gap-mobile: {{ section.settings.block_gap_mobile | default: section.settings.cards_margin_top_mobile | default: 40 }}px;
  "
>
  <div class="vt-impact-metrics__container">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-impact-metrics {
    width: 100%;
    background-color: var(--bg-color, #F8F9DC);
    color: var(--subtitle-color, #224E09);
    padding-top: var(--padding-top, 80px);
    padding-bottom: var(--padding-bottom, 80px);
    box-sizing: border-box;
    overflow-x: clip;
  }

  .vt-impact-metrics__container {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    padding-left: var(--padding-horizontal, 34px);
    padding-right: var(--padding-horizontal, 34px);
    gap: var(--block-gap, 64px);
  }

  .vt-impact-metrics:not(.full-width) .vt-impact-metrics__container {
    max-width: 1200px;
  }

  .vt-impact-metrics.full-width .vt-impact-metrics__container {
    max-width: 100%;
  }

  @media screen and (max-width: 768px) {
    .vt-impact-metrics {
      padding-top: var(--padding-top-mobile, 48px);
      padding-bottom: var(--padding-bottom-mobile, 48px);
    }

    .vt-impact-metrics__container {
      padding-left: var(--padding-horizontal-mobile, 20px);
      padding-right: var(--padding-horizontal-mobile, 20px);
      gap: var(--block-gap-mobile, 40px);
    }
  }

  /* Ensure shopify-block wrappers stretch full width */
  .vt-impact-metrics__container > .shopify-block,
  .vt-impact-metrics .group > .shopify-block {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Header heading default color and styles */
  .vt-impact-metrics .vt-heading-group {
    color: var(--heading-color, #003225);
  }

  .vt-impact-metrics .vt-heading-group .vt-heading {
    color: inherit;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Header subtitle styling - consistent with rich-text */
  .vt-impact-metrics__container > .group:first-child .vt-paragraph,
  .vt-impact-metrics__container > .shopify-block:first-child .vt-paragraph,
  .vt-impact-metrics__container > .group:first-child .vt-paragraph p,
  .vt-impact-metrics__container > .shopify-block:first-child .vt-paragraph p {
    color: var(--subtitle-color, #224E09);
    margin-top: 0;
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Impact Metrics",
  "tag": "section",
  "class": "impact-metrics-section",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#F8F9DC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#003225"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#224E09"
    },

    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Side padding (left & right)",
      "default": 34
    },
    {
      "type": "range",
      "id": "block_gap",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Gap",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Side padding (left & right)",
      "default": 20
    },
    {
      "type": "range",
      "id": "block_gap_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Gap",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Impact Metrics",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "layout_direction": "group--vertical",
            "alignment": "center"
          },
          "blocks": [
            {
              "type": "heading-group",
              "settings": {
                "direction": "horizontal",
                "alignment": "center",
                "vertical_alignment": "center",
                "gap_desktop": 16,
                "gap_mobile": 12,
                "width": "fit",
                "hide_icon_mobile": true
              },
              "blocks": [
                {
                  "type": "icons",
                  "settings": {
                    "icon": "leaf",
                    "icon_color": "#71CC3B",
                    "icon_size_desktop": 36,
                    "icon_size_mobile": 28
                  }
                },
                {
                  "type": "heading",
                  "settings": {
                    "heading": "Our Real Impact",
                    "heading_size": "vt-heading-h1",
                    "heading_alignment": "text-center",
                    "heading_tag": "h2",
                    "animation_type": "slide",
                    "animation_direction": "from-bottom",
                    "animation_duration": 1,
                    "animation_delay": 0.2,
                    "animation_easing": "ease-out-sine",
                    "animation_blur_intensity": 5
                  }
                },
                {
                  "type": "icons",
                  "settings": {
                    "icon": "leaf",
                    "icon_color": "#71CC3B",
                    "icon_size_desktop": 36,
                    "icon_size_mobile": 28
                  }
                }
              ]
            },
            {
              "type": "paragraph",
              "settings": {
                "text": "<p>Transparency is at the heart of everything we do. Track our environmental and social impact in real-time.</p>",
                "paragraph_size": "vt-paragraph-large",
                "paragraph_alignment": "text-center",
                "paragraph_max_width": 680,
                "animation_type": "slide",
                "animation_direction": "from-bottom",
                "animation_duration": 1,
                "animation_delay": 0.4,
                "animation_easing": "ease-out-sine",
                "animation_blur_intensity": 5
              }
            }
          ]
        },
        {
          "type": "grid-group",
          "settings": {
            "type": "grid",
            "desktop_columns": 4,
            "mobile_columns": "1",
            "enable_swipe_mobile": true,
            "show_navigation_desktop": false,
            "gap_desktop": 30,
            "gap_mobile": 26,
            "padding_vertical": 0,
            "padding_horizontal": 0,
            "padding_vertical_mobile": 0,
            "padding_horizontal_mobile": 0
          }
          
        }

      ]
    }
  ]
}
{% endschema %}
