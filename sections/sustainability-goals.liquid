<div
  class="vt-sustainability-goals{% if section.settings.full_width %} full-width{% endif %}"
  id="vtSustainabilityGoals-{{ section.id }}"
  style="
    --bg-color: {{ section.settings.bg_color | default: 'var(--color-white, #F8F9DC)' }};
    --heading-color: {{ section.settings.heading_color | default: 'var(--color-black, #003225)' }};
    --text-color: {{ section.settings.text_color | default: 'var(--color-primary, #224E09)' }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-horizontal: {{ section.settings.padding_horizontal | default: 34 }}px;
    --block-gap: {{ section.settings.block_gap | default: 48 }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 48 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    --padding-horizontal-mobile: {{ section.settings.padding_horizontal_mobile | default: 20 }}px;
    --block-gap-mobile: {{ section.settings.block_gap_mobile | default: 32 }}px;
  "
>
  <div class="vt-sustainability-goals__container">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-sustainability-goals {
    width: 100%;
    background-color: var(--bg-color, #F8F9DC);
    color: var(--text-color, #224E09);
    padding-top: var(--padding-top, 80px);
    padding-bottom: var(--padding-bottom, 80px);
    box-sizing: border-box;
    overflow-x: clip;
  }

  .vt-sustainability-goals__container {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    padding-left: var(--padding-horizontal, 34px);
    padding-right: var(--padding-horizontal, 34px);
    gap: var(--block-gap, 48px);
  }

  .vt-sustainability-goals:not(.full-width) .vt-sustainability-goals__container {
    max-width: 1200px;
  }

  .vt-sustainability-goals.full-width .vt-sustainability-goals__container {
    max-width: 100%;
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    .vt-sustainability-goals__container {
      padding-left: 28px;
      padding-right: 28px;
    }
  }

  @media screen and (max-width: 768px) {
    .vt-sustainability-goals {
      padding-top: var(--padding-top-mobile, 48px);
      padding-bottom: var(--padding-bottom-mobile, 48px);
    }

    .vt-sustainability-goals__container {
      padding-left: var(--padding-horizontal-mobile, 20px);
      padding-right: var(--padding-horizontal-mobile, 20px);
      gap: var(--block-gap-mobile, 32px);
    }
  }

  /* Ensure child block containers stretch full width */
  .vt-sustainability-goals__container > .shopify-block,
  .vt-sustainability-goals__container > .vt-grid-group,
  .vt-sustainability-goals .group > .shopify-block {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Heading & sub-heading styles at section level */
  .vt-sustainability-goals .vt-heading,
  .vt-sustainability-goals .vt-heading-group,
  .vt-sustainability-goals .vt-subheading {
    color: var(--heading-color, #003225);
  }

  .vt-sustainability-goals .vt-heading-group .vt-heading {
    color: inherit;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Paragraph style at section level */
  .vt-sustainability-goals .vt-paragraph {
    color: var(--text-color, #224E09);
  }

  /* Preserve stat-card's own scoped colors: Heading uses Heading setting, all card texts (subheading & paragraph) share Paragraph setting */
  .vt-sustainability-goals .vt-card .vt-heading {
    color: var(--vt-heading-color);
  }

  .vt-sustainability-goals .vt-card .vt-subheading,
  .vt-sustainability-goals .vt-card .vt-sub-heading,
  .vt-sustainability-goals .vt-card .vt-paragraph,
  .vt-sustainability-goals .vt-card .vt-paragraph * {
    color: var(--vt-text-color);
  }
{% endstylesheet %}

