<!-- Sustainability Goals Section -->
<div
  class="vt-sustainability-goals{% if section.settings.full_width %} full-width{% endif %}"
  id="vtSustainabilityGoals-{{ section.id }}"
  style="
    --bg-color: {{ section.settings.bg_color | default: '#F8F9DC' }};
    --heading-color: {{ section.settings.heading_color | default: '#003225' }};
    --subtitle-color: {{ section.settings.subtitle_color | default: '#224E09' }};
    --padding-top: {{ section.settings.padding_top | default: 0 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  "
>
  <div class="vt-sustainability-goals__container">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-sustainability-goals {
    width: 100%;
    background-color: var(--bg-color, #F8F9DC);
    color: var(--subtitle-color, #224E09);
    padding-top: var(--padding-top, 0px);
    padding-bottom: var(--padding-bottom, 80px);
    box-sizing: border-box;
  }

  .vt-sustainability-goals__container {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    padding-left: 34px;
    padding-right: 34px;
  }

  .vt-sustainability-goals:not(.full-width) .vt-sustainability-goals__container {
    max-width: 1200px;
  }

  .vt-sustainability-goals.full-width .vt-sustainability-goals__container {
    max-width: 100%;
  }

  @media screen and (max-width: 768px) {
    .vt-sustainability-goals__container {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  .vt-sustainability-goals__container > .shopify-block {
    width: 100% !important;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vt-sustainability-goals .grid-group {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
