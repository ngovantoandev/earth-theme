{%- liquid
  if section.settings.enable_custom_mobile_padding
    assign px_padding_top_mobile = section.settings.padding_top_mobile | default: 0
    assign px_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0
  else
    assign px_padding_top_mobile = section.settings.padding_top | times: 0.75
    assign px_padding_bottom_mobile = section.settings.padding_bottom | times: 0.75
  endif

  assign px_padding_top_desktop = section.settings.padding_top | default: 0
  assign px_padding_bottom_desktop = section.settings.padding_bottom | default: 0
-%}

<div
  id="RichTtextSection-{{ section.id }}"
  class="
    vt-rich-text
    {{ section.settings.desktop_content_alignment }}
    {{ section.settings.mobile_content_alignment }}
    {{ section.settings.heading_width }}
    {%- if section.settings.show_section_divider %} vt-divider{% endif -%}
    {%- if section.settings.make_section_full_width == true %} full-width{% endif -%}
  "
  style="
    --vt-bg: {{ section.settings.background_color }};
    --vt-color: {{ section.settings.text_color }};
    --vt-subtitle-color: {{ section.settings.subtitle_color | default: '#224E09' }};
    --vt-divider-color: {{ section.settings.divider_color | default: section.settings.background_color }};
    --vt-gap: {% render 'fluid-clamp', min_px: section.settings.gap_mobile, max_px: section.settings.gap %};
    --vt-padding-top: {% render 'fluid-clamp', min_px: px_padding_top_mobile, max_px: px_padding_top_desktop %};
    --vt-padding-bottom: {% render 'fluid-clamp', min_px: px_padding_bottom_mobile, max_px: px_padding_bottom_desktop %};
  "
>
  <div class="vt-inner">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-rich-text {
    background-color: var(--vt-bg);
    color: var(--vt-color);
    padding-top: var(--vt-padding-top);    
    padding-bottom: var(--vt-padding-bottom);    
  }

  .vt-rich-text .vt-inner {
    gap: var(--vt-gap);    
  }

  .vt-rich-text .vt-paragraph {
    color: var(--vt-subtitle-color, #224E09);
  }

  .vt-rich-text .vt-paragraph p {
    margin: 0;
  }

  .vt-rich-text.vt-divider {
    border-bottom: 1px solid var(--vt-divider-color);
  }

  .vt-rich-text:not(.vt-divider) {
    border-bottom: none;
  }
{% endstylesheet %}


{% schema %}
{
  "name": "t:sections.rich_text.name",  
  "tag": "section",  
  "class": "rich-text-section",  
  "settings": [
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "vt-desktop-left", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "vt-desktop-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "vt-desktop-right", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "vt-desktop-center",
      "label": "t:sections.rich_text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "vt-mobile-left", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "vt-mobile-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "vt-mobile-right", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "vt-mobile-center",
      "label": "t:sections.rich_text.settings.mobile_content_alignment.label"
    },
    {
      "type": "select",
      "id": "heading_width",
      "options": [
        { "value": "vt-width-small", "label": "t:sections.rich_text.settings.heading_width.options__1.label" },
        { "value": "vt-width-medium", "label": "t:sections.rich_text.settings.heading_width.options__2.label" },
        { "value": "vt-width-large", "label": "t:sections.rich_text.settings.heading_width.options__3.label" },
        { "value": "vt-width-full", "label": "t:sections.rich_text.settings.heading_width.options__4.label" }
      ],
      "default": "vt-width-medium",
      "label": "t:sections.rich_text.settings.heading_width.label"
    },
     {
      "type": "header",
      "content": "t:sections.rich_text.settings.gap_space.content"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36,
      "label": "t:sections.rich_text.settings.gap.label",
      "info": "t:sections.rich_text.settings.gap.info"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.gap_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header_colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#F8F9DC",
      "label": "t:sections.rich_text.settings.background_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#003225",
      "label": "t:sections.rich_text.settings.text_color.label"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "default": "#224E09",
      "label": "Subtitle color"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header_section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.rich_text.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.rich_text.settings.padding_bottom.label"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_padding",
      "default": true,
      "label": "t:sections.rich_text.settings.enable_custom_mobile_padding.label"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.padding_top_mobile.label",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.padding_bottom_mobile.label",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": true,
      "label": "t:sections.rich_text.settings.show_section_divider.label"
    },
    {
      "type": "color",
      "id": "divider_color",
      "default": "#003225",
      "label": "t:sections.rich_text.settings.divider_color.label",
      "visible_if": "{{ section.settings.show_section_divider }}"
    },
    {
      "type": "checkbox",
      "id": "make_section_full_width",
      "default": true,
      "label": "t:sections.rich_text.settings.make_section_full_width.label"
    }
  ], 
  "blocks": [{ "type": "heading" }, { "type": "paragraph" }, { "type": "button" }],
  "presets": [
    {
      "name": "t:sections.rich_text.name", 
      "blocks": [
        {
          "type": "heading",          
        },
        {
          "type": "paragraph"          
        },
        {          
          "type": "button"         
        }
      ]
    }
  ]  
}
{% endschema %}
