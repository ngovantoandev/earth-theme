{%- assign vw_mobile = 375 -%}
{%- assign vw_desktop = 1440 -%}
{%- assign vw_range = vw_desktop | minus: vw_mobile -%}

{%- if section.settings.enable_custom_mobile_padding -%}
  {%- assign px_padding_top_mobile = section.settings.padding_top_mobile | times: 1.0 -%}
  {%- assign px_padding_bottom_mobile = section.settings.padding_bottom_mobile | times: 1.0 -%}
{%- else -%}
  {%- assign px_padding_top_mobile = section.settings.padding_top | times: 0.75 -%}
  {%- assign px_padding_bottom_mobile = section.settings.padding_bottom | times: 0.75 -%}
{%- endif -%}

{%- assign px_padding_top_desktop = section.settings.padding_top | times: 1.0 -%}
{%- assign px_padding_bottom_desktop = section.settings.padding_bottom | times: 1.0 -%}

{%- comment -%} ===== TOP ===== {%- endcomment -%}
{%- assign diff_top_px = px_padding_top_desktop | minus: px_padding_top_mobile -%}
{%- assign slope_top = diff_top_px | divided_by: vw_range | round: 8 -%}
{%- assign offset_top_px = vw_mobile | times: slope_top -%}
{%- assign y_intersect_top_px = px_padding_top_mobile | minus: offset_top_px -%}
{%- assign y_intersect_top_rem = y_intersect_top_px | divided_by: 16.0 | round: 4 -%}
{%- assign vw_coefficient_top = slope_top | times: 100 | round: 4 -%}

{%- comment -%} ===== BOTTOM ===== {%- endcomment -%}
{%- assign diff_bottom_px = px_padding_bottom_desktop | minus: px_padding_bottom_mobile -%}
{%- assign slope_bottom = diff_bottom_px | divided_by: vw_range | round: 8 -%}
{%- assign offset_bottom_px = vw_mobile | times: slope_bottom -%}
{%- assign y_intersect_bottom_px = px_padding_bottom_mobile | minus: offset_bottom_px -%}
{%- assign y_intersect_bottom_rem = y_intersect_bottom_px | divided_by: 16.0 | round: 4 -%}
{%- assign vw_coefficient_bottom = slope_bottom | times: 100 | round: 4 -%}

{%- comment -%} REM clamp() {%- endcomment -%}
{%- assign rem_padding_top_mobile = px_padding_top_mobile | divided_by: 16.0 | round: 4 -%}
{%- assign rem_padding_top_desktop = px_padding_top_desktop | divided_by: 16.0 | round: 4 -%}
{%- assign rem_padding_bottom_mobile = px_padding_bottom_mobile | divided_by: 16.0 | round: 4 -%}
{%- assign rem_padding_bottom_desktop = px_padding_bottom_desktop | divided_by: 16.0 | round: 4 -%}

{%- comment -%} ===== GAP ===== {%- endcomment -%}
{%- assign px_gap_mobile = section.settings.gap_mobile | times: 1.0 -%}
{%- assign px_gap_desktop = section.settings.gap | times: 1.0 -%}

{%- assign diff_gap_px = px_gap_desktop | minus: px_gap_mobile -%}
{%- assign slope_gap = diff_gap_px | divided_by: vw_range | round: 8 -%}
{%- assign offset_gap_px = vw_mobile | times: slope_gap -%}
{%- assign y_intersect_gap_px = px_gap_mobile | minus: offset_gap_px -%}
{%- assign y_intersect_gap_rem = y_intersect_gap_px | divided_by: 16.0 | round: 4 -%}
{%- assign vw_coefficient_gap = slope_gap | times: 100 | round: 4 -%}

{%- assign rem_gap_mobile = px_gap_mobile | divided_by: 16.0 | round: 4 -%}
{%- assign rem_gap_desktop = px_gap_desktop | divided_by: 16.0 | round: 4 -%}

<div
  id="RichTtextSection-{{ section.id }}"
  class="
    vt-rich-text
    {{ section.settings.desktop_content_alignment }}
    {{ section.settings.mobile_content_alignment }}    
    {%- if section.settings.show_section_divider %} vt-divider{% endif -%}
    {%- if section.settings.make_section_full_width %} full-width{% endif -%}
  "
  style="
    --vt-bg: {{ section.settings.background_color }};
    --vt-color: {{ section.settings.text_color }};
    --vt-paragraph-color: {{ section.settings.paragraph_color }};
    --vt-divider-color: {{ section.settings.divider_color | default: section.settings.background_color }};
    --vt-gap: {% if section.settings.gap != blank %}{{ section.settings.gap }}{% else %}36{% endif %}px;
    --vt-gap-mobile: {% if section.settings.gap_mobile != blank %}{{ section.settings.gap_mobile }}{% else %}{{ section.settings.gap | default: 32 }}{% endif %}px;
    --vt-padding-top: clamp({{ rem_padding_top_mobile }}rem, calc({{ y_intersect_top_rem }}rem + {{ vw_coefficient_top }}vw), {{ rem_padding_top_desktop }}rem );
    --vt-padding-bottom: clamp({{ rem_padding_bottom_mobile }}rem, calc({{ y_intersect_bottom_rem }}rem + {{ vw_coefficient_bottom }}vw), {{ rem_padding_bottom_desktop }}rem );
  "
>
  <div class="vt-inner">   
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-rich-text {
    background-color: var(--vt-bg);
    color: var(--vt-color);
    padding-top: var(--vt-padding-top);    
    padding-bottom: var(--vt-padding-bottom);    
  }

  .vt-rich-text .vt-inner {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    gap: var(--vt-gap, 0px);    
  }  

  @media screen and (max-width: 768px) {
    .vt-rich-text .vt-inner {
      gap: var(--vt-gap-mobile, var(--vt-gap, 0px));
    }
  }

  .vt-rich-text .vt-inner > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  .vt-rich-text .vt-inner .vt-paragraph p {
    margin-top: 0;
    margin-bottom: 0;
  }

  .vt-rich-text:not(.full-width) .vt-inner {
    max-width: 1200px;
  }

  .vt-rich-text.full-width .vt-inner {
    max-width: 100%;
  }  

  .vt-rich-text.vt-divider {
    border-bottom: 1px solid var(--vt-divider-color);
  }

  .vt-rich-text:not(.vt-divider) {
    border-bottom: none;
  }

  .vt-rich-text .vt-paragraph{
    color: var(--vt-paragraph-color);
  }  
{% endstylesheet %}


{% schema %}
{
  "name": "t:sections.rich_text.name",  
  "tag": "section",  
  "class": "rich-text-section",  
  "settings": [
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "vt-desktop-left", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "vt-desktop-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "vt-desktop-right", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "vt-desktop-center",
      "label": "t:sections.rich_text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "vt-mobile-left", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "vt-mobile-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "vt-mobile-right", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "vt-mobile-center",
      "label": "t:sections.rich_text.settings.mobile_content_alignment.label"
    },    
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36,
      "label": "t:sections.rich_text.settings.gap.label"      
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.gap_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header_colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#F8F9DC",
      "label": "t:sections.rich_text.settings.background_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#003225",
      "label": "t:sections.rich_text.settings.text_color.label"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "default": "#224E09",
      "label": "Paragraph"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header_section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.rich_text.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.rich_text.settings.padding_bottom.label"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_padding",
      "default": true,
      "label": "t:sections.rich_text.settings.enable_custom_mobile_padding.label"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.padding_top_mobile.label",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.padding_bottom_mobile.label",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": true,
      "label": "t:sections.rich_text.settings.show_section_divider.label"
    },
    {
      "type": "color",
      "id": "divider_color",
      "default": "#003225",
      "label": "t:sections.rich_text.settings.divider_color.label",
      "visible_if": "{{ section.settings.show_section_divider }}"
    },
    {
      "type": "checkbox",
      "id": "make_section_full_width",
      "default": true,
      "label": "t:sections.rich_text.settings.make_section_full_width.label"
    }
  ], 
  "blocks": [
    { "type": "heading" }, 
    { "type": "paragraph" }, 
    { "type": "button" }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name", 
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Heading",
            "heading_size": "vt-hero-heading",
            "heading_alignment": "text-inherit",
            "heading_tag": "h1",
            "heading_width": "fill",
            "width_custom": 100,
            "enable_max_width": true,
            "heading_max_width": 1100,
            "animation_type": "slide",
            "animation_direction": "from-bottom",
            "animation_duration": 1,
            "animation_delay": 0.2,
            "animation_easing": "ease-out-sine",
            "animation_blur_intensity": 5
          }      
        },
        {
          "type": "paragraph"          
        },
        {          
          "type": "button"         
        }
      ]
    }
  ]  
}
{% endschema %}
