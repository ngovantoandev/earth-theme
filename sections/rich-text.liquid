{% comment %}
  Rich text section with responsive gap, padding, colors, alignment and optional divider.
  Renders nested theme blocks (heading, paragraph, button).
{% endcomment %}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width

  if section.settings.enable_custom_mobile_padding
    assign pad_top_mobile = section.settings.padding_top_mobile
    assign pad_bottom_mobile = section.settings.padding_bottom_mobile
    assign pad_left_mobile = section.settings.padding_left_mobile
    assign pad_right_mobile = section.settings.padding_right_mobile
  else
    assign pad_top_mobile = section.settings.padding_top | times: 0.75 | round
    assign pad_bottom_mobile = section.settings.padding_bottom | times: 0.75 | round
    assign pad_left_mobile = section.settings.padding_left | times: 0.75 | round
    assign pad_right_mobile = section.settings.padding_right | times: 0.75 | round
  endif
-%}

<div role="region" aria-labelledby="sec-title"
  id="rich-text-{{ section.id }}"
  class="vt-rich-text{% unless make_section_page_width %} vt-page-full-width{% endunless %}
    {{ section.settings.desktop_content_alignment }}
    {{ section.settings.mobile_content_alignment }}
    {% if section.settings.show_section_divider %}vt-rich-text--divider{% endif %}
  "
  style="
    --vt-bg: {{ section.settings.background_color }};
    --vt-color: {{ section.settings.text_color }};
    --vt-paragraph-color: {{ section.settings.paragraph_color }};
    --vt-divider-color: {{ section.settings.divider_color }};
    --vt-gap: {% render 'fluid-clamp', min_px: section.settings.gap_mobile, max_px: section.settings.gap %};
    --vt-padding-block-start: {% render 'fluid-clamp', min_px: pad_top_mobile, max_px: section.settings.padding_top %};
    --vt-padding-block-end: {% render 'fluid-clamp', min_px: pad_bottom_mobile, max_px: section.settings.padding_bottom %};
    --vt-padding-inline-start: {% render 'fluid-clamp', min_px: pad_left_mobile, max_px: section.settings.padding_left %};
    --vt-padding-inline-end: {% render 'fluid-clamp', min_px: pad_right_mobile, max_px: section.settings.padding_right %};
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-rich-text__inner{% if make_section_page_width %} vt-page-width{% endif %}">    
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-rich-text {
    color: var(--vt-color, var(--vt-foreground-color));
    background-color: var(--vt-bg, var(--vt-background-color));    
    padding-block-start: var(--vt-padding-block-start);
    padding-block-end: var(--vt-padding-block-end);    
  }

  .vt-rich-text.vt-page-full-width {
    padding-inline-start: var(--vt-padding-inline-start);
    padding-inline-end: var(--vt-padding-inline-end);
  }

  .vt-rich-text__inner {
    display: flex;
    flex-direction: column;
    gap: var(--vt-gap);
    width: 100%;
  }

  /* Divider */
  .vt-rich-text--divider {
    border-bottom: 1px solid var(--vt-divider-color, var(--vt-foreground-color));
  }

  /* Paragraph color override */
  .vt-rich-text .vt-paragraph {
    color: var(--vt-paragraph-color, inherit);
  }

  /* Mobile alignment (default) */
  .vt-rich-text.vt-mobile-left .vt-rich-text__inner {
    align-items: flex-start;
    text-align: left;
  }

  .vt-rich-text.vt-mobile-center .vt-rich-text__inner {
    align-items: center;
    text-align: center;
  }

  .vt-rich-text.vt-mobile-right .vt-rich-text__inner {
    align-items: flex-end;
    text-align: right;
  }

  /* Desktop alignment */
  @media screen and (min-width: 750px) {
    .vt-rich-text.vt-desktop-left .vt-rich-text__inner {
      align-items: flex-start;
      text-align: left;
    }

    .vt-rich-text.vt-desktop-center .vt-rich-text__inner {
      align-items: center;
      text-align: center;
    }

    .vt-rich-text.vt-desktop-right .vt-rich-text__inner {
      align-items: flex-end;
      text-align: right;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "section",
  "class": "rich-text-section",
  "settings": [
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "vt-desktop-left", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "vt-desktop-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "vt-desktop-right", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "vt-desktop-center",
      "label": "t:sections.rich_text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "vt-mobile-left", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "vt-mobile-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "vt-mobile-right", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "vt-mobile-center",
      "label": "t:sections.rich_text.settings.mobile_content_alignment.label"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36,
      "label": "t:sections.rich_text.settings.gap.label"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.gap_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header_colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#00000000",
      "label": "t:sections.rich_text.settings.background_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#003225",
      "label": "t:sections.rich_text.settings.text_color.label"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "default": "#224E09",
      "label": "Paragraph"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header_section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 110,
      "label": "Top (desktop)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 110,
      "label": "Bottom (desktop)"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Left (desktop)"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Right (desktop)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_padding",
      "default": true,
      "label": "t:sections.rich_text.settings.enable_custom_mobile_padding.label"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.padding_top_mobile.label",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "label": "t:sections.rich_text.settings.padding_bottom_mobile.label",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Left (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Right (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": true,
      "label": "t:sections.rich_text.settings.show_section_divider.label"
    },
    {
      "type": "color",
      "id": "divider_color",
      "default": "#003225",
      "label": "t:sections.rich_text.settings.divider_color.label",
      "visible_if": "{{ section.settings.show_section_divider }}"
    },
    {
      "type": "checkbox",
      "id": "make_section_page_width",
      "default": true,
      "label": "t:sections.rich_text.settings.make_section_page_width.label"
    }
  ],
  "blocks": [
    { "type": "heading" },
    { "type": "paragraph" },
    { "type": "button" },
    { "type": "stack" }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name",
      "settings": {
        "desktop_content_alignment": "vt-desktop-center",
        "mobile_content_alignment": "vt-mobile-center",
        "gap": 36,
        "gap_mobile": 32,
        "background_color": "#00000000",
        "text_color": "#003225",
        "paragraph_color": "#224E09",
        "padding_top": 110,
        "padding_bottom": 110,
        "padding_left": 34,
        "padding_right": 34,
        "enable_custom_mobile_padding": true,
        "padding_top_mobile": 32,
        "padding_bottom_mobile": 32,
        "padding_left_mobile": 20,
        "padding_right_mobile": 20,        
        "show_section_divider": false,
        "divider_color": "#003225",
        "make_section_page_width": true
      },
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Heading",
            "heading_size": "vt-hero-heading",
            "heading_alignment": "text-inherit",
            "heading_tag": "h1",
            "heading_width": "fit",
            "width_custom": 100,
            "enable_max_width": true,
            "heading_max_width": 1100,
            "animation_type": "slide",
            "animation_direction": "from-bottom",
            "animation_duration": 1,
            "animation_delay": 0.2,
            "animation_easing": "ease-out-sine",
            "animation_blur_intensity": 5
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
            "paragraph_alignment": "text-inherit",
            "paragraph_size": "vt-paragraph-medium",
            "paragraph_width": "fit",
            "width_custom": 50,
            "enable_max_width": true,
            "paragraph_max_width": 720,
            "animation_type": "slide",
            "animation_direction": "from-bottom",
            "animation_duration": 1.2,
            "animation_delay": 0.2,
            "animation_easing": "ease-out-sine",
            "animation_blur_intensity": 5
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Button label",
            "button_link": "shopify://collections/all",
            "open_in_new_tab": false,
            "button_style": "primary",
            "animation_type": "slide",
            "animation_direction": "from-bottom",
            "animation_duration": 1.2,
            "animation_delay": 0.2,
            "animation_easing": "ease-out-sine",
            "animation_blur_intensity": 5
          }   
        }
      ]
    }
  ]
}
{% endschema %}
