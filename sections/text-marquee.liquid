{%- liquid
  assign speed_level = section.settings.speed | default: 3 | plus: 0
  case speed_level
    when 5
      assign speed_duration = 12
    when 4
      assign speed_duration = 18
    when 3
      assign speed_duration = 24
    when 2
      assign speed_duration = 34
    when 1
      assign speed_duration = 48
    else
      if speed_level > 5
        assign speed_duration = speed_level
      else
        assign speed_duration = 24
      endif
  endcase

  assign gap_desktop = section.settings.gap_desktop | default: 32
  assign pt = section.settings.padding_top | default: 0
  assign pb = section.settings.padding_bottom | default: 96
  assign ph = section.settings.padding_horizontal | default: 0

  assign gap_mobile = section.settings.gap_mobile | default: 24
  assign pt_mob = section.settings.padding_top_mobile | default: 0
  assign pb_mob = section.settings.padding_bottom_mobile | default: 64
  assign ph_mob = section.settings.padding_horizontal_mobile | default: 0
-%}

{%- capture marquee_blocks -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- liquid
  if marquee_blocks == blank or section.blocks.size == 0
    capture marquee_blocks
      echo '<div class="vt-heading-wrapper text-center"><h3 class="vt-heading vt-heading-h5">SUSTAINABLE FABRICS</h3></div>'
      echo '<div class="vt-icon vt-icon--flower" style="--vt-icon-color: #71CC3B; --vt-icon-size: 28px;"><span class="vt-icon__inner">'
      render 'icons', icon: 'flower'
      echo '</span></div>'
      echo '<div class="vt-heading-wrapper text-center"><h3 class="vt-heading vt-heading-h5">FEEL GOOD CLOTHES</h3></div>'
      echo '<div class="vt-icon vt-icon--flower" style="--vt-icon-color: #71CC3B; --vt-icon-size: 28px;"><span class="vt-icon__inner">'
      render 'icons', icon: 'flower'
      echo '</span></div>'
    endcapture
  endif
-%}

<section
  class="earth-marquee earth-marquee-{{ section.id }}{% if section.settings.full_width %} full-width{% endif %}"
  id="earthMarquee-{{ section.id }}"
  style="
    --marquee-duration: {{ speed_duration }}s;
    --marquee-direction: {% if section.settings.direction == 'right' %}reverse{% else %}normal{% endif %};
    --marquee-bg: {{ section.settings.bg_color | default: 'var(--color-white, #F8F9DC)' }};
    --marquee-color: {{ section.settings.text_color | default: 'var(--color-black, #003225)' }};
    --marquee-gap: {{ gap_desktop }}px;
    --marquee-gap-mobile: {{ gap_mobile }}px;
    --marquee-padding-top: {{ pt }}px;
    --marquee-padding-bottom: {{ pb }}px;
    --marquee-padding-horizontal: {{ ph }}px;
    --marquee-padding-top-mobile: {{ pt_mob }}px;
    --marquee-padding-bottom-mobile: {{ pb_mob }}px;
    --marquee-padding-horizontal-mobile: {{ ph_mob }}px;
  "
>
  <div class="earth-marquee__container">
    <div class="earth-marquee__track">
      {%- for i in (1..6) -%}
        <div class="earth-marquee__group" {% if i > 1 %}aria-hidden="true"{% endif %}>
          {{ marquee_blocks }}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .earth-marquee {
    grid-column: 1 / -1 !important;
    overflow: hidden;
    width: 100%;
    user-select: none;
    background-color: var(--marquee-bg, #F8F9DC);
    color: var(--marquee-color, #003225);
    padding-top: var(--marquee-padding-top, 0px);
    padding-bottom: var(--marquee-padding-bottom, 96px);
    padding-left: var(--marquee-padding-horizontal, 0px);
    padding-right: var(--marquee-padding-horizontal, 0px);
    margin: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  .earth-marquee__container {
    width: 100%;
    box-sizing: border-box;
    margin: 0 auto;
    overflow: hidden;
  }

  .earth-marquee:not(.full-width) .earth-marquee__container {
    max-width: 1200px;
  }

  .earth-marquee.full-width .earth-marquee__container {
    max-width: 100%;
  }

  .earth-marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: earthMarqueeScroll var(--marquee-duration, 24s) linear infinite;
    animation-direction: var(--marquee-direction, normal);
  }

  .earth-marquee__track:hover,
  .earth-marquee:hover .earth-marquee__track {
    animation-play-state: paused;
    cursor: default;
  }

  .earth-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--marquee-gap, 32px);
    padding-right: var(--marquee-gap, 32px);
  }

  /* Child block wrappers align horizontally in single line */
  .earth-marquee__group > * {
    flex-shrink: 0 !important;
    width: auto !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
  }

  /* Block 1: heading.liquid */
  .earth-marquee .vt-heading-wrapper {
    width: auto !important;
    max-width: none !important;
    display: inline-flex !important;
    align-items: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .earth-marquee .vt-heading {
    color: var(--marquee-color, #003225) !important;
    white-space: nowrap !important;
    margin: 0 !important;
    line-height: 1 !important;
    font-family: inherit;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-size: 22px;
  }

  /* Block 2: icons.liquid */
  .earth-marquee .vt-icon {
    flex-shrink: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    color: var(--vt-icon-color, #71CC3B) !important;
  }

  .earth-marquee .vt-icon svg {
    display: block !important;
    width: var(--vt-icon-size, 28px) !important;
    height: var(--vt-icon-size, 26px) !important;
    min-width: 20px !important;
    min-height: 20px !important;
    object-fit: contain !important;
    fill: currentColor !important;
  }

  .earth-marquee .vt-icon svg path {
    fill: currentColor !important;
  }

  /* Block 3: image.liquid */
  .earth-marquee .vt-image {
    flex-shrink: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    width: auto !important;
    height: auto !important;
  }

  .earth-marquee .vt-image img {
    width: auto !important;
    height: auto !important;
    max-height: 36px !important;
    object-fit: contain !important;
    display: inline-block !important;
  }

  /* Disable entrance transitions inside continuous marquee track */
  .earth-marquee .vt-animate {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
    transition: none !important;
    animation: none !important;
  }

  @keyframes earthMarqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .earth-marquee {
      padding-top: var(--marquee-padding-top-mobile, 0px);
      padding-bottom: var(--marquee-padding-bottom-mobile, 64px);
      padding-left: var(--marquee-padding-horizontal-mobile, 0px);
      padding-right: var(--marquee-padding-horizontal-mobile, 0px);
    }

    .earth-marquee__group {
      gap: var(--marquee-gap-mobile, 24px);
      padding-right: var(--marquee-gap-mobile, 24px);
    }

    .earth-marquee .vt-heading {
      font-size: 18px !important;
    }

    .earth-marquee .vt-image img {
      max-height: 24px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text marquee",
  "class": "earth-marquee-section",
  "blocks": [
    { "type": "heading" },
    { "type": "icons" },
    { "type": "image" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F9DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#003225"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Speed",
      "default": 3
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Side padding (left & right)",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Gap between items",
      "default": 32
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Side padding (left & right)",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between items",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Text marquee",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "SUSTAINABLE FABRICS",
            "heading_size": "vt-heading-h5",
            "heading_alignment": "text-center",
            "heading_tag": "h3"
          }
        },
        {
          "type": "icons",
          "settings": {
            "icon": "flower",
            "icon_color": "#71CC3B",
            "icon_size_desktop": 28,
            "icon_size_mobile": 22
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "FEEL GOOD CLOTHES",
            "heading_size": "vt-heading-h5",
            "heading_alignment": "text-center",
            "heading_tag": "h3"
          }
        },
        {
          "type": "icons",
          "settings": {
            "icon": "flower",
            "icon_color": "#71CC3B",
            "icon_size_desktop": 28,
            "icon_size_mobile": 22
          }
        }
      ]
    }
  ]
}
{% endschema %}