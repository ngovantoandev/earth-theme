{% comment %}  
  This is a section for showcasing key sustainability achievements and impact metrics, such as organic materials, fair wages, recycled materials, and carbon neutrality.
{% endcomment %}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width

  if section.settings.enable_custom_mobile_padding
    assign pad_top_mobile = section.settings.padding_top_mobile
    assign pad_bottom_mobile = section.settings.padding_bottom_mobile
    assign pad_left_mobile = section.settings.padding_left_mobile
    assign pad_right_mobile = section.settings.padding_right_mobile
  else
    assign pad_top_mobile = section.settings.padding_top | times: 0.75 | round
    assign pad_bottom_mobile = section.settings.padding_bottom | times: 0.75 | round
    assign pad_left_mobile = section.settings.padding_left | times: 0.75 | round
    assign pad_right_mobile = section.settings.padding_right | times: 0.75 | round
  endif
-%}

<div 
  class="
    vt-impact-stats{% unless make_section_page_width %} vt-page-full-width{% endunless %}
  "
  style="
    --vt-bg: {{ section.settings.background_color }};
    --vt-color: {{ section.settings.text_color }};
    --vt-paragraph-color: {{ section.settings.paragraph_color }};    
    --vt-gap: {% render 'fluid-clamp', min_px: section.settings.gap_mobile, max_px: section.settings.gap %};
    --vt-padding-block-start: {% render 'fluid-clamp', min_px: pad_top_mobile, max_px: section.settings.padding_top %};
    --vt-padding-block-end: {% render 'fluid-clamp', min_px: pad_bottom_mobile, max_px: section.settings.padding_bottom %};
    --vt-padding-inline-start: {% render 'fluid-clamp', min_px: pad_left_mobile, max_px: section.settings.padding_left %};
    --vt-padding-inline-end: {% render 'fluid-clamp', min_px: pad_right_mobile, max_px: section.settings.padding_right %};
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-impact-stats__inner{% if make_section_page_width %} vt-page-width{% endif %}">    
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-impact-stats {
    color: var(--vt-color, var(--vt-foreground-color));
    background-color: var(--vt-bg, var(--vt-background-color));
    padding-block-start: var(--vt-padding-block-start);
    padding-block-end: var(--vt-padding-block-end);    
  }

  .vt-impact-stats.vt-page-full-width {
    padding-inline-start: var(--vt-padding-inline-start);
    padding-inline-end: var(--vt-padding-inline-end);
  }

  .vt-impact-stats__inner {
    display: flex;
    flex-direction: column;
    gap: var(--vt-gap);
    width: 100%;
  }

  /* Paragraph color override */
  .vt-impact-stats .vt-paragraph {
    color: var(--vt-paragraph-color, inherit);
  }

{% endstylesheet %}

