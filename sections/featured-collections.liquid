{%- comment -%}
  Section: Featured Collections
  Container wrapper for collection-list and theme blocks.
  Supports full width, theme color tokens, and responsive section padding.
{%- endcomment -%}

<div
  class="vt-featured-collections{% if section.settings.full_width %} vt-featured-collections--full-width{% endif %}"
  id="vtFeaturedCollections-{{ section.id }}"
  style="
    --vt-bg: {{ section.settings.bg_color | default: '#EBF7BE' }};
    --vt-heading-color: {{ section.settings.heading_color | default: '#003225' }};
    --vt-paragraph-color: {{ section.settings.paragraph_color | default: '#224E09' }};
    --vt-pt: {{ section.settings.padding_top | default: 80 }}px;
    --vt-pb: {{ section.settings.padding_bottom | default: 96 }}px;
    --vt-ph: {{ section.settings.padding_horizontal | default: 34 }}px;
    --vt-pt-mobile: {{ section.settings.padding_top_mobile | default: 48 }}px;
    --vt-pb-mobile: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    --vt-ph-mobile: {{ section.settings.padding_horizontal_mobile | default: 20 }}px;
    --vt-block-gap: {{ section.settings.block_gap | default: 64 }}px;
    --vt-block-gap-mobile: {{ section.settings.block_gap_mobile | default: 40 }}px;
  "
>
  <div class="vt-featured-collections__container">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-featured-collections {
    width: 100%;
    background-color: var(--vt-bg, #EBF7BE);
    padding-top: var(--vt-pt, 80px);
    padding-bottom: var(--vt-pb, 96px);
    box-sizing: border-box;
  }

  .vt-featured-collections__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    padding-left: var(--vt-ph, 34px);
    padding-right: var(--vt-ph, 34px);
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    gap: var(--vt-block-gap, 64px);
  }

  .vt-featured-collections--full-width .vt-featured-collections__container {
    max-width: 100% !important;
  }

  /* Ensure child block containers stretch full width */
  .vt-featured-collections__container > .shopify-block,
  .vt-featured-collections__container > shopify-block,
  .vt-featured-collections__container > vt-column-layout,
  .vt-featured-collections__container > .vt-column-layout,
  .vt-featured-collections__container > .vt-collection-list {
    width: 100%;
  }

  /* Heading & Paragraph styling at section level (e.g. for header column-layout / heading-group / stack / paragraph) */
  .vt-featured-collections .vt-heading,
  .vt-featured-collections .vt-heading-group,
  .vt-featured-collections .vt-subheading {
    color: var(--vt-heading-color, #003225);
  }

  .vt-featured-collections .vt-heading-group .vt-heading {
    color: inherit;
  }

  .vt-featured-collections .vt-paragraph {
    color: var(--vt-paragraph-color, #224E09);
  }

  /* Preserve collection cards' own scoped colors */
  .vt-featured-collections .vt-collection-card .vt-heading {
    color: #FFFFFF;
  }

  .vt-featured-collections .vt-collection-card .vt-paragraph,
  .vt-featured-collections .vt-collection-card .vt-paragraph * {
    color: rgba(255, 255, 255, 0.9);
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    .vt-featured-collections__container {
      padding-left: clamp(20px, calc(var(--vt-ph, 34px) * 0.8), 34px);
      padding-right: clamp(20px, calc(var(--vt-ph, 34px) * 0.8), 34px);
    }
  }

  @media screen and (max-width: 768px) {
    .vt-featured-collections {
      padding-top: var(--vt-pt-mobile, 48px);
      padding-bottom: var(--vt-pb-mobile, 48px);
    }

    .vt-featured-collections__container {
      padding-left: var(--vt-ph-mobile, 20px);
      padding-right: var(--vt-ph-mobile, 20px);
      gap: var(--vt-block-gap-mobile, 40px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "featured-collections-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EBF7BE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#003225"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph color",
      "default": "#224E09"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Side padding (left & right)",
      "default": 34
    },
    {
      "type": "range",
      "id": "block_gap",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Gap",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Side padding (left & right)",
      "default": 20
    },
    {
      "type": "range",
      "id": "block_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap",
      "default": 40
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "settings": {
        "full_width": true,
        "bg_color": "#EBF7BE",
        "heading_color": "#003225",
        "paragraph_color": "#224E09",
        "padding_top": 80,
        "padding_bottom": 96,
        "padding_horizontal": 34,
        "block_gap": 64,
        "padding_top_mobile": 48,
        "padding_bottom_mobile": 48,
        "padding_horizontal_mobile": 20,
        "block_gap_mobile": 40
      },
      "blocks": [
        {
          "type": "collection-list",
          "blocks": [
            {
              "id": "collection_card",
              "type": "collection-card",
              "static": true,
              "blocks": [
                {
                  "type": "collection-title",
                  "settings": {
                    "heading_size": "vt-heading-h3",
                    "heading_tag": "h3"
                  }
                },
                {
                  "type": "collection-paragraph",
                  "settings": {
                    "paragraph_size": "vt-paragraph-medium"
                  }
                },
                {
                  "type": "collection-button",
                  "settings": {
                    "button_label": "DISCOVER",
                    "button_style": "link-light"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
