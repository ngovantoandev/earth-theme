{% doc %}
  Renders a pill badge with custom text, background color, text color, size presets, and custom font size.

  @example
  {% content_for 'block', type: 'badge', id: 'badge' %}
{% enddoc %}

{%- if block.settings.text != blank -%}
  {%- assign badge_size = block.settings.badge_size | default: 'vt-paragraph-extra-small' -%}

  {%- assign vt_classes = 'vt-badge' -%}
  {%- assign vt_classes = vt_classes | append: ' ' | append: badge_size -%}
  {%- assign vt_classes = vt_classes | append: ' vt-badge--width-' | append: block.settings.width -%}

  {%- if block.settings.show_border -%}
    {%- assign vt_classes = vt_classes | append: ' vt-badge--border' -%}
  {%- endif -%}

  {%- assign vt_style = '' -%}

  {%- if block.settings.bg_color != blank -%}
    {%- assign vt_style = vt_style | append: ' --vt-badge-bg: ' | append: block.settings.bg_color | append: ';' -%}
  {%- endif -%}

  {%- if block.settings.text_color != blank -%}
    {%- assign vt_style = vt_style | append: ' --vt-badge-color: ' | append: block.settings.text_color | append: ';' -%}
  {%- endif -%}

  {%- if block.settings.radius != blank -%}
    {%- assign vt_style = vt_style | append: ' --vt-badge-radius: ' | append: block.settings.radius | append: ';' -%}
  {%- endif -%}

  {%- if badge_size == 'vt-paragraph-custom' and block.settings.font_size != blank and block.settings.font_size > 0 -%}
    {%- assign vt_style = vt_style | append: ' --vt-badge-font-size: ' | append: block.settings.font_size | append: ';' -%}
  {%- endif -%}

  {%- if block.settings.width == 'custom' and block.settings.width_custom != blank -%}
    {%- assign vt_style = vt_style | append: ' --vt-badge-width: ' | append: block.settings.width_custom | append: '%;' -%}
  {%- endif -%}

  {%- if block.settings.show_border -%}
    {%- if block.settings.border_size != blank -%}
      {%- assign vt_style = vt_style | append: ' --vt-badge-border-width: ' | append: block.settings.border_size | append: 'px;' -%}
    {%- endif -%}

    {%- if block.settings.border_color != blank -%}
      {%- assign vt_style = vt_style | append: ' --vt-badge-border-color: ' | append: block.settings.border_color | append: ';' -%}
    {%- endif -%}
  {%- endif -%}

  <div
    class="{{ vt_classes }}"
    {% if vt_style != '' %}
      style="{{ vt_style | strip }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ block.settings.text }}
  </div>
{%- endif -%}

{% stylesheet %}
  .vt-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;    
    background-color: var(--vt-badge-bg);
    color: var(--vt-badge-color);
    font-family: var(--vt-font-family-body);
    line-height: 1.3;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: 0.02em;    
    border-radius: var(--vt-badge-radius, 50%);
    border-style: solid;
    border-width: var(--vt-badge-border-width, 0);
    border-color: var(--vt-badge-border-color, transparent);
    box-sizing: border-box;
  }

  .vt-badge.vt-paragraph-extra-small {
    font-size: var(--vt-font-extra-small-size);
    padding: .125rem .875rem;    
  }

  .vt-badge.vt-paragraph-small {
    font-size: var(--vt-font-small-size);
    padding: .1875rem .9375rem;    
  }

  .vt-badge.vt-paragraph-medium {
    font-size: var(--vt-font-body-size);    
    padding: .25rem .875rem;  
  }

  .vt-badge.vt-paragraph-large {
    font-size: var(--vt-font-large-size);
    padding: .3125rem 1rem;
  }

  .vt-badge.vt-paragraph-custom {    
    font-size: calc(var(--vt-badge-font-size, 12) / 16 * 1rem);
  }

  .vt-badge--width-fit {
    width: fit-content;
  }

  .vt-badge--width-fill {
    width: 100%;
  }

  .vt-badge--width-custom {
    width: var(--vt-badge-width, 50%);
  }

  .vt-badge--border {
    border-width: var(--vt-badge-border-width, 1px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Badge",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Badge label"
    },
    {
      "type": "select",
      "id": "radius",
      "options": [
        { "value": "3.125rem", "label": "Pill badge" },
        { "value": "0", "label": "Square badge" },
        { "value": "0.5rem", "label": "Default badge" }
      ],
      "default": "3.125rem",
      "label": "Badge style"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Badge with outline",
      "default": false
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "badge_size",
      "options": [
        {
          "value": "vt-paragraph-extra-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__1.label"
        },
        {
          "value": "vt-paragraph-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__2.label"
        },
        {
          "value": "vt-paragraph-medium",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__3.label"
        },
        {
          "value": "vt-paragraph-large",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__4.label"
        },
        {
          "value": "vt-paragraph-custom",
          "label": "Custom"
        }
      ],
      "default": "vt-paragraph-medium",
      "label": "Badge size"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16,
      "visible_if": "{{ block.settings.badge_size == 'vt-paragraph-custom' }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "Custom width",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "border_size",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "label": "Outline size",
      "default": 1,
      "visible_if": "{{ block.settings.show_border }}"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EAE060"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#003225"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Outline color",
      "default": "#003225",
      "visible_if": "{{ block.settings.show_border }}"
    }
  ],
  "presets": [
    {
      "name": "Badge"
    }
  ]
}
{% endschema %}
