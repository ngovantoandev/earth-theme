{% doc %}
  Renders a pill badge with custom text, background color, text color, size presets, and custom font size.

  @example
  {% content_for 'block', type: 'badge', id: 'badge' %}
{% enddoc %}

{%- if block.settings.text != blank -%}
  {%- assign badge_size = block.settings.badge_size | default: 'vt-paragraph-extra-small' -%}
  {%- assign vt_style = '' -%}

  {%- if block.settings.bg_color != blank -%}
    {%- assign vt_style = vt_style | append: ' --vt-badge-bg: ' | append: block.settings.bg_color | append: ';' -%}
  {%- endif -%}

  {%- if block.settings.text_color != blank -%}
    {%- assign vt_style = vt_style | append: ' --vt-badge-color: ' | append: block.settings.text_color | append: ';' -%}
  {%- endif -%}

  {%- if block.settings.font_size != blank and block.settings.font_size > 0 -%}
    {%- assign vt_style = vt_style | append: ' font-size: ' | append: block.settings.font_size | append: 'px !important;' -%}
  {%- endif -%}

  {%- if block.settings.margin_top != blank and block.settings.margin_top > 0 -%}
    {%- assign vt_style = vt_style | append: ' margin-top: ' | append: block.settings.margin_top | append: 'px;' -%}
  {%- endif -%}

  {%- if block.settings.margin_bottom != blank and block.settings.margin_bottom > 0 -%}
    {%- assign vt_style = vt_style | append: ' margin-bottom: ' | append: block.settings.margin_bottom | append: 'px;' -%}
  {%- endif -%}

  <span
    class="vt-badge {{ badge_size }}"
    {% if vt_style != '' %}
      style="{{ vt_style | strip }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ block.settings.text }}
  </span>
{%- endif -%}

{% stylesheet %}
  .vt-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 14px;
    border-radius: 9999px;
    background-color: var(--vt-badge-bg, #EAE060);
    color: var(--vt-badge-color, #003225) !important;
    font-family: var(--vt-font-family-body);
    font-weight: 400;
    line-height: 1.3;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: var(--vt-font-extra-small-size);
  }

  .vt-badge.vt-paragraph-extra-small {
    font-size: var(--vt-font-extra-small-size);
  }

  .vt-badge.vt-paragraph-small {
    font-size: var(--vt-font-small-size);
  }

  .vt-badge.vt-paragraph-medium {
    font-size: var(--vt-font-body-size);
  }

  .vt-badge.vt-paragraph-large {
    font-size: var(--vt-font-large-size);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "GOTS"
    },
    {
      "type": "select",
      "id": "badge_size",
      "options": [
        {
          "value": "vt-paragraph-extra-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__1.label"
        },
        {
          "value": "vt-paragraph-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__2.label"
        },
        {
          "value": "vt-paragraph-medium",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__3.label"
        },
        {
          "value": "vt-paragraph-large",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__4.label"
        }
      ],
      "default": "vt-paragraph-extra-small",
      "label": "t:blocks.paragraph.settings.paragraph_size.label"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Custom font size (0 for default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EAE060"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#003225"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Margin bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Badge"
    }
  ]
}
{% endschema %}
