{% doc %}
  Renders a button block.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}

{%- assign button_class = 'vt-button' -%}

{%- case block.settings.button_style -%}
  {%- when 'primary' -%}
    {%- assign button_class = button_class | append: ' vt-button--primary' -%}

  {%- when 'secondary' -%}
    {%- assign button_class = button_class | append: ' vt-button--secondary' -%}

  {%- when 'outline' -%}
    {%- assign button_class = button_class | append: ' vt-button--outline' -%}

  {%- when 'accent' -%}
    {%- assign button_class = button_class | append: ' vt-button--accent' -%}

  {%- when 'link' -%}
    {%- assign button_class = button_class | append: ' vt-button--link' -%}

  {%- when 'link-light' -%}
    {%- assign button_class = button_class | append: ' vt-button--link-light' -%}
{%- endcase -%}

{%- if settings.buttons_hover_effect == 'standard' -%}
  {%- assign button_class = button_class | append: ' vt-button--hover-standard' -%}
{%- endif -%}

{%- comment -%}
  Build animation classes
{%- endcomment -%}

{%- assign animation_type = block.settings.animation_type -%}
{%- assign vt_anim_classes = '' -%}

{%- unless animation_type == 'none' or request.visual_preview_mode -%}
  {%- assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type -%}

  {%- if animation_type == 'slide' or animation_type == 'float' -%}
    {%- assign vt_anim_classes = vt_anim_classes
      | append: ' vt-animate--dir-'
      | append: block.settings.animation_direction
    -%}
  {%- endif -%}
{%- endunless -%}

{%- comment -%}
  Build animation CSS custom properties
{%- endcomment -%}

{%- assign vt_style = '' -%}

{%- unless animation_type == 'none' -%}
  {%- assign vt_style = vt_style
    | append: '--vt-duration: '
    | append: block.settings.animation_duration
    | append: 's;'
  -%}

  {%- assign vt_style = vt_style | append: ' --vt-delay: ' | append: block.settings.animation_delay | append: 's;' -%}

  {%- if animation_type == 'slide' or animation_type == 'float' or animation_type == 'blur' -%}
    {%- case block.settings.animation_easing -%}
      {%- when 'linear' -%}
        {%- assign vt_easing_value = 'linear' -%}

      {%- when 'ease-out-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}

      {%- when 'ease-in-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)' -%}

      {%- when 'ease-in-out-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)' -%}

      {%- when 'ease-in-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)' -%}

      {%- when 'ease-out-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)' -%}

      {%- when 'ease-in-out-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)' -%}

      {%- else -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}
    {%- endcase -%}

    {%- assign vt_style = vt_style | append: ' --vt-easing: ' | append: vt_easing_value | append: ';' -%}
  {%- endif -%}

  {%- if animation_type == 'blur' -%}
    {%- assign vt_style = vt_style
      | append: ' --vt-blur: '
      | append: block.settings.animation_blur_intensity
      | append: 'px;'
    -%}
  {%- endif -%}
{%- endunless -%}

{% liquid
  assign current_col = closest.collection | default: col | default: collection
  assign target_link = block.settings.button_link
  if current_col.url != blank
    if target_link == blank or target_link == 'shopify://collections/all' or target_link == '#'
      assign target_link = current_col.url
    endif
  endif

  assign btn_label = block.settings.button_label
  if btn_label == blank or btn_label contains 't:blocks.button'
    assign btn_label = 'DISCOVER'
  endif

  assign btn_align = block.settings.button_alignment | default: 'inherit'
  assign align_class = ''
  case btn_align
    when 'left'
      assign align_class = ' vt-buttons--left'
    when 'center'
      assign align_class = ' vt-buttons--center'
    when 'right'
      assign align_class = ' vt-buttons--right'
  endcase
%}

{%- if btn_label != blank -%}
  <div class="vt-buttons vt-collection-buttons{{ align_class }}">
    <a
      {% if target_link == blank %}
        role="link"
        aria-disabled="true"

      {% else %}
        href="{{ target_link }}"
      {% endif %}

      {% if block.settings.open_in_new_tab %}
        target="_blank"
        rel="noopener noreferrer"
      {% endif %}

      class="
        {{ button_class }}        
        {{ vt_anim_classes }}
      "

      {% if vt_style != blank %}
        style="{{ vt_style | strip }}"
      {% endif %}

      {{ block.shopify_attributes }}
    >
      <span class="vt-button-label">
        {{ btn_label }}
      </span>

      {% if block.settings.button_style == 'link' or block.settings.button_style == 'link-light' %}
        <span
          class="vt-button-icon vt-button__arrow"
          aria-hidden="true"
        >
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
        </span>
      {% endif %}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  .vt-collection-buttons {
    width: 100%;
  }

  .vt-collection-buttons.vt-buttons--left {
    justify-content: flex-start !important;
  }
  .vt-collection-buttons.vt-buttons--left > a {
    margin-right: auto !important;
    margin-left: 0 !important;
  }

  .vt-collection-buttons.vt-buttons--center {
    justify-content: center !important;
  }
  .vt-collection-buttons.vt-buttons--center > a {
    margin-inline: auto !important;
  }

  .vt-collection-buttons.vt-buttons--right {
    justify-content: flex-end !important;
  }
  .vt-collection-buttons.vt-buttons--right > a {
    margin-left: auto !important;
    margin-right: 0 !important;
  }
{% endstylesheet %}

{% schema %}
{
    "name": "Collection button",
    "tag": null,
    "settings":
    [
        {
            "type": "text",
            "id": "button_label",
            "default": "t:blocks.button.settings.button_label.name",
            "label": "t:blocks.button.settings.button_label.label",
            "info": "t:blocks.button.settings.button_label.info"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "t:blocks.button.settings.button_link.label"
        },
        {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "default": false,
            "label": "t:blocks.button.settings.open_in_new_tab.label"
        },
        {
            "type": "select",
            "id": "button_style",
            "options":
            [
                {
                    "value": "primary",
                    "label": "t:blocks.button.settings.button_style.primary.label"
                },
                {
                    "value": "secondary",
                    "label": "t:blocks.button.settings.button_style.secondary.label"
                },
                {
                    "value": "outline",
                    "label": "t:blocks.button.settings.button_style.outline.label"
                },
                {
                    "value": "accent",
                    "label": "t:blocks.button.settings.button_style.accent.label"
                },
                {
                    "value": "link",
                    "label": "t:blocks.button.settings.button_style.link.label"
                },
                {
                    "value": "link-light",
                    "label": "t:blocks.button.settings.button_style.link_light.label"
                }
            ],
            "default": "link-light",
            "label": "t:blocks.button.settings.button_style.label"
        },
        {
            "type": "select",
            "id": "button_alignment",
            "options":
            [
                {
                    "value": "inherit",
                    "label": "inherit"
                },
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "inherit",
            "label": "Alignment"
        },
        {
            "type": "header",
            "content": "t:blocks.button.settings.header_animation.content"
        },
        {
            "type": "select",
            "id": "animation_type",
            "options":
            [
                {
                    "value": "none",
                    "label": "t:blocks.button.settings.animation_type.options__1.label"
                },
                {
                    "value": "fade",
                    "label": "t:blocks.button.settings.animation_type.options__2.label"
                },
                {
                    "value": "slide",
                    "label": "t:blocks.button.settings.animation_type.options__3.label"
                },
                {
                    "value": "float",
                    "label": "t:blocks.button.settings.animation_type.options__4.label"
                },
                {
                    "value": "blur",
                    "label": "t:blocks.button.settings.animation_type.options__5.label"
                }
            ],
            "default": "slide",
            "label": "t:blocks.button.settings.animation_type.label"
        },
        {
            "type": "select",
            "id": "animation_direction",
            "options":
            [
                {
                    "value": "from-left",
                    "label": "t:blocks.button.settings.animation_direction.options__1.label"
                },
                {
                    "value": "from-right",
                    "label": "t:blocks.button.settings.animation_direction.options__2.label"
                },
                {
                    "value": "from-top",
                    "label": "t:blocks.button.settings.animation_direction.options__3.label"
                },
                {
                    "value": "from-bottom",
                    "label": "t:blocks.button.settings.animation_direction.options__4.label"
                }
            ],
            "default": "from-bottom",
            "label": "t:blocks.button.settings.animation_direction.label",
            "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'float' }}"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "unit": "s",
            "default": 1.2,
            "label": "t:blocks.button.settings.animation_duration.label",
            "visible_if": "{{ block.settings.animation_type != 'none' }}"
        },
        {
            "type": "range",
            "id": "animation_delay",
            "min": 0,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.2,
            "label": "t:blocks.button.settings.animation_delay.label",
            "visible_if": "{{ block.settings.animation_type != 'none' }}"
        },
        {
            "type": "select",
            "id": "animation_easing",
            "options":
            [
                {
                    "value": "linear",
                    "label": "t:blocks.button.settings.animation_easing.options__1.label"
                },
                {
                    "value": "ease-out-sine",
                    "label": "t:blocks.button.settings.animation_easing.options__2.label"
                },
                {
                    "value": "ease-in-sine",
                    "label": "t:blocks.button.settings.animation_easing.options__3.label"
                },
                {
                    "value": "ease-in-out-sine",
                    "label": "t:blocks.button.settings.animation_easing.options__4.label"
                },
                {
                    "value": "ease-in-cubic",
                    "label": "t:blocks.button.settings.animation_easing.options__5.label"
                },
                {
                    "value": "ease-out-cubic",
                    "label": "t:blocks.button.settings.animation_easing.options__6.label"
                },
                {
                    "value": "ease-in-out-cubic",
                    "label": "t:blocks.button.settings.animation_easing.options__7.label"
                }
            ],
            "default": "ease-out-sine",
            "label": "t:blocks.button.settings.animation_easing.label",
            "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'float' or block.settings.animation_type == 'blur' }}"
        },
        {
            "type": "range",
            "id": "animation_blur_intensity",
            "min": 5,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 5,
            "label": "t:blocks.button.settings.animation_blur_intensity.label",
            "visible_if": "{{ block.settings.animation_type == 'blur' }}"
        }
    ],
    "presets":
    [
      {
        "name": "Collection button",
        "settings": {
          "button_label": "Discover",
          "button_link": "shopify://collections/all",
          "open_in_new_tab": false,
          "button_style": "link-light",
          "animation_type": "slide",
          "animation_direction": "from-bottom",
          "animation_duration": 1.2,
          "animation_delay": 0.2,
          "animation_easing": "ease-out-sine",
          "animation_blur_intensity": 5
        }
      }
    ]
}
{% endschema %}
