{% doc %}
  Renders a group of blocks with configurable layout direction, gap and
  alignment.

  All settings apply to only one dimension to reduce configuration complexity.

  This component is a wrapper concerned only with rendering its children in
  the specified layout direction with appropriate padding and alignment.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

{%- liquid
  assign gap_mobile_px = block.settings.gap_mobile
  assign gap_desktop_px = block.settings.gap_desktop

  case block.settings.alignment
    when 'center'
      assign vt_align_items = 'center'
      assign vt_justify = 'center'
      assign vt_text_align = 'center'
    when 'right'
      assign vt_align_items = 'flex-end'
      assign vt_justify = 'flex-end'
      assign vt_text_align = 'right'
    else
      assign vt_align_items = 'flex-start'
      assign vt_justify = 'flex-start'
      assign vt_text_align = 'left'
  endcase

  assign vt_valign = block.settings.position | default: 'flex-start'
-%}

<div
  class="group {{ block.settings.layout_direction }} group--align-{{ block.settings.alignment | default: 'left' }} group--width-{{ block.settings.width | default: 'fill' }}"
  style="
    --vt-align-items: {{ vt_align_items }};
    --vt-justify: {{ vt_justify }};
    --vt-text-align: {{ vt_text_align }};
    --vt-position: {{ vt_valign }};
    --vt-group-gap: {% render 'fluid-clamp', min_px: gap_mobile_px, max_px: gap_desktop_px %};
    {%- if block.settings.width == 'custom' %}
    --vt-group-width: {{ block.settings.width_custom }}%;
    {%- endif %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .group {
    display: flex;
    flex-wrap: nowrap;
    width: 100%;
    box-sizing: border-box;
  }

  .group--width-fit {
    width: fit-content;
    max-width: 100%;
  }

  .group--width-fill {
    width: 100%;
  }

  .group--width-custom {
    width: var(--vt-group-width, 100%);
  }

  .group--horizontal {
    flex-direction: row;
    justify-content: var(--vt-justify, flex-start);
    align-items: var(--vt-position, center);
    text-align: var(--vt-text-align, left);
  }

  .group--vertical {
    gap: var(--vt-group-gap);
    flex-direction: column;
    align-items: var(--vt-align-items, flex-start);
    justify-content: var(--vt-position, flex-start);
    text-align: var(--vt-text-align, left);
  }

  .group--vertical.group--align-center {
    align-items: center;
    text-align: center;
    justify-content: center;
  }

  .group--vertical.group--align-center > * {
    margin-inline: auto;
  }

  .group--vertical.group--align-center .vt-paragraph {
    justify-content: center;
    text-align: center;
  }

  .group--vertical.group--align-center .vt-paragraph p {
    text-align: center;
  }

  .group--vertical.group--align-right {
    align-items: flex-end;
    text-align: right;
  }

  .group--vertical.group--align-right > * {
    margin-inline-start: auto;
    margin-inline-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.group",
  "tag": null,
  "blocks": [
    { "type": "@theme" }   
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "t:labels.layout_direction",
      "default": "group--vertical",
      "options": [
        { "value": "group--horizontal", "label": "t:options.direction.horizontal" },
        { "value": "group--vertical", "label": "t:options.direction.vertical" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "visible_if": "{{ block.settings.layout_direction == 'group--vertical' }}",
      "type": "select",
      "id": "position",
      "label": "t:labels.position",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:options.position.top" },
        { "value": "center", "label": "t:options.position.center" },
        { "value": "flex-end", "label": "t:options.position.bottom" },
        { "value": "stretch", "label": "t:options.position.stretch" }
      ]
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "Custom width",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "fit"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.gap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [    
    {
      "name": "Group",
      "blocks": [
        { "type": "@theme" }      
      ] 
    },
    {
      "name": "t:general.column",
      "category": "t:general.layout",
      "settings": {
        "layout_direction": "group--vertical",
        "position": "flex-start"
      }
    },
    {
      "name": "t:general.row",
      "category": "t:general.layout",
      "settings": {
        "layout_direction": "group--horizontal"
      }
    }
  ]
}
{% endschema %}
