{% doc %}
  Renders a collection product grid layout using Theme Blocks.
  - Takes products dynamically from `collection.products`.
  - Repeats child theme blocks (e.g., `product-card`) for each product.
  - Controls columns and gap spacing via CSS variables on desktop and mobile.
{% enddoc %}

{%- liquid
  # Xác định danh sách sản phẩm cần render (hoặc giả lập 6 item trong theme editor/preview)
  if collection.products.size > 0
    assign products_to_render = collection.products
  elsif request.design_mode or request.visual_preview_mode
    assign products_to_render = (1..6)
  endif
-%}

{%- comment -%}
  =============================================================================
  1. ĐỔ SETTING VÀO CSS VARIABLES TRÊN THẺ GỐC (.product-list)
  - Desktop: --cols (số cột), --gap-x (khoảng cách ngang), --gap-y (khoảng cách dọc)
  - Mobile:  --cols-m, --gap-x-m, --gap-y-m
  =============================================================================
{%- endcomment -%}
<div
  class="product-list{% if block.settings.full_width %} product-list--full-width{% endif %}"
  style="
    --cols: {{ block.settings.columns | default: 3 }};
    --gap-x: {{ block.settings.horizontal_gap | default: 12 }}px;
    --gap-y: {{ block.settings.vertical_gap | default: 28 }}px;
    --cols-m: {{ block.settings.columns_mobile | default: 2 }};
    --gap-x-m: {{ block.settings.horizontal_gap_mobile | default: 8 }}px;
    --gap-y-m: {{ block.settings.vertical_gap_mobile | default: 24 }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if products_to_render != blank -%}
    <div class="product-list__grid">
      {%- for product in products_to_render -%}
        <div class="product-list__item">
          {% content_for 'blocks' %}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="product-list__empty">
      <p class="product-list__empty-text">No products found</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* =========================================================
     Product List Grid (BEM Architecture & CSS Variables)
     ========================================================= */
  .product-list {
    width: 100%;
    box-sizing: border-box;
  }

  /*
    2. ĐỌC SETTING TRONG CSS:
    .product-list__grid đọc trực tiếp các biến --cols, --gap-x, --gap-y
    từ inline style của thẻ cha
  */
  .product-list__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    column-gap: var(--gap-x, 12px);
    row-gap: var(--gap-y, 28px);
    width: 100%;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  .product-list__item {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* Đảm bảo block con (như product-card) phủ trọn 100% kích thước ô grid */
  .product-list__item > * {
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
  }

  .product-list__empty {
    width: 100%;
    text-align: center;
    padding: 48px 16px;
    box-sizing: border-box;
  }

  .product-list__empty-text {
    margin: 0;
    opacity: 0.75;
  }

  /* =========================================================
     Mobile Breakpoint (<= 749px)
     ========================================================= */
  @media screen and (max-width: 749px) {
    .product-list__grid {
      grid-template-columns: repeat(var(--cols-m, 2), minmax(0, 1fr));
      column-gap: var(--gap-x-m, 8px);
      row-gap: var(--gap-y-m, 24px);
    }

    /*
      Modifier tràn viền: triệt tiêu padding của container cha bằng margin âm
    */
    .product-list--full-width {
      width: calc(100% + var(--container-padding-mobile, var(--vt-ph-mobile, 20px)) * 2);
      margin-left: calc(-1 * var(--container-padding-mobile, var(--vt-ph-mobile, 20px)));
      margin-right: calc(-1 * var(--container-padding-mobile, var(--vt-ph-mobile, 20px)));
      padding-left: 0;
      padding-right: 0;
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product list",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "horizontal_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "horizontal_gap_mobile",
      "label": "Horizontal gap (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "vertical_gap_mobile",
      "label": "Vertical gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product list",
      "settings": {
        "columns": "3",
        "horizontal_gap": 12,
        "vertical_gap": 28,
        "columns_mobile": "2",
        "horizontal_gap_mobile": 8,
        "vertical_gap_mobile": 24,
        "full_width": false
      },
      "blocks": [
        {
          "type": "product-card"
        }
      ]
    }
  ]
}
{% endschema %}
