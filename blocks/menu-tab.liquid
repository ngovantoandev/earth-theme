{% doc %}
  Renders the complete menu tablist component in product-listing-tab.
  Accepts collection-title child block for each tab title.
{% enddoc %}

{%- liquid
  assign align = tab_align | default: block.settings.tab_alignment | default: 'center'
  assign show_line = block.settings.show_line
  if show_line == nil
    assign show_line = true
  endif
  assign show_active_line = block.settings.show_active_line
  if show_active_line == nil
    assign show_active_line = true
  endif
-%}

<div
  class="plt__tablist-container plt__tablist-container--{{ align }}{% unless show_line %} plt__tablist-container--no-line{% endunless %}{% unless show_active_line %} plt__tablist-container--no-active-line{% endunless %}"
  style="
    --plt-menu-ph-desktop: {{ block.settings.padding_horizontal_desktop | default: 34 }}px;
    --plt-menu-ph-mobile: {{ block.settings.padding_horizontal_mobile | default: 20 }}px;
    --plt-tab-item-ph: {{ block.settings.item_padding_horizontal | default: 24 }}px;
    --plt-tab-item-ph-mobile: {{ block.settings.item_padding_horizontal_mobile | default: 16 }}px;
    --plt-tab-color: {{ block.settings.title_color | default: '#003225' }};
    --plt-tab-active-color: {{ block.settings.active_title_color | default: '#71CC3B' }};
    --plt-tab-line-color: {{ block.settings.line_color | default: '#003225' }};
    --plt-tab-active-line-color: {{ block.settings.active_line_color | default: '#71CC3B' }};
  "
  {{ block.shopify_attributes }}
>
  {%- assign tabs_count = 0 -%}
  {%- if is_connected and tabs_data != blank -%}
    {%- assign tabs_count = tabs_data.size -%}
  {%- else -%}
    {%- assign tabs_count = demo_tabs.size | default: 4 -%}
  {%- endif -%}

  <div 
    class="plt__tablist{% if tabs_count == 1 %} plt__tablist--single{% endif %}" 
    role="tablist" 
    aria-label="{{ 'products.facets.filter_by_label' | default: 'Collections' }}"
  >
    {%- if is_connected and tabs_data != blank -%}
      {%- for col in tabs_data -%}
        {%- assign tab_id = 'plt-tab-' | append: col.id -%}
        {%- assign panel_id = 'plt-panel-' | append: col.id -%}
        <button
          type="button"
          role="tab"
          id="{{ tab_id }}"
          class="plt__tab{% if forloop.first %} plt__tab--active{% endif %}"
          aria-controls="{{ panel_id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          data-collection="{{ col.handle }}"
          data-tab-index="{{ forloop.index0 }}"
        >
          {% content_for 'block', type: 'collection-title', id: 'collection-title', closest.collection: col, collection: col, col: col, default_title: col.title %}
        </button>
      {%- endfor -%}
    {%- else -%}
      {%- assign demo_count = demo_tabs | default: (1..4) -%}
      {%- for i in demo_count -%}
        {%- assign tab_id = 'plt-tab-demo-' | append: forloop.index -%}
        {%- assign panel_id = 'plt-panel-demo-' | append: forloop.index -%}
        <button
          type="button"
          role="tab"
          id="{{ tab_id }}"
          class="plt__tab{% if forloop.first %} plt__tab--active{% endif %}"
          aria-controls="{{ panel_id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          data-collection="demo-{{ forloop.index }}"
          data-tab-index="{{ forloop.index0 }}"
        >
          {% content_for 'block', type: 'collection-title', id: 'collection-title', default_title: 'Collection title' %}
        </button>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .plt__tablist {
    border-bottom: 1px solid var(--plt-tab-line-color, var(--color-black, #003225));
  }

  .plt__tablist--single,
  .plt__tablist:has(.plt__tab:only-child) {
    border-bottom-color: var(--plt-tab-active-line-color, var(--color-secondary, #71CC3B));
  }

  .plt__tablist-container--no-line .plt__tablist,
  .plt__tablist-container--no-line .plt__tablist--single,
  .plt__tablist-container--no-line .plt__tablist:has(.plt__tab:only-child) {
    border-bottom: none !important;
  }

  .plt__tablist-container--no-active-line .plt__tablist--single,
  .plt__tablist-container--no-active-line .plt__tablist:has(.plt__tab:only-child) {
    border-bottom-color: var(--plt-tab-line-color, var(--color-black, #003225));
  }

  .plt__tab {
    color: var(--plt-tab-color, var(--color-black, #003225));
  }

  .plt__tab .vt-heading,
  .plt__tab .vt-heading-wrapper h1,
  .plt__tab .vt-heading-wrapper h2,
  .plt__tab .vt-heading-wrapper h3,
  .plt__tab .vt-heading-wrapper h4,
  .plt__tab .vt-heading-wrapper h5,
  .plt__tab .vt-heading-wrapper h6 {
    color: inherit;
  }

  .plt__tab:hover,
  .plt__tab--active {
    color: var(--plt-tab-active-color, var(--color-secondary, #71CC3B));
  }

  .plt__tab--active::after {
    height: 1px;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    background-color: var(--plt-tab-active-line-color, var(--color-secondary, #71CC3B));
    z-index: 10;
  }

  .plt__tablist-container--no-active-line .plt__tab--active::after {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Menu tab",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Tab lines"
    },
    {
      "type": "checkbox",
      "id": "show_line",
      "label": "Show line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_active_line",
      "label": "Show active line",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Collection title color",
      "default": "#003225"
    },
    {
      "type": "color",
      "id": "active_title_color",
      "label": "Active title color",
      "default": "#71CC3B"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#003225"
    },
    {
      "type": "color",
      "id": "active_line_color",
      "label": "Active line color",
      "default": "#71CC3B"
    },
    {
      "type": "header",
      "content": "Horizontal padding"
    },
    {
      "type": "range",
      "id": "padding_horizontal_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Tab item padding"
    },
    {
      "type": "range",
      "id": "item_padding_horizontal",
      "label": "Item padding (desktop)",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "item_padding_horizontal_mobile",
      "label": "Item padding (mobile)",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Menu tab",
      "settings": {
        "show_line": true,
        "show_active_line": true,
        "title_color": "#003225",
        "active_title_color": "#71CC3B",
        "line_color": "#003225",
        "active_line_color": "#71CC3B",
        "padding_horizontal_desktop": 34,
        "padding_horizontal_mobile": 20,
        "item_padding_horizontal": 24,
        "item_padding_horizontal_mobile": 16
      },
      "blocks": [
        {
          "type": "collection-title",
          "id": "collection-title",
          "static": true
        }
      ]
    }
  ]
}
{% endschema %}
