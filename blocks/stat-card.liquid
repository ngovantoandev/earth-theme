  <div class="vt-stat-card__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-stat-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: auto;
    background-color: var(--vt-stat-card-bg, #224E09);
    color: var(--vt-stat-card-text, #F8F9DC);
    border-radius: var(--vt-stat-card-radius, 8px);
    padding: var(--vt-stat-card-padding-v, 36px) var(--vt-stat-card-padding-h, 24px);
    overflow: hidden;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .vt-stat-card__watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: var(--vt-stat-card-watermark-opacity, 0.07);
    z-index: 0;
  }

  .vt-stat-card__watermark svg {
    width: 82%;
    height: 82%;
    max-width: 240px;
    max-height: 240px;
    object-fit: contain;
    color: var(--vt-stat-card-text, #F8F9DC);
  }

  .vt-stat-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: var(--vt-stat-card-gap, 12px);
  }

  /* Text color inside stat card */
  .vt-stat-card .vt-heading {
    color: inherit;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .vt-stat-card .vt-heading:not([style*="font-size"]):not([class*="vt-heading-"]):not([class*="vt-hero-heading"]) {
    font-size: clamp(2.1rem, 3.2vw, 2.75rem);
  }

  .vt-stat-card .vt-icon svg {
    color: inherit;
  }

  .vt-stat-card .vt-heading-wrapper {
    margin: 0;
  }

  .vt-stat-card .vt-subheading-wrapper {
    margin: 0;
  }

  .vt-stat-card .vt-subheading {
    color: inherit;
    font-weight: 500;
    line-height: 1.3;
    opacity: 0.95;
  }

  /* Note and label paragraphs inside card */
  .vt-stat-card .vt-paragraph {
    color: inherit;
    max-width: 260px;
    margin: 0 auto;
  }

  .vt-stat-card .vt-paragraph p {
    color: inherit;
    font-size: inherit;
    line-height: 1.35;
    margin: 0;
  }

  .vt-stat-card .vt-paragraph.vt-paragraph-extra-small p {
    color: var(--vt-stat-card-note, #F8F9DC);
    opacity: 0.85;
  }

  /* Badges row inside card */
  .vt-stat-card .group,
  .vt-stat-card .group--horizontal,
  .vt-stat-card .group--row {
    display: flex !important;
    flex-direction: row !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 0 !important;
    width: auto !important;
    margin-top: 4px !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stat card",
  "tag": null,
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#224E09"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F8F9DC"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Note text color",
      "default": "#F8F9DC"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap between elements",
      "default": 12
    },
    {
      "type": "header",
      "content": "Watermark"
    },
    {
      "type": "checkbox",
      "id": "show_watermark",
      "label": "Show watermark",
      "default": true
    },
    {
      "type": "select",
      "id": "watermark_icon",
      "label": "Watermark icon",
      "options": [
        { "value": "ecology", "label": "Recycling / Ecology" },
        { "value": "tree", "label": "Tree" },
        { "value": "zero-emissions", "label": "Zero emissions" },
        { "value": "quality", "label": "Quality / Badge" },
        { "value": "drop", "label": "Water drop" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "carbon", "label": "Carbon" }
      ],
      "default": "ecology"
    },
    {
      "type": "range",
      "id": "watermark_opacity",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "label": "Watermark opacity",
      "default": 7
    }
  ],
  "presets": [
    {
      "name": "Stat card"
    }
  ]
}
{% endschema %}
