{% doc %}
  Renders an impact metric statistic card with customizable background color, text color,
  border radius, padding, gap, and selectable watermark icon.

  @example
  {% content_for 'block', type: 'stat-card', id: 'stat-card' %}
{% enddoc %}

{%- liquid
  if block.settings.background_color != blank
    assign bg_color = block.settings.background_color
  else
    assign bg_color = '#224E09'
  endif

  if block.settings.text_color != blank
    assign text_color = block.settings.text_color
  else
    assign text_color = '#F8F9DC'
  endif

  if block.settings.note_color != blank
    assign note_color = block.settings.note_color
  else
    assign note_color = '#F8F9DC'
  endif

  assign border_radius_px = block.settings.border_radius | default: 8
  assign padding_v_px = block.settings.padding_vertical | default: 36
  assign padding_h_px = block.settings.padding_horizontal | default: 24
  assign gap_px = block.settings.gap | default: 12
  assign watermark_opacity = block.settings.watermark_opacity | default: 7 | times: 1.0 | divided_by: 100.0
  assign watermark_icon = block.settings.watermark_icon | default: 'ecology'
-%}

<div
  class="vt-stat-card"
  style="
    --vt-stat-card-bg: {{ bg_color }};
    --vt-stat-card-text: {{ text_color }};
    --vt-stat-card-note: {{ note_color }};
    --vt-stat-card-radius: {{ border_radius_px }}px;
    --vt-stat-card-padding-v: {{ padding_v_px }}px;
    --vt-stat-card-padding-h: {{ padding_h_px }}px;
    --vt-stat-card-gap: {{ gap_px }}px;
    --vt-stat-card-watermark-opacity: {{ watermark_opacity }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_watermark -%}
