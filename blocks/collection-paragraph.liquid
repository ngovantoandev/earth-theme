{% doc %}
  Renders a paragraph block.

  @example
  {% content_for 'block', type: 'paragraph', id: 'paragraph' %}
{% enddoc %}

{% liquid
  assign animation_type = block.settings.animation_type

  # -----------------------------------------------------------------------
  # Animation classes / custom properties. Skipped inside the visual preset
  # preview so presets render fully visible instead of waiting on an
  # IntersectionObserver that may never fire inside the preview frame.
  # -----------------------------------------------------------------------
  assign vt_anim_classes = ''
  unless animation_type == 'none' or request.visual_preview_mode
    assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type

    if animation_type == 'slide' or animation_type == 'float'
      assign vt_anim_classes = vt_anim_classes | append: ' vt-animate--dir-' | append: block.settings.animation_direction
    endif
  endunless

  assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)'
  case block.settings.animation_easing
    when 'linear'
      assign vt_easing_value = 'linear'
    when 'ease-out-sine'
      assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)'
    when 'ease-in-sine'
      assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)'
    when 'ease-in-out-sine'
      assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)'
    when 'ease-in-cubic'
      assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)'
    when 'ease-out-cubic'
      assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)'
    when 'ease-in-out-cubic'
      assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)'
  endcase

  # -----------------------------------------------------------------------
  # Class list (built with assign + append, no capture needed)
  # -----------------------------------------------------------------------
  assign vt_class_list = 'vt-paragraph ' | append: block.settings.paragraph_size | append: ' ' | append: block.settings.paragraph_alignment | append: ' vt-paragraph--width-' | append: block.settings.paragraph_width

  if vt_anim_classes != blank
    assign vt_class_list = vt_class_list | append: ' ' | append: vt_anim_classes
  endif
%}

{% liquid
  assign current_col = closest.collection | default: col | default: collection
  assign source = block.settings.content_source | default: 'description'
  assign words_limit = block.settings.truncate_words | default: 18

  assign has_custom_text = false
  if block.settings.text != blank and block.settings.text != 't:blocks.paragraph.settings.text.default' and block.settings.text != 't:blocks.collection_paragraph.settings.text.default'
    assign has_custom_text = true
    if block.settings.text contains 'Share information' or block.settings.text contains 'From farm to wardrobe' or block.settings.text contains 'Discover our latest'
      assign has_custom_text = false
    endif
  endif

  assign desc_text = ''

  if current_col != blank and current_col.title != blank
    case source
      when 'description'
        if current_col.description != blank
          assign col_desc = current_col.description | strip_html | strip
          if col_desc != blank
            assign truncated_desc = col_desc | truncatewords: words_limit
            assign desc_text = '<p>' | append: truncated_desc | append: '</p>'
          endif
        endif
        if desc_text == blank
          if has_custom_text
            assign desc_text = block.settings.text
          else
            assign desc_text = '<p>Discover our latest collection</p>'
          endif
        endif

      when 'product_count'
        assign count = current_col.all_products_count | default: current_col.products_count | default: 0
        assign desc_text = '<p>' | append: count | append: ' products</p>'

      when 'custom'
        assign desc_text = block.settings.text

      else
        # 'auto' mode: Prioritize real collection description, fallback to product count or title
        if current_col.description != blank
          assign col_desc = current_col.description | strip_html | strip
          if col_desc != blank
            assign truncated_desc = col_desc | truncatewords: words_limit
            assign desc_text = '<p>' | append: truncated_desc | append: '</p>'
          endif
        endif

        if desc_text == blank
          if current_col.all_products_count != blank and current_col.all_products_count > 0
            assign desc_text = '<p>' | append: current_col.all_products_count | append: ' products</p>'
          elsif has_custom_text
            assign desc_text = block.settings.text
          else
            assign desc_text = '<p>Discover our latest collection</p>'
          endif
        endif
    endcase
  else
    # Fallback when no collection is connected (preview / placeholder mode)
    if has_custom_text
      assign desc_text = block.settings.text
    else
      assign desc_text = '<p>Discover our latest collection</p>'
    endif
  endif
%}

{%- if desc_text != blank -%}
  <div
    class="{{ vt_class_list }}"
    style="
      {%- if block.settings.paragraph_width == 'custom' %}--vt-paragraph-width: {{ block.settings.width_custom }}%;{% endif -%}
      {%- if block.settings.enable_max_width %}--vt-paragraph-max-width: {% render 'fluid-clamp', min_px: block.settings.paragraph_max_width, max_px: block.settings.paragraph_max_width %};{% endif -%}
      {%- if vt_anim_classes != blank -%}
        --vt-duration: {{ block.settings.animation_duration }}s;
        --vt-delay: {{ block.settings.animation_delay }}s;
      {%- endif -%}
      {%- if animation_type == 'slide' or animation_type == 'float' or animation_type == 'blur' -%}
        --vt-easing: {{ vt_easing_value }};
      {%- endif -%}
      {%- if animation_type == 'blur' -%}
        --vt-blur: {{ block.settings.animation_blur_intensity }}px;
      {%- endif -%}
    "
    {{ block.shopify_attributes }}
  >
    {{ desc_text }}
  </div>
{%- endif -%}

{% stylesheet %}
  .vt-paragraph {
    display: flex;
    max-width: var(--vt-paragraph-max-width, none);
    contain: layout style;
  }

  .vt-paragraph.text-inherit {
    text-align: inherit;
    justify-content: inherit;
  }

  .vt-paragraph.text-left {
    text-align: left;
    justify-content: flex-start;
  }

  .vt-paragraph.text-center {
    text-align: center;
    justify-content: center;
  }

  .vt-paragraph.text-right {
    text-align: right;
    justify-content: flex-end;
  }

  /* Width variants */
  .vt-paragraph--width-fit {    
    width: fit-content;
  }

  .vt-paragraph--width-fill {
    width: 100%;
  }

  .vt-paragraph--width-max-content {
    width: max-content;
    max-width: 100%;
  }

  .vt-paragraph--width-min-content {
    width: min-content;
  }

  .vt-paragraph--width-custom {
    width: var(--vt-paragraph-width, auto);
  }

  .vt-paragraph:not(.vt-paragraph--width-fill).text-center {
    margin-inline: auto;
  }

  .vt-paragraph:not(.vt-paragraph--width-fill).text-right {
    margin-inline-start: auto;
    margin-inline-end: 0;
  }

{% endstylesheet %}

{% schema %}
{
    "name": "t:blocks.collection_paragraph.name",
    "tag": null,
    "settings":
    [
        {
            "type": "select",
            "id": "content_source",
            "label": "t:blocks.collection_paragraph.settings.content_source.label",
            "options": [
                { "value": "description", "label": "t:blocks.collection_paragraph.settings.content_source.description.label" },
                { "value": "product_count", "label": "t:blocks.collection_paragraph.settings.content_source.product_count.label" },
                { "value": "custom", "label": "t:blocks.collection_paragraph.settings.content_source.custom.label" }
            ],
            "default": "description"
        },
        {
            "type": "range",
            "id": "truncate_words",
            "min": 5,
            "max": 60,
            "step": 1,
            "unit": "w",
            "default": 18,
            "label": "t:blocks.collection_paragraph.settings.truncate_words.label",
            "visible_if": "{{ block.settings.content_source != 'product_count' and block.settings.content_source != 'custom' }}"
        },
        {
            "type": "richtext",
            "id": "text",            
            "default": "t:blocks.collection_paragraph.settings.text.default",
            "label": "t:blocks.collection_paragraph.settings.text.label"
        },      
        {
            "type": "header",
            "content": "t:blocks.collection_paragraph.settings.header_content.content"
        }, 
        {
            "type": "select",
            "id": "paragraph_alignment",
            "options":
            [
                {
                    "value": "text-left",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_alignment.options__1.label"
                },
                {
                    "value": "text-center",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_alignment.options__2.label"
                },
                {
                    "value": "text-right",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_alignment.options__3.label"
                },
                {
                    "value": "text-inherit",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_alignment.options__4.label"
                }            
            ],
            "default": "text-inherit",
            "label": "t:blocks.collection_paragraph.settings.paragraph_alignment.label"
        },
        {
            "type": "header",
            "content": "t:blocks.collection_paragraph.settings.header_size.content"
        }, 
        {
            "type": "select",
            "id": "paragraph_size",
            "options":
            [
                {
                    "value": "vt-paragraph-extra-small",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_size.options__1.label"
                },
                {
                    "value": "vt-paragraph-small",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_size.options__2.label"
                },
                {
                    "value": "vt-paragraph-medium",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_size.options__3.label"
                },
                {
                    "value": "vt-paragraph-large",
                    "label": "t:blocks.collection_paragraph.settings.paragraph_size.options__4.label"
                }
            ],
            "default": "vt-paragraph-medium",
            "label": "t:blocks.collection_paragraph.settings.paragraph_size.label"
        },        
        {
            "type": "select",
            "id": "paragraph_width",
            "label": "t:blocks.collection_paragraph.settings.paragraph_width.label",
            "options": [
                { "value": "fit", "label": "t:blocks.collection_paragraph.settings.paragraph_width.fit.label" },
                { "value": "fill", "label": "t:blocks.collection_paragraph.settings.paragraph_width.fill.label" },
                { "value": "max-content", "label": "t:blocks.collection_paragraph.settings.paragraph_width.max_content.label" },
                { "value": "min-content", "label": "t:blocks.collection_paragraph.settings.paragraph_width.min_content.label" },
                { "value": "custom", "label": "t:blocks.collection_paragraph.settings.paragraph_width.custom.label" }
            ],
            "default": "fit"
        },
        {
            "type": "range",
            "id": "width_custom",
            "label": "t:blocks.collection_paragraph.settings.width_custom.label",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50,
            "visible_if": "{{ block.settings.paragraph_width == 'custom' }}"
        },
        {
            "type": "checkbox",
            "id": "enable_max_width",
            "label": "t:blocks.collection_paragraph.settings.enable_max_width.label",            
            "default": false
        },
        {
            "type": "range",
            "id": "paragraph_max_width",
            "min": 100,
            "max": 1200,
            "step": 20,
            "unit": "px",
            "default": 600,
            "label": "t:blocks.collection_paragraph.settings.paragraph_max_width.label",
            "visible_if": "{{ block.settings.enable_max_width == true }}"
        },
        {
            "type": "header",
            "content": "t:blocks.collection_paragraph.settings.header_animation.content"
        },
        {
            "type": "select",
            "id": "animation_type",
            "options":
            [
                {
                    "value": "none",
                    "label": "t:blocks.collection_paragraph.settings.animation_type.options__1.label"
                },
                {
                    "value": "fade",
                    "label": "t:blocks.collection_paragraph.settings.animation_type.options__2.label"
                },
                {
                    "value": "slide",
                    "label": "t:blocks.collection_paragraph.settings.animation_type.options__3.label"
                },
                {
                    "value": "float",
                    "label": "t:blocks.collection_paragraph.settings.animation_type.options__4.label"
                },
                {
                    "value": "blur",
                    "label": "t:blocks.collection_paragraph.settings.animation_type.options__5.label"
                }
            ],
            "default": "none",
            "label": "t:blocks.collection_paragraph.settings.animation_type.label"
        },
        {
            "type": "select",
            "id": "animation_direction",
            "options":
            [
                {
                    "value": "from-left",
                    "label": "t:blocks.collection_paragraph.settings.animation_direction.options__1.label"
                },
                {
                    "value": "from-right",
                    "label": "t:blocks.collection_paragraph.settings.animation_direction.options__2.label"
                },
                {
                    "value": "from-top",
                    "label": "t:blocks.collection_paragraph.settings.animation_direction.options__3.label"
                },
                {
                    "value": "from-bottom",
                    "label": "t:blocks.collection_paragraph.settings.animation_direction.options__4.label"
                }
            ],
            "default": "from-bottom",
            "label": "t:blocks.collection_paragraph.settings.animation_direction.label",
            "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'float' }}"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "unit": "s",
            "default": 1.2,
            "label": "t:blocks.collection_paragraph.settings.animation_duration.label",
            "visible_if": "{{ block.settings.animation_type != 'none' }}"
        },
        {
            "type": "range",
            "id": "animation_delay",
            "min": 0,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.2,
            "label": "t:blocks.collection_paragraph.settings.animation_delay.label",
            "visible_if": "{{ block.settings.animation_type != 'none' }}"
        },
        {
            "type": "select",
            "id": "animation_easing",
            "options":
            [
                {
                    "value": "linear",
                    "label": "t:blocks.collection_paragraph.settings.animation_easing.options__1.label"
                },
                {
                    "value": "ease-out-sine",
                    "label": "t:blocks.collection_paragraph.settings.animation_easing.options__2.label"
                },
                {
                    "value": "ease-in-sine",
                    "label": "t:blocks.collection_paragraph.settings.animation_easing.options__3.label"
                },
                {
                    "value": "ease-in-out-sine",
                    "label": "t:blocks.collection_paragraph.settings.animation_easing.options__4.label"
                },
                {
                    "value": "ease-in-cubic",
                    "label": "t:blocks.collection_paragraph.settings.animation_easing.options__5.label"
                },
                {
                    "value": "ease-out-cubic",
                    "label": "t:blocks.collection_paragraph.settings.animation_easing.options__6.label"
                },
                {
                    "value": "ease-in-out-cubic",
                    "label": "t:blocks.collection_paragraph.settings.animation_easing.options__7.label"
                }
            ],
            "default": "ease-out-sine",
            "label": "t:blocks.collection_paragraph.settings.animation_easing.label",
            "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'float' or block.settings.animation_type == 'blur' }}"
        },
        {
            "type": "range",
            "id": "animation_blur_intensity",
            "min": 5,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 5,
            "label": "t:blocks.collection_paragraph.settings.animation_blur_intensity.label",
            "visible_if": "{{ block.settings.animation_type == 'blur' }}"
        }
    ],
    "presets":
    [
        {
            "name": "t:blocks.collection_paragraph.presets.name",
            "settings":{
                "content_source": "description",
                "truncate_words": 18,
                "text": "<p>Discover our latest collection of premium goods designed for modern living. Enjoy free shipping on orders over $50.</p>",
                "paragraph_size": "vt-paragraph-medium",
                "paragraph_alignment": "text-left",
                "paragraph_max_width": 800,
                "animation_type": "slide",
                "animation_direction": "from-bottom",
                "animation_duration": 1.2,
                "animation_delay": 0.2,
                "animation_easing": "ease-out-sine",
                "animation_blur_intensity": 5
            }
        }
    ]
}
{% endschema %}
