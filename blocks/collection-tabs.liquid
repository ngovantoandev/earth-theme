{% doc %}
  Renders a collection tabs parent container with carousel navigation.
  - Accepts 'collection-tab' child blocks.
  - Assembles tab buttons into a shared tablist header and manages panel switching.
  - Provides responsive grid/carousel controls and circular slider navigation.
{% enddoc %}

{%- liquid
  assign col_desktop = block.settings.columns_desktop | default: 3
  assign enable_swipe_mobile = block.settings.enable_swipe_mobile
  if enable_swipe_mobile == nil
    assign enable_swipe_mobile = true
  endif
  assign gap_desktop = block.settings.gap_desktop | default: 32
  assign gap_mobile = block.settings.gap_mobile | default: 16
  assign track_pad_desktop = block.settings.padding_desktop | default: 0
  assign track_pad_mobile = block.settings.padding_mobile | default: 20

  assign tab_gap_desktop = block.settings.tab_content_gap_desktop | default: 36
  assign tab_gap_mobile = block.settings.tab_content_gap_mobile | default: 24
  assign arrows_offset = block.settings.arrows_offset | default: 0

  assign tab_color_setting = block.settings.tab_color
  if tab_color_setting != blank and tab_color_setting != 'rgba(0,0,0,0)' and tab_color_setting != '#00000000'
    assign tab_color = tab_color_setting
  else
    assign tab_color = 'var(--vt-heading-color, var(--vt-foreground-color, var(--color-primary, #224E09)))'
  endif

  assign tab_active_color_setting = block.settings.tab_active_color
  if tab_active_color_setting != blank and tab_active_color_setting != 'rgba(0,0,0,0)' and tab_active_color_setting != '#00000000'
    assign tab_active_color = tab_active_color_setting
  else
    assign tab_active_color = 'var(--vt-color-secondary, var(--color-secondary, #71CC3B))'
  endif

  assign tab_line_color_setting = block.settings.tab_line_color
  if tab_line_color_setting != blank and tab_line_color_setting != 'rgba(0,0,0,0)' and tab_line_color_setting != '#00000000'
    assign tab_line_color = tab_line_color_setting
  else
    assign tab_line_color = 'var(--vt-heading-color, var(--vt-foreground-color, var(--color-primary, #224E09)))'
  endif

  assign tab_active_line_color_setting = block.settings.tab_active_line_color
  if tab_active_line_color_setting != blank and tab_active_line_color_setting != 'rgba(0,0,0,0)' and tab_active_line_color_setting != '#00000000'
    assign tab_active_line_color = tab_active_line_color_setting
  else
    assign tab_active_line_color = 'var(--vt-color-secondary, var(--color-secondary, #71CC3B))'
  endif
-%}

<collection-tabs 
  class="collection-tabs plt-listing-tab w-full block box-border{% if enable_swipe_mobile %} plt-listing-tab--swipe-mobile{% else %} plt-listing-tab--stack-mobile{% endif %}{% if request.visual_preview_mode %} plt-listing-tab--preview{% endif %}"
  data-block-id="{{ block.id }}"
  data-col-desktop="{{ col_desktop }}"
  data-swipe-mobile="{{ enable_swipe_mobile }}"
  data-gap-desktop="{{ gap_desktop }}"
  data-gap-mobile="{{ gap_mobile }}"
  data-show-arrows="{{ block.settings.show_arrows }}"
  data-arrows-mobile="{{ block.settings.show_arrows_mobile }}"
  {% if request.visual_preview_mode %}data-preview="true"{% endif %}
  style="
    --plt-col-desktop: {{ col_desktop }};
    --plt-gap-desktop: {{ gap_desktop }}px;
    --plt-gap-mobile: {{ gap_mobile }}px;
    --plt-pad-desktop: {{ track_pad_desktop }}px;
    --plt-pad-mobile: {{ track_pad_mobile }}px;
    --plt-menu-ph-desktop: {{ block.settings.menu_padding_desktop | default: 34 }}px;
    --plt-menu-ph-mobile: {{ block.settings.menu_padding_mobile | default: 20 }}px;
    --plt-tab-gap-desktop: {{ tab_gap_desktop }}px;
    --plt-tab-gap-mobile: {{ tab_gap_mobile }}px;
    --earth-nav-offset: {{ arrows_offset }}px;
    --plt-tab-color: {{ tab_color }};
    --plt-tab-active-color: {{ tab_active_color }};
    --plt-tab-line-color: {{ tab_line_color }};
    --plt-tab-active-line-color: {{ tab_active_line_color }};
    --plt-tab-font-size: {{ block.settings.tab_font_size | default: 18 }}px;
  "
  {{ block.shopify_attributes }}
>
  <!-- ================= Tablist Header ================= -->
  <div class="plt__tablist-container plt__tablist-container--center">
    <div 
      class="plt__tablist" 
      role="tablist" 
      aria-label="Collections"
    >
      {%- if request.visual_preview_mode -%}
        <button type="button" role="tab" class="plt__tab plt__tab--active" aria-selected="true">
          <span class="vt-heading vt-heading-h6">Tab 1</span>
        </button>
        <button type="button" role="tab" class="plt__tab" aria-selected="false">
          <span class="vt-heading vt-heading-h6">Tab 2</span>
        </button>
      {%- endif -%}
      <!-- Buttons will be mounted here by CollectionTabs element -->
    </div>
  </div>

  <!-- ================= Tab Panels Wrapper ================= -->
  <div class="plt__panels-wrapper">
    {% content_for 'blocks' %}
  </div>
</collection-tabs>

{% stylesheet %}
  /* =========================================================
     Collection Tabs (Layout, Tabs & Carousel)
     ========================================================= */
  collection-tabs.plt-listing-tab {
    display: flex;
    flex-direction: column;
    width: calc(100% + var(--vt-ph, 0px) * 2);
    margin-left: calc(-1 * var(--vt-ph, 0px));
    margin-right: calc(-1 * var(--vt-ph, 0px));
    position: relative;
    box-sizing: border-box;
  }

  /* ================= Tablist ================= */
  .plt__tablist-container {
    width: 100%;
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    box-sizing: border-box;
    margin-bottom: var(--plt-tab-gap-desktop, 36px);
    padding-left: var(--plt-menu-ph-desktop, 34px);
    padding-right: var(--plt-menu-ph-desktop, 34px);
    scroll-padding-left: var(--plt-menu-ph-desktop, 34px);
    scroll-padding-right: var(--plt-menu-ph-desktop, 34px);
  }

  .plt__tablist-container::-webkit-scrollbar {
    display: none;
  }

  .plt__tablist-container--center {
    justify-content: center;
  }

  .plt__tablist {
    display: inline-flex;
    align-items: center;
    position: relative;
    gap: 0;
    border-bottom: 1px solid var(--plt-tab-line-color, var(--vt-heading-color, var(--vt-foreground-color, var(--color-primary, #224E09))));
    padding: 0;
    min-width: max-content;
    counter-reset: plt-tab-counter;
  }

  .plt__tab[data-auto-title="true"] .vt-heading {
    counter-increment: plt-tab-counter;
  }

  .plt__tab[data-auto-title="true"] .vt-heading::after {
    content: " " counter(plt-tab-counter);
  }

  .plt__tablist--single,
  .plt__tablist:has(.plt__tab:only-child) {
    border-bottom-color: var(--plt-tab-active-line-color, var(--vt-color-secondary, var(--color-secondary, #71CC3B)));
  }

  .plt__tab {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 10px var(--plt-tab-item-ph, clamp(18px, 2.5vw, 32px)) 14px;
    font-family: inherit;
    font-size: var(--plt-tab-font-size, 18px);
    font-weight: 700;
    color: var(--plt-tab-color, var(--vt-heading-color, var(--vt-foreground-color, var(--color-primary, #224E09))));
    position: relative;
    transition: color 0.25s ease;
    user-select: none;
    outline: none;
    white-space: nowrap;
    text-align: center;
  }

  .plt__tab,
  .plt__tab .vt-heading,
  .plt__tab .vt-heading[class*="vt-heading-"] {
    font-size: var(--plt-tab-font-size, 18px);
    font-weight: 700;
    line-height: 1.25;
  }

  .plt__tab .vt-heading {
    color: inherit;
    display: inline-flex;
    margin: 0;
  }

  .plt__tab:hover {
    color: var(--plt-tab-active-color, var(--vt-color-secondary, var(--color-secondary, #71CC3B)));
  }

  .plt__tab--active {
    color: var(--plt-tab-active-color, var(--vt-color-secondary, var(--color-secondary, #71CC3B)));
  }

  /* Active bottom underline */
  .plt__tab--active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    width: 100%;
    height: 1px;
    background-color: var(--plt-tab-active-line-color, var(--vt-color-secondary, var(--color-secondary, #71CC3B)));
    z-index: 10;
  }

  .plt__tab:focus-visible {
    outline: 1px solid var(--plt-tab-active-color, var(--vt-color-secondary, var(--color-secondary, #71CC3B)));
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ================= Panels & Track ================= */
  .plt__panels-wrapper {
    width: 100%;
    position: relative;
  }

  .plt__panel {
    position: relative;
    width: 100%;
  }

  .plt__panel[hidden],
  .plt__panel--hidden {
    display: none;
  }

  /* SSR & Preview Fallback: ensure first panel is visible before JS activates */
  collection-tabs:not(:defined) collection-tab:first-of-type .plt__panel,
  .plt-listing-tab--preview collection-tab:first-of-type .plt__panel,
  collection-tabs[data-preview="true"] collection-tab:first-of-type .plt__panel {
    display: block;
  }

  .plt-listing-tab--preview collection-tab:not(:first-of-type) .plt__panel,
  collection-tabs[data-preview="true"] collection-tab:not(:first-of-type) .plt__panel {
    display: none;
  }

  .plt-listing-tab--preview .swiper-wrapper,
  collection-tabs[data-preview="true"] .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--plt-gap-desktop, 32px);
    overflow: hidden;
  }

  .plt-listing-tab--preview .plt__slide,
  collection-tabs[data-preview="true"] .plt__slide {
    flex: 0 0 calc((100% - (var(--plt-col-desktop, 3) - 1) * var(--plt-gap-desktop, 32px)) / var(--plt-col-desktop, 3));
    max-width: calc((100% - (var(--plt-col-desktop, 3) - 1) * var(--plt-gap-desktop, 32px)) / var(--plt-col-desktop, 3));
    box-sizing: border-box;
  }

  .plt-listing-tab--preview earth-slider-nav,
  collection-tabs[data-preview="true"] earth-slider-nav {
    display: none;
  }

  .plt__track {
    width: 100%;
    box-sizing: border-box;
    padding-left: var(--plt-pad-desktop, 0px);
    padding-right: var(--plt-pad-desktop, 0px);
    outline: none;
    position: relative;
  }

  .plt__track.swiper {
    overflow: hidden;
  }

  .plt__track .swiper-wrapper {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    width: 100%;
  }

  /* Fallback before Swiper is initialized (SSR / no-JS) */
  .plt__track:not(.swiper-initialized) {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: var(--plt-gap-desktop, 32px);
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-padding-left: var(--plt-pad-desktop, 0px);
    scroll-padding-right: var(--plt-pad-desktop, 0px);
    -webkit-overflow-scrolling: touch;
  }

  .plt__track:not(.swiper-initialized)::-webkit-scrollbar {
    display: none;
  }

  .plt__track:not(.swiper-initialized) > .swiper-wrapper {
    display: flex;
    align-items: stretch;
    gap: var(--plt-gap-desktop, 32px);
    width: 100%;
  }

  .plt__track:not(.swiper-initialized) .plt__slide {
    flex: 0 0 calc((100% - (var(--plt-gap-desktop, 32px) * (var(--plt-col-desktop, 3) - 1))) / var(--plt-col-desktop, 3));
    min-width: 0;
    scroll-snap-align: start;
  }

  .plt__track:not(.swiper-initialized) .plt__slide:last-child {
    scroll-snap-align: start end;
  }

  /* Swiper active state */
  .plt__track.swiper-initialized {
    overflow: hidden;
  }

  .plt__track.swiper-initialized > .swiper-wrapper {
    gap: 0;
  }

  .plt__track.swiper-initialized .plt__slide {
    flex-shrink: 0;
    height: auto;
    box-sizing: border-box;
  }

  /* Slide card base */
  .plt__slide {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    height: auto;
  }

  /* Ensure card and shopify-block wrapper inside stretch full height */
  .plt__slide > *,
  .plt__slide > .shopify-block,
  .plt__slide > shopify-block {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .plt__slide .vt-product-card {
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  /* ================= Empty State ================= */
  .plt__empty {
    width: 100%;
    text-align: center;
    padding: 60px 20px;
    box-sizing: border-box;
  }

  .plt__empty-text {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-primary, #224E09);
    margin: 0;
    opacity: 0.85;
  }

  /* ================= Mobile & Responsive ================= */
  @media screen and (max-width: 1024px) {
    .plt__track:not(.swiper-initialized) > .swiper-wrapper {
      gap: 24px;
    }

    .plt__track:not(.swiper-initialized) .plt__slide {
      flex: 0 0 calc((100% - (var(--plt-gap-desktop, 24px) * (2 - 1))) / 2);
    }
  }

  @media screen and (max-width: 768px) {
    .plt__tablist-container {
      justify-content: flex-start;
      margin-bottom: var(--plt-tab-gap-mobile, 24px);
      padding-left: var(--plt-menu-ph-mobile, 20px);
      padding-right: var(--plt-menu-ph-mobile, 20px);
      scroll-padding-left: var(--plt-menu-ph-mobile, 20px);
      scroll-padding-right: var(--plt-menu-ph-mobile, 20px);
    }

    .plt__tab,
    .plt__tab .vt-heading,
    .plt__tab .vt-heading[class*="vt-heading-"] {
      font-size: clamp(14px, calc(var(--plt-tab-font-size, 18px) - 2px), var(--plt-tab-font-size, 18px));
    }

    .plt__tab {
      padding: 8px var(--plt-tab-item-ph-mobile, 16px) 12px;
    }
    
    .plt__tablist-container--center {
    justify-content: center;
  }

    /* Swipeable mode (enable_swipe_mobile = true): 1.2 cards with edge peek */
    collection-tabs.plt-listing-tab--swipe-mobile {
      width: calc(100% + var(--vt-ph-mobile, var(--vt-ph, 0px)) * 2);
      margin-left: calc(-1 * var(--vt-ph-mobile, var(--vt-ph, 0px)));
      margin-right: calc(-1 * var(--vt-ph-mobile, var(--vt-ph, 0px)));
    }

    .plt-listing-tab--swipe-mobile .plt__track {
      padding-left: var(--plt-pad-mobile, 20px);
      padding-right: var(--plt-pad-mobile, 20px);
    }

    .plt-listing-tab--swipe-mobile .plt__track:not(.swiper-initialized) {
      gap: var(--plt-gap-mobile, 16px);
      scroll-padding-inline-start: 20px;
      scroll-padding-left: var(--plt-pad-mobile, 20px);
      scroll-padding-right: var(--plt-pad-mobile, 20px);
    }

    .plt-listing-tab--swipe-mobile .plt__track:not(.swiper-initialized) > .swiper-wrapper {
      gap: var(--plt-gap-mobile, 16px);
    }

    .plt-listing-tab--swipe-mobile .plt__track:not(.swiper-initialized) .plt__slide {
      flex: 0 0 calc((100% - var(--plt-gap-mobile, 16px)) / 1.2);
    }

    /* Stack mode (enable_swipe_mobile = false): 1 column */
    collection-tabs.plt-listing-tab--stack-mobile {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .plt-listing-tab--stack-mobile .plt__track {
      overflow: visible;
      padding-left: 0;
      padding-right: 0;
      display: block;
    }

    .plt-listing-tab--stack-mobile .plt__track > .swiper-wrapper {
      display: flex;
      flex-direction: column;
      gap: var(--plt-gap-mobile, 16px);
      width: 100%;
      transform: none;
    }

    .plt-listing-tab--stack-mobile .plt__slide {
      width: 100%;
      max-width: 100%;
      flex: 0 0 100%;
      margin-right: 0;
      transform: none;
    }

    .plt-listing-tab--stack-mobile earth-slider-nav {
      display: none;
    }

    .plt__nav-wrapper--desktop-only {
      display: none;
    }
  }
{% endstylesheet %}

<script src="{{ 'collection-tabs.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Collection tabs",
  "tag": null,
  "blocks": [
    {
      "type": "collection-tab"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout & Carousel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_mobile",
      "label": "Enable swipe on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Horizontal menu tab spacing"
    },
    {
      "type": "range",
      "id": "menu_padding_desktop",
      "label": "Tab menu padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "menu_padding_mobile",
      "label": "Tab menu padding (mobile)",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "label": "Tab font size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Tab Colors"
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "Tab text color"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab text color"
    },
    {
      "type": "color",
      "id": "tab_line_color",
      "label": "Tab line color"
    },
    {
      "type": "color",
      "id": "tab_active_line_color",
      "label": "Active line color"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "tab_content_gap_desktop",
      "label": "Space below tabs (desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "tab_content_gap_mobile",
      "label": "Space below tabs (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Product carousel track spacing"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Navigation arrows"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "arrows_visibility",
      "label": "Arrows visibility",
      "options": [
        { "value": "hover", "label": "Show on hover" },
        { "value": "always", "label": "Always visible" }
      ],
      "default": "hover"
    },
    {
      "type": "select",
      "id": "arrows_theme",
      "label": "Arrow button style",
      "options": [
        { "value": "light", "label": "Light / Cream (Green on hover)" },
        { "value": "green", "label": "Solid green" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "arrows_offset",
      "label": "Arrow button offset",
      "min": -20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show arrows on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "settings": {
        "columns_desktop": 3,
        "enable_swipe_mobile": true,
        "gap_desktop": 32,
        "gap_mobile": 16,
        "menu_padding_desktop": 34,
        "menu_padding_mobile": 20,
        "tab_font_size": 18,
        "padding_desktop": 34,
        "padding_mobile": 20,
        "show_arrows": true,
        "arrows_visibility": "hover",
        "arrows_theme": "light",
        "arrows_offset": 0,
        "show_arrows_mobile": false
      },
      "blocks": [
        {
          "type": "collection-tab",
          "settings": {
            "title": "Tab 1",
            "products_to_show": 8
          },
          "blocks": [
            {
              "type": "product-card",
              "id": "product-card",
              "static": true
            }
          ]
        },
        {
          "type": "collection-tab",
          "settings": {
            "title": "Tab 2",
            "products_to_show": 8
          },
          "blocks": [
            {
              "type": "product-card",
              "id": "product-card",
              "static": true
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
