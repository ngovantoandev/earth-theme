{% doc %}
  Renders a collection tabs parent container with carousel navigation.
  - Accepts 'collection-tab' child blocks.
  - Assembles tab buttons into a shared tablist header and manages panel switching.
  - Provides responsive grid/carousel controls and circular slider navigation.
{% enddoc %}

{%- liquid
  assign col_desktop = block.settings.columns_desktop | default: 3
  assign enable_swipe_mobile = block.settings.enable_swipe_mobile
  if enable_swipe_mobile == nil
    assign enable_swipe_mobile = true
  endif
  assign gap_desktop = block.settings.gap_desktop | default: 32
  assign gap_mobile = block.settings.gap_mobile | default: 16
  assign track_pad_desktop = block.settings.padding_desktop | default: 0
  assign track_pad_mobile = block.settings.padding_mobile | default: 20

  assign tab_gap_desktop = block.settings.tab_content_gap_desktop | default: 36
  assign tab_gap_mobile = block.settings.tab_content_gap_mobile | default: 24
  assign arrows_offset = block.settings.arrows_offset | default: 0
-%}

<collection-tabs 
  class="collection-tabs plt-listing-tab w-full block box-border{% if enable_swipe_mobile %} plt-listing-tab--swipe-mobile{% else %} plt-listing-tab--stack-mobile{% endif %}{% if request.visual_preview_mode %} plt-listing-tab--preview{% endif %}"
  data-block-id="{{ block.id }}"
  data-col-desktop="{{ col_desktop }}"
  data-swipe-mobile="{{ enable_swipe_mobile }}"
  data-gap-desktop="{{ gap_desktop }}"
  data-gap-mobile="{{ gap_mobile }}"
  data-show-arrows="{{ block.settings.show_arrows }}"
  data-arrows-mobile="{{ block.settings.show_arrows_mobile }}"
  {% if request.visual_preview_mode %}data-preview="true"{% endif %}
  style="
    --plt-col-desktop: {{ col_desktop }};
    --plt-gap-desktop: {{ gap_desktop }}px;
    --plt-gap-mobile: {{ gap_mobile }}px;
    --plt-pad-desktop: {{ track_pad_desktop }}px;
    --plt-pad-mobile: {{ track_pad_mobile }}px;
    --plt-menu-ph-desktop: {{ block.settings.menu_padding_desktop | default: 34 }}px;
    --plt-menu-ph-mobile: {{ block.settings.menu_padding_mobile | default: 20 }}px;
    --plt-tab-gap-desktop: {{ tab_gap_desktop }}px;
    --plt-tab-gap-mobile: {{ tab_gap_mobile }}px;
    --earth-nav-offset: {{ arrows_offset }}px;
  "
  {{ block.shopify_attributes }}
>
  <!-- ================= Tablist Header ================= -->
  <div class="plt__tablist-container plt__tablist-container--center">
    <div 
      class="plt__tablist" 
      role="tablist" 
      aria-label="Collections"
    >
      {%- if request.visual_preview_mode -%}
        <button type="button" role="tab" class="plt__tab plt__tab--active" aria-selected="true">
          <span class="vt-heading vt-heading-h6">Tab 1</span>
        </button>
        <button type="button" role="tab" class="plt__tab" aria-selected="false">
          <span class="vt-heading vt-heading-h6">Tab 2</span>
        </button>
      {%- endif -%}
      <!-- Buttons will be mounted here by CollectionTabs element -->
    </div>
  </div>

  <!-- ================= Tab Panels Wrapper ================= -->
  <div class="plt__panels-wrapper">
    {% content_for 'blocks' %}
  </div>
</collection-tabs>

{% stylesheet %}
  /* =========================================================
     Collection Tabs (Layout, Tabs & Carousel)
     ========================================================= */
  collection-tabs.plt-listing-tab {
    display: flex;
    flex-direction: column;
    width: calc(100% + var(--vt-ph, 0px) * 2);
    margin-left: calc(-1 * var(--vt-ph, 0px));
    margin-right: calc(-1 * var(--vt-ph, 0px));
    position: relative;
    box-sizing: border-box;
  }

  /* ================= Tablist ================= */
  .plt__tablist-container {
    width: 100%;
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    box-sizing: border-box;
    margin-bottom: var(--plt-tab-gap-desktop, 36px);
    padding-left: var(--plt-menu-ph-desktop, 34px);
    padding-right: var(--plt-menu-ph-desktop, 34px);
    scroll-padding-left: var(--plt-menu-ph-desktop, 34px);
    scroll-padding-right: var(--plt-menu-ph-desktop, 34px);
  }

  .plt__tablist-container::-webkit-scrollbar {
    display: none;
  }

  .plt__tablist-container--center {
    justify-content: center;
  }

  .plt__tablist {
    display: inline-flex;
    align-items: center;
    position: relative;
    gap: 0;
    border-bottom: 1px solid var(--plt-tab-line-color, var(--color-black, #003225));
    padding: 0;
    min-width: max-content;
    counter-reset: plt-tab-counter;
  }

  .plt__tab[data-auto-title="true"] .vt-heading {
    counter-increment: plt-tab-counter;
  }

  .plt__tab[data-auto-title="true"] .vt-heading::after {
    content: " " counter(plt-tab-counter);
  }

  .plt__tablist--single,
  .plt__tablist:has(.plt__tab:only-child) {
    border-bottom-color: var(--plt-tab-active-line-color, var(--color-secondary, #71CC3B));
  }

  .plt__tab {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 10px var(--plt-tab-item-ph, clamp(18px, 2.5vw, 32px)) 14px;
    font-family: inherit;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--plt-tab-color, var(--color-black, #003225));
    position: relative;
    transition: color 0.25s ease;
    user-select: none;
    outline: none;
    white-space: nowrap;
    text-align: center;
  }

  .plt__tab .vt-heading {
    color: inherit;
    display: inline-flex;
    margin: 0;
  }

  .plt__tab .vt-heading:not([class*="vt-heading-"]):not([class*="vt-hero-"]) {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .plt__tab:hover {
    color: var(--plt-tab-active-color, var(--color-secondary, #71CC3B));
  }

  .plt__tab--active {
    color: var(--plt-tab-active-color, var(--color-secondary, #71CC3B));
  }

  /* Active bottom underline */
  .plt__tab--active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    width: 100%;
    height: 2px;
    background-color: var(--plt-tab-active-line-color, var(--color-secondary, #71CC3B));
    z-index: 10;
  }

  .plt__tab:focus-visible {
    outline: 1px solid var(--color-secondary, #71CC3B);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ================= Panels & Track ================= */
  .plt__panels-wrapper {
    width: 100%;
    position: relative;
  }

  .plt__panel {
    position: relative;
    width: 100%;
  }

  .plt__panel[hidden],
  .plt__panel--hidden {
    display: none !important;
  }

  /* SSR & Preview Fallback: ensure first panel is visible before JS activates */
  collection-tabs:not(:defined) collection-tab:first-of-type .plt__panel,
  .plt-listing-tab--preview collection-tab:first-of-type .plt__panel,
  collection-tabs[data-preview="true"] collection-tab:first-of-type .plt__panel {
    display: block !important;
  }

  .plt-listing-tab--preview collection-tab:not(:first-of-type) .plt__panel,
  collection-tabs[data-preview="true"] collection-tab:not(:first-of-type) .plt__panel {
    display: none !important;
  }

  .plt-listing-tab--preview .swiper-wrapper,
  collection-tabs[data-preview="true"] .swiper-wrapper {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: var(--plt-gap-desktop, 32px) !important;
    overflow: hidden !important;
  }

  .plt-listing-tab--preview .plt__slide,
  collection-tabs[data-preview="true"] .plt__slide {
    flex: 0 0 calc((100% - (var(--plt-col-desktop, 3) - 1) * var(--plt-gap-desktop, 32px)) / var(--plt-col-desktop, 3)) !important;
    max-width: calc((100% - (var(--plt-col-desktop, 3) - 1) * var(--plt-gap-desktop, 32px)) / var(--plt-col-desktop, 3)) !important;
    box-sizing: border-box !important;
  }

  .plt-listing-tab--preview earth-slider-nav,
  collection-tabs[data-preview="true"] earth-slider-nav {
    display: none !important;
  }

  .plt__track {
    width: 100%;
    box-sizing: border-box;
    padding-left: var(--plt-pad-desktop, 0px);
    padding-right: var(--plt-pad-desktop, 0px);
    outline: none;
    position: relative;
  }

  .plt__track.swiper {
    overflow: hidden;
  }

  .plt__track .swiper-wrapper {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    width: 100%;
  }

  /* Fallback before Swiper is initialized (SSR / no-JS) */
  .plt__track:not(.swiper-initialized) {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: var(--plt-gap-desktop, 32px);
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-padding-left: var(--plt-pad-desktop, 0px);
    scroll-padding-right: var(--plt-pad-desktop, 0px);
    -webkit-overflow-scrolling: touch;
  }

  .plt__track:not(.swiper-initialized)::-webkit-scrollbar {
    display: none;
  }

  .plt__track:not(.swiper-initialized) > .swiper-wrapper {
    display: flex;
    align-items: stretch;
    gap: var(--plt-gap-desktop, 32px);
    width: 100%;
  }

  .plt__track:not(.swiper-initialized) .plt__slide {
    flex: 0 0 calc((100% - (var(--plt-gap-desktop, 32px) * (var(--plt-col-desktop, 3) - 1))) / var(--plt-col-desktop, 3));
    min-width: 0;
    scroll-snap-align: start;
  }

  .plt__track:not(.swiper-initialized) .plt__slide:last-child {
    scroll-snap-align: start end;
  }

  /* Swiper active state */
  .plt__track.swiper-initialized {
    overflow: hidden;
  }

  .plt__track.swiper-initialized > .swiper-wrapper {
    gap: 0 !important;
  }

  .plt__track.swiper-initialized .plt__slide {
    flex-shrink: 0;
    height: auto;
    box-sizing: border-box;
  }

  /* Slide card base */
  .plt__slide {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    height: auto;
  }

  /* Ensure card and shopify-block wrapper inside stretch full height */
  .plt__slide > *,
  .plt__slide > .shopify-block,
  .plt__slide > shopify-block {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .plt__slide .vt-product-card {
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  /* ================= Empty State ================= */
  .plt__empty {
    width: 100%;
    text-align: center;
    padding: 60px 20px;
    box-sizing: border-box;
  }

  .plt__empty-text {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-primary, #224E09);
    margin: 0;
    opacity: 0.85;
  }

  /* ================= Mobile & Responsive ================= */
  @media screen and (max-width: 1024px) {
    .plt__track:not(.swiper-initialized) > .swiper-wrapper {
      gap: 24px;
    }

    .plt__track:not(.swiper-initialized) .plt__slide {
      flex: 0 0 calc((100% - (var(--plt-gap-desktop, 24px) * (2 - 1))) / 2);
    }
  }

  @media screen and (max-width: 768px) {
    .plt__tablist-container {
      justify-content: flex-start;
      margin-bottom: var(--plt-tab-gap-mobile, 24px);
      padding-left: var(--plt-menu-ph-mobile, 20px);
      padding-right: var(--plt-menu-ph-mobile, 20px);
      scroll-padding-left: var(--plt-menu-ph-mobile, 20px);
      scroll-padding-right: var(--plt-menu-ph-mobile, 20px);
    }

    .plt__tab {
      font-size: 1rem;
      padding: 8px var(--plt-tab-item-ph-mobile, 16px) 12px;
    }

    /* Swipeable mode (enable_swipe_mobile = true): 1.2 cards with edge peek */
    collection-tabs.plt-listing-tab--swipe-mobile {
      width: calc(100% + var(--vt-ph-mobile, var(--vt-ph, 0px)) * 2);
      margin-left: calc(-1 * var(--vt-ph-mobile, var(--vt-ph, 0px)));
      margin-right: calc(-1 * var(--vt-ph-mobile, var(--vt-ph, 0px)));
    }

    .plt-listing-tab--swipe-mobile .plt__track {
      padding-left: var(--plt-pad-mobile, 20px);
      padding-right: var(--plt-pad-mobile, 20px);
    }

    .plt-listing-tab--swipe-mobile .plt__track:not(.swiper-initialized) {
      gap: var(--plt-gap-mobile, 16px);
      scroll-padding-inline-start: 20px;
      scroll-padding-left: var(--plt-pad-mobile, 20px);
      scroll-padding-right: var(--plt-pad-mobile, 20px);
    }

    .plt-listing-tab--swipe-mobile .plt__track:not(.swiper-initialized) > .swiper-wrapper {
      gap: var(--plt-gap-mobile, 16px);
    }

    .plt-listing-tab--swipe-mobile .plt__track:not(.swiper-initialized) .plt__slide {
      flex: 0 0 calc((100% - var(--plt-gap-mobile, 16px)) / 1.2);
    }

    /* Stack mode (enable_swipe_mobile = false): 1 column */
    collection-tabs.plt-listing-tab--stack-mobile {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .plt-listing-tab--stack-mobile .plt__track {
      overflow: visible !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      display: block;
    }

    .plt-listing-tab--stack-mobile .plt__track > .swiper-wrapper {
      display: flex !important;
      flex-direction: column !important;
      gap: var(--plt-gap-mobile, 16px) !important;
      width: 100% !important;
      transform: none !important;
    }

    .plt-listing-tab--stack-mobile .plt__slide {
      width: 100% !important;
      max-width: 100% !important;
      flex: 0 0 100% !important;
      margin-right: 0 !important;
      transform: none !important;
    }

    .plt-listing-tab--stack-mobile earth-slider-nav {
      display: none !important;
    }

    .plt__nav-wrapper--desktop-only {
      display: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('collection-tabs')) {
    class CollectionTabs extends HTMLElement {
      constructor() {
        super();
        this.tablist = null;
        this.tabs = [];
        this.panels = [];
        this.swipers = new Map();
        this._mqlMobile = window.matchMedia('(max-width: 767.98px)');
        this._onTabClick = this._onTabClick.bind(this);
        this._onKeydown = this._onKeydown.bind(this);
        this._onMediaChange = this._onMediaChange.bind(this);
      }

      connectedCallback() {
        if (this.dataset.preview === 'true') {
          return;
        }
        this.tablist = this.querySelector('.plt__tablist');
        this.buildTabs();

        this._mqlMobile.addEventListener('change', this._onMediaChange);

        // Observer in case blocks change dynamically in Theme Editor
        this._observer = new MutationObserver(() => {
          this.buildTabs();
        });
        const panelsWrapper = this.querySelector('.plt__panels-wrapper');
        if (panelsWrapper) {
          this._observer.observe(panelsWrapper, { childList: true });
        }

        // Theme Editor block select event
        document.addEventListener('shopify:block:select', (event) => {
          const selectedEl = event.target;
          if (selectedEl === this) {
            this.updateLayout();
            return;
          }
          if (this.contains(selectedEl)) {
            const tabBlock = selectedEl.closest('collection-tab') || selectedEl.querySelector('collection-tab');
            if (tabBlock) {
              const panel = tabBlock.querySelector('.plt__panel');
              if (panel) {
                const targetIdx = this.panels.indexOf(panel);
                if (targetIdx !== -1) {
                  this.activateTab(targetIdx);
                }
              }
            }
          }
        });
      }

      buildTabs() {
        if (!this.tablist) return;

        const tabBlocks = Array.from(this.querySelectorAll('collection-tab'));
        this.tabs = [];
        this.panels = [];

        tabBlocks.forEach((block) => {
          const blockId = block.dataset.blockId;
          const panel = block.querySelector('.plt__panel');
          if (!panel) return;

          // Check if button is already mounted inside this.tablist
          let btn = this.tablist.querySelector(`[data-block-id="${blockId}"]`);
          const blockBtn = block.querySelector('.plt__tab');

          if (blockBtn && blockBtn !== btn) {
            if (btn) {
              this.tablist.replaceChild(blockBtn, btn);
            } else {
              this.tablist.appendChild(blockBtn);
            }
            btn = blockBtn;
          }

          if (btn) {
            btn.dataset.blockId = blockId;
            btn.removeEventListener('click', this._onTabClick);
            btn.removeEventListener('keydown', this._onKeydown);
            btn.addEventListener('click', this._onTabClick);
            btn.addEventListener('keydown', this._onKeydown);

            if (btn.dataset.autoTitle === 'true' || btn.getAttribute('data-auto-title') === 'true') {
              const span = btn.querySelector('.vt-heading');
              if (span) {
                span.textContent = `Tab ${tabBlocks.indexOf(block) + 1}`;
                btn.removeAttribute('data-auto-title');
              }
            }

            this.tabs.push(btn);
            this.panels.push(panel);
          }
        });

        // Clean up any stale tab buttons from removed blocks
        const validIds = new Set(tabBlocks.map((b) => b.dataset.blockId));
        this.tablist.querySelectorAll('.plt__tab').forEach((tabBtn) => {
          if (!validIds.has(tabBtn.dataset.blockId)) {
            tabBtn.remove();
          }
        });

        if (this.tabs.length === 1) {
          this.tablist.classList.add('plt__tablist--single');
        } else {
          this.tablist.classList.remove('plt__tablist--single');
        }

        // Ensure active tab
        let activeIdx = this.tabs.findIndex((t) => t.classList.contains('plt__tab--active'));
        if (activeIdx === -1) activeIdx = 0;
        this.activateTab(activeIdx);
      }

      _onMediaChange() {
        if (this.dataset.swipeMobile === 'false') {
          if (this._mqlMobile.matches) {
            this.destroyAllSwipers();
          } else {
            this.initCarousels();
          }
        }
      }

      destroyAllSwipers() {
        this.swipers.forEach((swiper) => {
          if (swiper && typeof swiper.destroy === 'function') {
            swiper.destroy(true, true);
          }
        });
        this.swipers.clear();
      }

      initCarousels() {
        if (typeof window.Swiper === 'undefined') {
          const checkSwiper = setInterval(() => {
            if (typeof window.Swiper !== 'undefined') {
              clearInterval(checkSwiper);
              this.initCarousels();
            }
          }, 50);
          setTimeout(() => clearInterval(checkSwiper), 3000);
          return;
        }

        const tracks = this.querySelectorAll('.plt__track');
        tracks.forEach((track) => this.initSwiperForTrack(track));
      }

      initSwiperForTrack(track) {
        if (!track || this.swipers.has(track)) return;
        if (typeof window.Swiper === 'undefined') return;

        const isSwipeMobile = this.dataset.swipeMobile !== 'false';
        if (!isSwipeMobile && this._mqlMobile.matches) return;

        const colDesktop = parseFloat(this.dataset.colDesktop) || 3;
        const gapDesktop = parseFloat(this.dataset.gapDesktop) || 32;
        const gapMobile = parseFloat(this.dataset.gapMobile) || 16;

        const swiperInstance = new window.Swiper(track, {
          slidesPerView: isSwipeMobile ? 1.2 : 1,
          spaceBetween: gapMobile,
          grabCursor: true,
          watchOverflow: true,
          observer: true,
          observeParents: true,
          threshold: 5,
          breakpoints: {
            768: {
              slidesPerView: 2,
              spaceBetween: Math.min(gapDesktop, 24)
            },
            1024: {
              slidesPerView: colDesktop,
              spaceBetween: gapDesktop
            }
          },
          on: {
            init: () => this._notifyNav(track),
            slideChange: () => this._notifyNav(track),
            update: () => this._notifyNav(track),
            resize: () => this._notifyNav(track)
          }
        });

        this.swipers.set(track, swiperInstance);
        this._notifyNav(track);
      }

      _notifyNav(track) {
        if (!track) return;
        const panel = track.closest('.plt__panel');
        if (panel) {
          const nav = panel.querySelector('earth-slider-nav');
          if (nav && typeof nav.updateState === 'function') {
            nav.updateState();
          }
        }
      }

      _onTabClick(event) {
        const clickedTab = event.currentTarget;
        const targetIndex = this.tabs.indexOf(clickedTab);
        if (targetIndex !== -1) {
          this.activateTab(targetIndex);
        }
      }

      _onKeydown(event) {
        const currentTab = event.currentTarget;
        const currentIndex = this.tabs.indexOf(currentTab);
        let nextIndex = currentIndex;

        switch (event.key) {
          case 'ArrowRight':
            nextIndex = (currentIndex + 1) % this.tabs.length;
            break;
          case 'ArrowLeft':
            nextIndex = (currentIndex - 1 + this.tabs.length) % this.tabs.length;
            break;
          case 'Home':
            nextIndex = 0;
            break;
          case 'End':
            nextIndex = this.tabs.length - 1;
            break;
          default:
            return;
        }

        event.preventDefault();
        this.tabs[nextIndex].focus();
        this.activateTab(nextIndex);
      }

      activateTab(index) {
        if (!this.tabs[index]) return;

        this.tabs.forEach((tab, i) => {
          const isActive = i === index;
          tab.classList.toggle('plt__tab--active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');

          if (isActive) {
            tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });

        this.panels.forEach((panel, i) => {
          const isCurrent = i === index;
          panel.classList.toggle('plt__panel--hidden', !isCurrent);
          if (isCurrent) {
            panel.removeAttribute('hidden');
            const track = panel.querySelector('.plt__track');
            if (track) {
              if (!this.swipers.has(track)) {
                this.initSwiperForTrack(track);
              }
              const swiper = this.swipers.get(track);
              if (swiper) {
                window.requestAnimationFrame(() => {
                  swiper.update();
                  this._notifyNav(track);
                });
              } else {
                track.scrollLeft = 0;
                this._notifyNav(track);
              }
            }
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      }

      updateLayout() {
        const activeIndex = this.tabs.findIndex((t) => t.classList.contains('plt__tab--active'));
        if (activeIndex !== -1) {
          this.activateTab(activeIndex);
        }
      }

      disconnectedCallback() {
        if (this._observer) {
          this._observer.disconnect();
        }
        this._mqlMobile.removeEventListener('change', this._onMediaChange);
        this.destroyAllSwipers();
      }
    }

    customElements.define('collection-tabs', CollectionTabs);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Collection tabs",
  "tag": null,
  "blocks": [
    {
      "type": "collection-tab"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout & Carousel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_mobile",
      "label": "Enable swipe on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
