{% doc %}
  Renders a collection list layout.
  - When 'Collections' (collection_list) setting is selected, dynamically repeats cards for each collection.
  - Fallback renders child collection-card blocks if collection_list is empty.
  - Follows asymmetric 7/5 - 5/7 column pattern on desktop, 2-column on tablet, 1-column on mobile.
{% enddoc %}

{%- if block.settings.collection_list != blank and block.settings.collection_list.count > 0 -%}
  {%- assign items_to_loop = block.settings.collection_list -%}
  {%- assign is_connected = true -%}
{%- else -%}
  {%- assign items_to_loop = (1..4) -%}
  {%- assign is_connected = false -%}
{%- endif -%}

{%- assign desktop_layout = block.settings.desktop_layout | default: 'asymmetric' -%}
{%- case desktop_layout -%}
  {%- when '2_columns' -%}
    {%- assign desktop_grid_class = 'lg:grid-cols-2 [&>*]:col-span-1' -%}
  {%- when '3_columns' -%}
    {%- assign desktop_grid_class = 'lg:grid-cols-3 [&>*]:col-span-1' -%}
  {%- when '4_columns' -%}
    {%- assign desktop_grid_class = 'lg:grid-cols-4 [&>*]:col-span-1' -%}
  {%- else -%}
    {%- comment -%} Asymmetric 7/5 - 5/7 pattern on 12-column grid {%- endcomment -%}
    {%- assign desktop_grid_class = 'lg:grid-cols-12 [&>*]:col-span-1 lg:[&>*:nth-child(4n+1)]:col-span-7 lg:[&>*:nth-child(4n+4)]:col-span-7 lg:[&>*:nth-child(4n+2)]:col-span-5 lg:[&>*:nth-child(4n+3)]:col-span-5' -%}
{%- endcase -%}

{%- assign mobile_columns = block.settings.mobile_columns | default: '1' -%}
{%- if mobile_columns == '2' -%}
  {%- assign mobile_grid_class = 'grid-cols-2' -%}
{%- else -%}
  {%- assign mobile_grid_class = 'grid-cols-1' -%}
{%- endif -%}

<div
  class="vt-collection-list w-full box-border grid {{ mobile_grid_class }} md:grid-cols-2 {{ desktop_grid_class }} gap-[var(--vt-collection-gap-mobile,16px)] lg:gap-[var(--vt-collection-gap-desktop,30px)] [&>shopify-block]:flex [&>shopify-block]:flex-col [&>shopify-block]:w-full [&>shopify-block]:h-full"
  style="
    --vt-collection-gap-desktop: {{ block.settings.gap_desktop | default: 30 }}px;
    --vt-collection-gap-mobile: {{ block.settings.gap_mobile | default: 16 }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- for item in items_to_loop -%}
    {%- if is_connected -%}
      {%- assign current_col = item -%}
      {%- assign loop_idx = forloop.index -%}
    {%- else -%}
      {%- assign col_idx = forloop.index0 -%}
      {%- assign current_col = collections[col_idx] -%}
      {%- assign loop_idx = forloop.index -%}
    {%- endif -%}
    {% content_for "block", type: "collection-card", id: "collection_card", closest.collection: current_col, col: current_col, card_index: loop_idx %}
  {%- endfor -%}
</div>

{% stylesheet %}
  /* Mobile: Odd items on desktop (1, 3, 5...) -> về mobile BÉ, Even items (2, 4, 6...) -> về mobile TO */
  @media screen and (max-width: 768px) {
    .vt-collection-list > *:nth-child(4n + 1) .vt-collection-card,
    .vt-collection-list > *:nth-child(4n + 4) .vt-collection-card,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 1),
    .vt-collection-list > .vt-collection-card:nth-child(4n + 4),
    .vt-collection-list .vt-collection-card--mobile-small {
      min-height: 280px;
    }

    .vt-collection-list > *:nth-child(4n + 1) .vt-collection-card .vt-heading,
    .vt-collection-list > *:nth-child(4n + 4) .vt-collection-card .vt-heading,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 1) .vt-heading,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 4) .vt-heading,
    .vt-collection-list .vt-collection-card--mobile-small .vt-heading {
      font-size: clamp(1.25rem, 4.5vw, 1.5rem);
    }

    .vt-collection-list > *:nth-child(4n + 1) .vt-collection-card .vt-paragraph,
    .vt-collection-list > *:nth-child(4n + 4) .vt-collection-card .vt-paragraph,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 1) .vt-paragraph,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 4) .vt-paragraph,
    .vt-collection-list .vt-collection-card--mobile-small .vt-paragraph {
      font-size: 0.875rem;
      line-height: 1.35;
    }

    .vt-collection-list > *:nth-child(4n + 2) .vt-collection-card,
    .vt-collection-list > *:nth-child(4n + 3) .vt-collection-card,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 2),
    .vt-collection-list > .vt-collection-card:nth-child(4n + 3),
    .vt-collection-list .vt-collection-card--mobile-large {
      min-height: 480px;
    }

    .vt-collection-list > *:nth-child(4n + 2) .vt-collection-card .vt-heading,
    .vt-collection-list > *:nth-child(4n + 3) .vt-collection-card .vt-heading,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 2) .vt-heading,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 3) .vt-heading,
    .vt-collection-list .vt-collection-card--mobile-large .vt-heading {
      font-size: clamp(1.625rem, 5.5vw, 2rem);
    }

    .vt-collection-list > *:nth-child(4n + 2) .vt-collection-card .vt-paragraph,
    .vt-collection-list > *:nth-child(4n + 3) .vt-collection-card .vt-paragraph,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 2) .vt-paragraph,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 3) .vt-paragraph,
    .vt-collection-list .vt-collection-card--mobile-large .vt-paragraph {
      font-size: 1rem;
      line-height: 1.45;
    }
  }

  /* Scoped typography for dynamically rendered cards inside vt-collection-list */
  .vt-collection-list .vt-collection-card .vt-heading-h3 {
    color: #FFFFFF;
    font-family: var(--vt-font-family-heading);
    font-size: var(--vt-font-heading-3-size, clamp(1.5rem, 1.2rem + 1vw, 2rem));
    font-weight: var(--vt-font-heading-weight, 500);
    letter-spacing: -0.02em;
    line-height: var(--vt-font-heading-3-line-height, 1.2);
  }

  .vt-collection-list .vt-collection-card .vt-paragraph-medium {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    font-weight: 300;
    line-height: 1.4;
  }

  .vt-collection-list .vt-collection-card .vt-button--link-light {
    color: #FFFFFF;
    text-transform: uppercase;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .vt-collection-list .vt-collection-card .vt-button-icon {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background-color: #FFFFFF;
    color: #003225;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .vt-collection-list .vt-collection-card .vt-button-icon svg {
    width: 0.75rem;
    height: 0.625rem;
    color: #003225;
    fill: currentColor;
  }

  .vt-collection-list .vt-collection-card:hover .vt-button-icon {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-collection-list .vt-collection-card:hover .vt-button-icon {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "tag": null,
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "asymmetric",
          "label": "Asymmetric (7 / 5 - 5 / 7 cols)"
        },
        {
          "value": "2_columns",
          "label": "2 Columns"
        },
        {
          "value": "3_columns",
          "label": "3 Columns"
        },
        {
          "value": "4_columns",
          "label": "4 Columns"
        }
      ],
      "default": "asymmetric"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Grid Spacing"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop gap",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile gap",
      "default": 16
    }
  ],
  "blocks": [
    { "type": "collection-card" }
  ],
  "presets": [
    {
      "name": "Collection list",
      "settings": {
        "desktop_layout": "asymmetric",
        "mobile_columns": "1",
        "gap_desktop": 30,
        "gap_mobile": 16
      },
      "blocks": [
        {
          "id": "collection_card",
          "type": "collection-card",
          "static": true,
          "blocks": [
            {
              "type": "collection-title",
              "settings": {
                "heading_size": "vt-heading-h3",
                "heading_tag": "h3"
              }
            },
            {
              "type": "collection-paragraph",
              "settings": {
                "paragraph_size": "vt-paragraph-medium"
              }
            },
            {
              "type": "collection-button",
              "settings": {
                "button_label": "DISCOVER",
                "button_style": "link-light"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}


