{% doc %}
  Renders a collection list layout.
  - When 'Collections' (collection_list) setting is selected, dynamically repeats cards for each collection.
  - Fallback renders child collection-card blocks if collection_list is empty.
  - Follows asymmetric 7/5 - 5/7 column pattern on desktop, 2-column on tablet, 1-column on mobile.
{% enddoc %}

{%- if block.settings.collection_list != blank and block.settings.collection_list.count > 0 -%}
  {%- assign items_to_loop = block.settings.collection_list -%}
  {%- assign is_connected = true -%}
{%- else -%}
  {%- assign items_to_loop = (1..4) -%}
  {%- assign is_connected = false -%}
{%- endif -%}

{%- comment -%} Asymmetric 7/5 - 5/7 pattern on 12-column grid {%- endcomment -%}
{%- assign desktop_grid_class = 'lg:grid-cols-12 [&>*]:col-span-1 lg:[&>*:nth-child(4n+1)]:col-span-7 lg:[&>*:nth-child(4n+4)]:col-span-7 lg:[&>*:nth-child(4n+2)]:col-span-5 lg:[&>*:nth-child(4n+3)]:col-span-5' -%}
{%- assign mobile_grid_class = 'grid-cols-1' -%}

<div
  class="vt-collection-list w-full box-border grid {{ mobile_grid_class }} md:grid-cols-2 {{ desktop_grid_class }} gap-[var(--vt-collection-gap-mobile,16px)] lg:gap-[var(--vt-collection-gap-desktop,30px)] [&>shopify-block]:flex [&>shopify-block]:flex-col [&>shopify-block]:w-full [&>shopify-block]:h-full"
  style="
    --vt-collection-gap-desktop: {{ block.settings.gap_desktop | default: 30 }}px;
    --vt-collection-gap-mobile: {{ block.settings.gap_mobile | default: 16 }}px;
    --vt-collection-pv-desktop: {{ block.settings.padding_vertical | default: 0 }}px;
    --vt-collection-ph-desktop: {{ block.settings.padding_horizontal | default: 0 }}px;
    --vt-collection-pv-mobile: {{ block.settings.padding_vertical_mobile | default: 0 }}px;
    --vt-collection-ph-mobile: {{ block.settings.padding_horizontal_mobile | default: 0 }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- for item in items_to_loop -%}
    {%- if is_connected -%}
      {%- assign current_col = item -%}
      {%- assign loop_idx = forloop.index -%}
    {%- else -%}
      {%- assign col_idx = forloop.index0 -%}
      {%- assign current_col = collections[col_idx] -%}
      {%- assign loop_idx = forloop.index -%}
    {%- endif -%}
    {% content_for "block", type: "collection-card", id: "collection_card", closest.collection: current_col, col: current_col, card_index: loop_idx %}
  {%- endfor -%}
</div>

{% stylesheet %}
  .vt-collection-list {
    padding-top: var(--vt-collection-pv-desktop, 0px);
    padding-bottom: var(--vt-collection-pv-desktop, 0px);
    padding-left: var(--vt-collection-ph-desktop, 0px);
    padding-right: var(--vt-collection-ph-desktop, 0px);
  }

  /* Mobile: Desktop nhiều cột (7 cols: card 1 & 4) -> Mobile BÉ; Desktop ít cột (5 cols: card 2 & 3) -> Mobile TO */
  @media screen and (max-width: 768px) {
    .vt-collection-list {
      padding-top: var(--vt-collection-pv-mobile, 0px);
      padding-bottom: var(--vt-collection-pv-mobile, 0px);
      padding-left: var(--vt-collection-ph-mobile, 0px);
      padding-right: var(--vt-collection-ph-mobile, 0px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "tag": null,
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections"
    },

    {
      "type": "header",
      "content": "Grid Spacing"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop gap",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile gap",
      "default": 16
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 0
    }
  ],
  "blocks": [
    { "type": "collection-card" }
  ],
  "presets": [
    {
      "name": "Collection list",
      "settings": {
        "gap_desktop": 30,
        "gap_mobile": 16,
        "padding_vertical": 0,
        "padding_horizontal": 0,
        "padding_vertical_mobile": 0,
        "padding_horizontal_mobile": 0
      },
      "blocks": [
        {
          "type": "collection-card",
          "settings": {
            "padding_desktop": 32,
            "padding_mobile": 20,
            "overlay_opacity": 45,
            "content_position": "bottom",
            "content_alignment": "left",
            "enable_hover_zoom": true
          }
        }
      ]
    }
  ]
}
{% endschema %}


