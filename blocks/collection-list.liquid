{% doc %}
  Renders a collection list layout.
  - When 'Collections' (collection_list) setting is selected, dynamically repeats cards for each collection.
  - Fallback renders child collection-card blocks if collection_list is empty.
  - Follows asymmetric 7/5 - 5/7 column pattern on desktop, 2-column on tablet, 1-column on mobile.
{% enddoc %}

{%- if block.settings.collection_list != blank and block.settings.collection_list.count > 0 -%}
  {%- assign items_to_loop = block.settings.collection_list -%}
  {%- assign is_connected = true -%}
{%- else -%}
  {%- assign items_to_loop = (1..4) -%}
  {%- assign is_connected = false -%}
{%- endif -%}

{%- comment -%} Asymmetric 7/5 - 5/7 pattern on 12-column grid {%- endcomment -%}
{%- assign desktop_grid_class = 'lg:grid-cols-12 [&>*]:col-span-1 lg:[&>*:nth-child(4n+1)]:col-span-7 lg:[&>*:nth-child(4n+4)]:col-span-7 lg:[&>*:nth-child(4n+2)]:col-span-5 lg:[&>*:nth-child(4n+3)]:col-span-5' -%}
{%- assign mobile_grid_class = 'grid-cols-1' -%}

<div
  class="vt-collection-list w-full box-border grid {{ mobile_grid_class }} md:grid-cols-2 {{ desktop_grid_class }} gap-[var(--vt-collection-gap-mobile,16px)] lg:gap-[var(--vt-collection-gap-desktop,30px)] [&>shopify-block]:flex [&>shopify-block]:flex-col [&>shopify-block]:w-full [&>shopify-block]:h-full"
  style="
    --vt-collection-gap-desktop: {{ block.settings.gap_desktop | default: 30 }}px;
    --vt-collection-gap-mobile: {{ block.settings.gap_mobile | default: 16 }}px;
    --vt-collection-pv-desktop: {{ block.settings.padding_vertical | default: 0 }}px;
    --vt-collection-ph-desktop: {{ block.settings.padding_horizontal | default: 0 }}px;
    --vt-collection-pv-mobile: {{ block.settings.padding_vertical_mobile | default: 0 }}px;
    --vt-collection-ph-mobile: {{ block.settings.padding_horizontal_mobile | default: 0 }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- for item in items_to_loop -%}
    {%- if is_connected -%}
      {%- assign current_col = item -%}
      {%- assign loop_idx = forloop.index -%}
    {%- else -%}
      {%- assign col_idx = forloop.index0 -%}
      {%- assign current_col = collections[col_idx] -%}
      {%- assign loop_idx = forloop.index -%}
    {%- endif -%}
    {% content_for "block", type: "collection-card", id: "collection_card", closest.collection: current_col, col: current_col, card_index: loop_idx %}
  {%- endfor -%}
</div>

{% stylesheet %}
  .vt-collection-list {
    padding-top: var(--vt-collection-pv-desktop, 0px);
    padding-bottom: var(--vt-collection-pv-desktop, 0px);
    padding-left: var(--vt-collection-ph-desktop, 0px);
    padding-right: var(--vt-collection-ph-desktop, 0px);
  }

  /* Mobile: Desktop nhiều cột (7 cols: card 1 & 4) -> Mobile BÉ; Desktop ít cột (5 cols: card 2 & 3) -> Mobile TO */
  @media screen and (max-width: 768px) {
    .vt-collection-list {
      padding-top: var(--vt-collection-pv-mobile, 0px);
      padding-bottom: var(--vt-collection-pv-mobile, 0px);
      padding-left: var(--vt-collection-ph-mobile, 0px);
      padding-right: var(--vt-collection-ph-mobile, 0px);
    }

    /* Card BÉ trên mobile (Desktop 7 cột: Card 1 & 4) */
    .vt-collection-list > *:nth-child(4n + 1) .vt-collection-card,
    .vt-collection-list > *:nth-child(4n + 4) .vt-collection-card,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 1),
    .vt-collection-list > .vt-collection-card:nth-child(4n + 4),
    .vt-collection-list .vt-collection-card--mobile-small {
      min-height: 280px;
    }

    /* Card TO trên mobile (Desktop 5 cột: Card 2 & 3) */
    .vt-collection-list > *:nth-child(4n + 2) .vt-collection-card,
    .vt-collection-list > *:nth-child(4n + 3) .vt-collection-card,
    .vt-collection-list > .vt-collection-card:nth-child(4n + 2),
    .vt-collection-list > .vt-collection-card:nth-child(4n + 3),
    .vt-collection-list .vt-collection-card--mobile-large {
      min-height: 480px;
    }

    .vt-collection-list .vt-collection-card__content {
      padding: var(--vt-card-pad-mobile, 20px);
      gap: var(--vt-card-gap-mobile, 12px);
    }

    /* Fallback default heading size on mobile if no specific size class override */
    .vt-collection-list .vt-collection-card .vt-heading:not([class*="vt-heading-"]):not([class*="vt-hero-"]) {
      font-size: var(--vt-font-heading-3-size, clamp(1.5rem, 5vw, 1.875rem));
      line-height: var(--vt-font-heading-3-line-height, 1.25);
    }

    /* Fallback default paragraph size on mobile if no specific size class override */
    .vt-collection-list .vt-collection-card .vt-paragraph:not([class*="vt-paragraph-"]) {
      font-size: var(--vt-font-body-size, 0.9375rem);
      line-height: var(--vt-font-body-line-height, 1.45);
    }

    .vt-collection-list .vt-collection-card .vt-button,
    .vt-collection-list .vt-collection-card .vt-button--link,
    .vt-collection-list .vt-collection-card .vt-button--link-light {
      font-size: 0.875rem;
    }

    .vt-collection-list .vt-collection-card .vt-button .vt-button-icon {
      width: 1.625rem;
      height: 1.625rem;
    }
  }

  .vt-collection-list .vt-collection-card .vt-button--link-light {
    color: #FFFFFF;
    text-transform: uppercase;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .vt-collection-list .vt-collection-card .vt-button-icon {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background-color: #FFFFFF;
    color: #003225;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .vt-collection-list .vt-collection-card .vt-button-icon svg {
    width: 0.75rem;
    height: 0.625rem;
    color: #003225;
    fill: currentColor;
  }

  .vt-collection-list .vt-collection-card:hover .vt-button-icon {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-collection-list .vt-collection-card:hover .vt-button-icon {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
