    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Padding"
