{% doc %}
  Renders an icon block with optional icon box and fluid clamp sizing.

  @example
  {% content_for 'block', type: 'icons', id: 'icons' %}  
{% enddoc %}

{%- assign icon = block.settings.icon -%}

{%- assign icon_size_mobile_rem = block.settings.icon_size_mobile | times: 1.0 | divided_by: 16 -%}
{%- assign icon_size_desktop_rem = block.settings.icon_size_desktop | times: 1.0 | divided_by: 16 -%}

{%- if block.settings.show_box -%}
  {%- assign box_size_mobile_rem = block.settings.box_size_mobile | times: 1.0 | divided_by: 16 -%}
  {%- assign box_size_desktop_rem = block.settings.box_size_desktop | times: 1.0 | divided_by: 16 -%}
{%- endif -%}

{%- assign animation_type = block.settings.animation_type -%}

{%- assign vt_anim_classes = '' -%}
{%- unless animation_type == 'none' -%}
  {%- assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type -%}
  {%- if animation_type == 'slide' or animation_type == 'float' -%}
    {%- assign vt_anim_classes = vt_anim_classes
      | append: ' vt-animate--dir-'
      | append: block.settings.animation_direction
    -%}
  {%- endif -%}
{%- endunless -%}

{%- assign vt_style = '' -%}
{%- unless animation_type == 'none' -%}
  {%- assign vt_style = vt_style
    | append: '--vt-duration: '
    | append: block.settings.animation_duration
    | append: 's;'
  -%}
  {%- assign vt_style = vt_style | append: ' --vt-delay: ' | append: block.settings.animation_delay | append: 's;' -%}

  {%- if animation_type == 'slide' or animation_type == 'float' or animation_type == 'blur' -%}
    {%- case block.settings.animation_easing -%}
      {%- when 'linear' -%}
        {%- assign vt_easing_value = 'linear' -%}
      {%- when 'ease-out-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}
      {%- when 'ease-in-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)' -%}
      {%- when 'ease-in-out-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)' -%}
      {%- when 'ease-in-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)' -%}
      {%- when 'ease-out-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)' -%}
      {%- when 'ease-in-out-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)' -%}
      {%- else -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}
    {%- endcase -%}
    {%- assign vt_style = vt_style | append: ' --vt-easing: ' | append: vt_easing_value | append: ';' -%}
  {%- endif -%}

  {%- if animation_type == 'blur' -%}
    {%- assign vt_style = vt_style
      | append: ' --vt-blur: '
      | append: block.settings.animation_blur_intensity
      | append: 'px;'
    -%}
  {%- endif -%}
{%- endunless -%}

{%- capture icon_class -%}
  vt-icon
  vt-icon--{{ block.settings.icon }}
  {% if block.settings.show_box %}has-box{% endif %}
  {{ vt_anim_classes }}
{%- endcapture -%}
{%- assign icon_class = icon_class | strip -%}

<div
  class="{{ icon_class }}"
  style="
    --vt-icon-size-mobile: {{ icon_size_mobile_rem }}rem;
    --vt-icon-size-desktop: {{ icon_size_desktop_rem }}rem;
    --vt-icon-color: {{ block.settings.icon_color }};
    {% if block.settings.show_box %}
      --vt-box-size-mobile: {{ box_size_mobile_rem }}rem;
      --vt-box-size-desktop: {{ box_size_desktop_rem }}rem;
      --vt-box-bg-color: {{ block.settings.box_bg_color }};
      --vt-box-radius: {{ block.settings.box_radius }};
    {% endif %}
    {% if vt_style != '' %}
      {{ vt_style | strip }}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
