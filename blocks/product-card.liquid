{% doc %}
  Renders a sustainable product card for use inside product-listing-tab or product grids.
  - Centrally controlled by Global Theme Settings (config/settings_schema.json -> "Product cards").
  - Delegates rendering to snippets/product-card.liquid for 100% UI consistency theme-wide.
{% enddoc %}

{%- assign current_product = closest.product | default: product -%}
{%- render 'product-card',
  product: current_product,
  shopify_attributes: block.shopify_attributes
-%}


{% schema %}
{
  "name": "Product card",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit style in [theme settings](/admin/themes/current/editor?context=theme&category=Product+cards)"
    }
  ],
  "presets": [
    {
      "name": "Product card"
    }
  ]
}
{% endschema %}
