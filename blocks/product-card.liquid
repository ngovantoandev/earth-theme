{% doc %}
  Renders a sustainable product card for use inside product-listing-tab.
  - Image with 3:4 aspect ratio, hover image, and dark overlay.
  - Floating impact score badge and environmental metric chips (water, carbon).
  - Quick view hover trigger and link arrow.
  - Composition line, certification tags, origin country, discount label.
  - Bottom buy group with price block and add to cart button.
{% enddoc %}

{%- liquid
  assign current_product = closest.product | default: product | default: prod | default: block.settings.product

  # Seed mock index for preview/demo fallback
  assign demo_idx = card_index | default: 1

  if current_product != blank
    assign prod_title = current_product.title
    assign prod_url = current_product.url
    assign prod_price = current_product.price | money_without_trailing_zeros
    assign prod_compare_price = current_product.compare_at_price | money_without_trailing_zeros
    assign has_discount = false
    if current_product.compare_at_price > current_product.price
      assign has_discount = true
      assign discount_pct = current_product.compare_at_price | minus: current_product.price | times: 100.0 | divided_by: current_product.compare_at_price | round
    endif

    assign prod_image = current_product.featured_image
    assign prod_second_image = current_product.images[1]

    # Metafields with fallbacks
    assign impact_score = current_product.metafields.custom.impact_score | default: 95
    assign water_saved = current_product.metafields.custom.water_saved | default: '2,000 L'
    assign co2_saved = current_product.metafields.custom.co2_saved | default: '3.5 kg'
    assign composition = current_product.metafields.custom.composition | default: '100% Organic Cotton'
    assign origin_country = current_product.metafields.custom.origin_country | default: 'Made in Vietnam'
    assign certifications = current_product.metafields.custom.certifications.value
  else
    # Elegant fallback seed data matching the reference design
    assign is_demo = true
    assign prod_url = 'shopify://products'
    case demo_idx
      when 1
        assign prod_title = 'Regenerative Denim'
        assign prod_price = '$110'
        assign has_discount = false
        assign impact_score = 97
        assign water_saved = '3,200 L'
        assign co2_saved = '5.5 kg'
        assign composition = '100% Regenerative Organic Cotton'
        assign origin_country = 'Made in Vietnam'
        assign demo_tags = 'Organic Cotton,Recycled Materials' | split: ','
        assign demo_img_name = 'prod-denim.jpg'
      when 2
        assign prod_title = 'Essential Organic Tee'
        assign prod_price = '$68'
        assign prod_compare_price = '$128'
        assign has_discount = true
        assign discount_pct = 52
        assign impact_score = 95
        assign water_saved = '2,000 L'
        assign co2_saved = '3.5 kg'
        assign composition = '100% Organic Cotton'
        assign origin_country = 'Made in India'
        assign demo_tags = 'Fair Trade,Carbon Neutral' | split: ','
        assign demo_img_name = 'prod-tee.jpg'
      when 3
        assign prod_title = 'Classic Oxford Shirt'
        assign prod_price = '$68'
        assign has_discount = false
        assign impact_score = 93
        assign water_saved = '2,100 L'
        assign co2_saved = '3.8 kg'
        assign composition = '100% Organic Cotton'
        assign origin_country = 'Made in India'
        assign demo_tags = 'Plastic-Free,Organic Cotton' | split: ','
        assign demo_img_name = 'prod-oxford.jpg'
      else
        assign prod_title = 'Sustainable Chino Pants'
        assign prod_price = '$120'
        assign has_discount = false
        assign impact_score = 91
        assign water_saved = '2,800 L'
        assign co2_saved = '4.2 kg'
        assign composition = '98% Organic Cotton, 2% Elastane'
        assign origin_country = 'Made in Portugal'
        assign demo_tags = 'GOTS Certified,Zero Waste' | split: ','
        assign demo_img_name = 'prod-denim.jpg'
    endcase
  endif
-%}

<article 
  class="vt-product-card flex flex-col h-full w-full relative box-border flex-1"
  data-product-id="{{ current_product.id }}"
  style="
    --vt-media-info-gap: {{ block.settings.media_info_gap | default: 16 }}px;
    --vt-info-gap: {{ block.settings.info_gap | default: 12 }}px;
  "
  {{ block.shopify_attributes }}
>
  <!-- ================= 1. Media Section ================= -->
  <div class="vt-product-card__media-wrapper relative overflow-hidden group w-full aspect-[3/4] bg-[#f1f2e2] shrink-0">
    <a href="{{ prod_url }}" class="vt-product-card__media-link block w-full h-full relative cursor-pointer" aria-label="{{ prod_title }}">
      {%- if prod_image != blank -%}
        {{ prod_image | image_url: width: 800 | image_tag: 
          loading: 'lazy', 
          sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 85vw',
          widths: '360, 540, 720, 900',
          class: 'vt-product-card__img vt-product-card__img--primary w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105'
        }}
        {%- if prod_second_image != blank and block.settings.enable_hover_image -%}
          {{ prod_second_image | image_url: width: 800 | image_tag: 
            loading: 'lazy', 
            sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 85vw',
            widths: '360, 540, 720, 900',
            class: 'vt-product-card__img vt-product-card__img--secondary absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-out'
          }}
        {%- endif -%}
      {%- elsif demo_img_name != blank -%}
        <img 
          src="{{ demo_img_name | asset_url }}" 
          alt="{{ prod_title }}" 
          width="600" 
          height="800" 
          loading="lazy" 
          class="vt-product-card__img w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        >
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center bg-[#EAE060] text-[#003225]">
          {{ 'product-1' | placeholder_svg_tag: 'w-1/2 h-1/2 opacity-40' }}
        </div>
      {%- endif -%}
    </a>

    <!-- Hover dark overlay -->
    <div class="vt-product-card__overlay absolute inset-0 bg-black/15 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-10"></div>

    <!-- Top Left Impact Score Badge -->
    {%- if block.settings.show_impact_badge and impact_score != blank -%}
      <div class="vt-product-card__badge vt-product-card__badge--impact absolute top-3 left-3 z-20 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-md shadow-sm bg-[#003225] text-[#F8F9DC]">
        <svg width="15" height="16" viewBox="0 0 15 16" fill="currentColor" class="text-[#F8F9DC] shrink-0" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M5.25038 8.91809L9.81706 8.85208C10.4351 8.85208 10.9621 9.23993 11.1694 9.78409L12.2502 8.63524C12.189 8.41498 12.0313 8.21011 11.8066 8.06269C11.5456 7.89134 11.2272 7.81883 10.9338 7.86398C10.8041 7.88416 10.6964 7.92075 10.6051 7.97582C10.5504 8.009 10.4833 8.01481 10.4238 7.99155C10.3643 7.96795 10.3188 7.91836 10.3014 7.8568C10.1673 7.38515 9.63031 7.08246 9.07966 7.16728C8.92951 7.19054 8.79202 7.23637 8.67026 7.30306C8.67265 6.8557 8.67505 6.32693 8.67744 6.27016C8.67983 6.25819 8.6812 6.24587 8.68154 6.23322C8.69009 5.48693 9.40048 4.71943 10.1009 4.19545C10.236 4.35449 10.4108 4.47591 10.6129 4.54671C10.7511 4.59527 10.8807 4.61716 11.0028 4.61716C11.5292 4.61716 11.9229 4.21529 12.306 3.8247C12.621 3.5032 12.9466 3.17075 13.358 3.02881C13.4292 3.00453 13.4808 2.94297 13.4935 2.86909C13.5061 2.79521 13.4774 2.72031 13.4182 2.6738C12.8084 2.19223 11.8559 1.94495 11.1017 2.07252C10.6437 2.14982 10.2935 2.3564 10.0886 2.67003C10 2.77777 9.93163 2.89953 9.88512 3.03121C9.79209 3.29662 9.79551 3.5805 9.89299 3.84077C9.7165 3.97143 9.53728 4.11815 9.3632 4.27993C9.14875 4.47899 8.91583 4.72593 8.72054 5.0057C8.72738 4.60143 8.72361 4.21084 8.69865 3.84967C9.17645 3.548 9.49522 3.01548 9.49522 2.40941C9.49522 2.20762 9.45965 2.0089 9.38987 1.81942C9.2623 1.29305 8.88094 0.841583 8.28685 0.5129C7.29328 -0.0367296 5.83626 -0.158831 4.74385 0.215683C4.67305 0.239966 4.62106 0.301188 4.60841 0.375065C4.59575 0.449284 4.62414 0.524186 4.68297 0.570702C5.22233 0.997887 5.52776 1.65115 5.82327 2.28286C6.24395 3.18204 6.67866 4.11166 7.79297 4.11166C7.96843 4.11166 8.13773 4.08498 8.29711 4.03538C8.332 4.72935 8.29814 5.52865 8.26736 6.251C8.26394 6.33275 8.26052 7.27741 8.25744 7.71725C7.98245 8.06543 7.41538 8.13999 6.74331 7.90263C6.19847 7.9724 5.67859 8.23918 5.40908 8.58975C5.34512 8.67286 5.27603 8.78778 5.25038 8.91809ZM4.4073 14.8997L1.93379 10.5526L0 11.6529L2.4735 16L4.4073 14.8997ZM9.82014 9.26251C10.3896 9.26251 10.8527 9.72595 10.8527 10.2951C10.8527 10.8645 10.3896 11.328 9.82014 11.328H7.39417C7.28062 11.328 7.18896 11.4196 7.18896 11.5332C7.18896 11.6464 7.28062 11.7384 7.39417 11.7384H9.82014C10.6157 11.7384 11.2631 11.091 11.2631 10.2951C11.2631 10.2913 11.2628 10.2875 11.2628 10.2834L13.1583 8.26859C13.3464 8.06885 13.6026 7.95393 13.8793 7.94572C14.1559 7.93751 14.4183 8.03602 14.618 8.22413C14.8181 8.41224 14.9327 8.66807 14.9412 8.94477C14.9498 9.22147 14.8506 9.48414 14.6628 9.68388C14.0308 10.3556 13.5082 10.9347 13.0885 11.3995C11.955 12.6557 11.3859 13.2864 10.6478 13.5822C9.90359 13.8801 8.92814 13.8661 6.98546 13.8384C6.25148 13.8282 5.34307 13.8152 4.26365 13.8176L2.79329 11.2336C3.23792 10.435 3.8262 9.86276 4.69528 9.38427C4.75753 9.35007 4.81464 9.33502 4.88579 9.33399L9.82014 9.26251Z"/>
        </svg>
        <span class="vt-product-card__impact-text text-[#F8F9DC]">{{ impact_score }}% Impact</span>
      </div>
    {%- endif -%}

    <!-- Bottom Left Metric Chips -->
    {%- if block.settings.show_metrics -%}
      <div class="vt-product-card__metrics absolute bottom-3 left-3 z-20 flex items-center gap-2">
        {%- if water_saved != blank -%}
          <span class="vt-product-card__chip flex items-center gap-1.5 px-3 py-1 rounded-full text-md shadow-sm bg-[#EAE060] text-[#224E09]">
            <svg class="w-3.5 h-3.5 shrink-0 text-[#224E09]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
            </svg>
            <span class="vt-product-card__chip-text text-[#224E09]">{{ water_saved }}</span>
          </span>
        {%- endif -%}

        {%- if co2_saved != blank -%}
          <span class="vt-product-card__chip flex items-center gap-1.5 px-3 py-1 rounded-full text-md shadow-sm bg-[#EAE060] text-[#224E09]">
            <svg class="w-4 h-4 shrink-0 text-[#224E09]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>
            </svg>
            <span class="vt-product-card__chip-text text-[#224E09]">{{ co2_saved }}</span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Center Quick View Button (reveals on desktop hover) -->
    {%- if block.settings.show_quick_view -%}
      <button 
        type="button" 
        class="vt-product-card__quick-view absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-none text-md font-bold tracking-wider uppercase opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-md bg-[#71CC3B] hover:bg-[#62bf2f] text-[#003225] cursor-pointer"
        aria-label="Quick view {{ prod_title }}"
        data-quick-view-handle="{{ current_product.handle }}"
      >
        <svg class="w-5 h-5 shrink-0 text-[#003225]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <span>{{ block.settings.quick_view_text | default: 'QUICK VIEW' }}</span>
      </button>
    {%- endif -%}
  </div>

  <!-- ================= 2. Information Section ================= -->
  <div class="vt-product-card__content flex flex-col grow text-[#224E09] flex-1">
    <!-- Title -->
    <h3 class="vt-product-card__title text-xl font-bold leading-tight m-0 line-clamp-1 text-[#003225]">
      <a href="{{ prod_url }}" class="text-[#003225] hover:text-[#71CC3B] transition-colors">
        {{ prod_title }}
      </a>
    </h3>

    <!-- Composition description -->
    {%- if block.settings.show_composition and composition != blank -%}
      <p class="vt-product-card__composition text-md m-0 line-clamp-1 opacity-90 text-[#224E09]">
        {{ composition }}
      </p>
    {%- endif -%}

    <!-- Certification Tag Pills -->
    {%- if block.settings.show_tags -%}
      {%- assign tag_items = certifications | default: demo_tags -%}
      {%- if tag_items != blank and tag_items.size > 0 -%}
        <div class="vt-product-card__tags flex flex-wrap gap-2 m-0">
          {%- for tag in tag_items limit: 3 -%}
            <span class="vt-product-card__tag text-md px-3 py-1 rounded-full border border-[#003225] bg-[#EAE060] text-[#224E09]">
              {{ tag | strip }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- Meta row (Origin + Discount) -->
    <div class="vt-product-card__meta-row flex flex-wrap items-center gap-x-4 gap-y-1 text-md m-0 text-[#224E09]">
      {%- if block.settings.show_origin and origin_country != blank -%}
        <span class="vt-product-card__origin flex items-center gap-1.5 text-[#224E09]">
          <svg class="w-3.5 h-3.5 shrink-0 text-[#224E09]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{{ origin_country }}</span>
        </span>
      {%- endif -%}

      {%- if block.settings.show_discount and has_discount -%}
        <span class="vt-product-card__discount flex items-center gap-1.5 text-[#224E09]">
          <svg class="w-3.5 h-3.5 shrink-0 text-[#224E09]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7"/>
          </svg>
          <span>{{ discount_pct }}% Off (Price as Marked)</span>
        </span>
      {%- endif -%}
    </div>

    <!-- ================= 3. Buy Group (Aligned to bottom) ================= -->
    <div class="vt-product-card__buy-group mt-auto inline-flex items-stretch self-start shrink-0">
      <!-- Price block -->
      <div class="vt-product-card__price-box bg-[#003225] flex items-center gap-2 px-4 py-2.5">
        {%- if has_discount and prod_compare_price != blank -%}
          <span class="vt-product-card__compare-price line-through text-base font-bold text-[#F8F9DC]">
            {{ prod_compare_price }}
          </span>
        {%- endif -%}
        <span class="vt-product-card__price text-base font-bold text-[#F8F9DC]">
          {{ prod_price }}
        </span>
      </div>

      <!-- Add to Cart CTA -->
      {%- if is_demo -%}
        <button
          type="button"
          class="vt-product-card__add-btn bg-[#EAE060] hover:bg-[#dcd14e] text-[#003225] flex items-center gap-2 px-5 py-2.5 text-md font-bold tracking-wider uppercase transition-colors rounded-none"
        >
          <svg class="w-4 h-4 shrink-0 text-[#003225]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z"/>
            <path d="M16 17h4m-2-2v4"/>
          </svg>
          <span>{{ block.settings.add_to_cart_text | default: 'ADD TO CART' }}</span>
        </button>
      {%- else -%}
        {%- assign current_variant = current_product.selected_or_first_available_variant -%}
        {%- if current_variant.available -%}
          <form method="post" action="/cart/add" class="inline-flex m-0">
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <button
              type="submit"
              class="vt-product-card__add-btn bg-[#EAE060] hover:bg-[#dcd14e] text-[#003225] flex items-center gap-2 px-5 py-2.5 text-md font-bold tracking-wider uppercase transition-colors rounded-none"
            >
              <svg class="w-4 h-4 shrink-0 text-[#003225]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z"/>
                <path d="M16 17h4m-2-2v4"/>
              </svg>
              <span>{{ block.settings.add_to_cart_text | default: 'ADD TO CART' }}</span>
            </button>
          </form>
        {%- else -%}
          <button
            type="button"
            disabled
            class="vt-product-card__add-btn bg-[#EAE060]/50 text-[#003225]/60 vt-product-card__add-btn--disabled cursor-not-allowed flex items-center gap-2 px-5 py-2.5 text-md font-bold tracking-wider uppercase rounded-none"
          >
            SOLD OUT
          </button>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</article>

{% stylesheet %}
  .vt-product-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  /* Spacing dynamically driven by schema block range settings */
  .vt-product-card__content {
    padding-top: var(--vt-media-info-gap, 16px);
    row-gap: var(--vt-info-gap, 12px);
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .vt-product-card__buy-group {
    margin-top: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product data"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product override"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "media_info_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Media & info gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "info_gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Info items gap",
      "default": 12
    },
    {
      "type": "header",
      "content": "Media & Hover"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Show Quick View button",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_view_text",
      "label": "Quick View button label",
      "default": "QUICK VIEW"
    },
    {
      "type": "header",
      "content": "Badges & Metrics"
    },
    {
      "type": "checkbox",
      "id": "show_impact_badge",
      "label": "Show Impact score badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_metrics",
      "label": "Show Water & Carbon metric chips",
      "default": true
    },
    {
      "type": "header",
      "content": "Product information"
    },
    {
      "type": "checkbox",
      "id": "show_composition",
      "label": "Show composition line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show certification tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_origin",
      "label": "Show origin country",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Buy group"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to Cart button label",
      "default": "ADD TO CART"
    }
  ],
  "presets": [
    {
      "name": "Product card",
      "settings": {
        "media_info_gap": 16,
        "info_gap": 12,
        "enable_hover_image": true,
        "show_quick_view": true,
        "quick_view_text": "QUICK VIEW",
        "show_impact_badge": true,
        "show_metrics": true,
        "show_composition": true,
        "show_tags": true,
        "show_origin": true,
        "show_discount": true,
        "add_to_cart_text": "ADD TO CART"
      }
    }
  ]
}
{% endschema %}
