{% doc %}
  Renders a collection card block for use inside collection-list.
  Supports manual image override, optional link, and child blocks (collection-title, collection-paragraph, collection-button).
{% enddoc %}

{%- assign card_collection = block.settings.collection | default: closest.collection | default: col | default: collection -%}
{%- assign card_image = block.settings.image | default: card_collection.featured_image | default: card_collection.image -%}
{%- assign card_url = block.settings.link | default: card_collection.url | default: 'shopify://collections/all' -%}

{%- assign card_idx_num = card_index | default: 1 | plus: 0 -%}
{%- assign mod4 = card_idx_num | modulo: 4 -%}
{%- if mod4 == 1 or mod4 == 0 -%}
  {%- assign mobile_size_class = 'vt-collection-card--mobile-small' -%}
{%- else -%}
  {%- assign mobile_size_class = 'vt-collection-card--mobile-large' -%}
{%- endif -%}

{%- comment -%} Vertical position (Desktop & Mobile) {%- endcomment -%}
{%- assign v_desktop = block.settings.content_position_desktop | default: 'bottom' -%}
{%- case v_desktop -%}
  {%- when 'top' -%}
    {%- assign v_class_desktop = 'lg:justify-start' -%}
  {%- when 'center' -%}
    {%- assign v_class_desktop = 'lg:justify-center' -%}
  {%- else -%}
    {%- assign v_class_desktop = 'lg:justify-end' -%}
{%- endcase -%}

{%- assign v_mobile = block.settings.content_position_mobile | default: 'bottom' -%}
{%- case v_mobile -%}
  {%- when 'top' -%}
    {%- assign v_class_mobile = 'justify-start' -%}
  {%- when 'center' -%}
    {%- assign v_class_mobile = 'justify-center' -%}
  {%- else -%}
    {%- assign v_class_mobile = 'justify-end' -%}
{%- endcase -%}

{%- comment -%} Horizontal alignment (Desktop & Mobile) {%- endcomment -%}
{%- assign h_desktop = block.settings.content_alignment_desktop | default: 'left' -%}
{%- case h_desktop -%}
  {%- when 'center' -%}
    {%- assign h_class_desktop = 'lg:items-center lg:text-center' -%}
    {%- assign justify_desktop = 'center' -%}
  {%- when 'right' -%}
    {%- assign h_class_desktop = 'lg:items-end lg:text-right' -%}
    {%- assign justify_desktop = 'flex-end' -%}
  {%- else -%}
    {%- assign h_class_desktop = 'lg:items-start lg:text-left' -%}
    {%- assign justify_desktop = 'flex-start' -%}
{%- endcase -%}

{%- assign h_mobile = block.settings.content_alignment_mobile | default: 'left' -%}
{%- case h_mobile -%}
  {%- when 'center' -%}
    {%- assign h_class_mobile = 'items-center text-center' -%}
    {%- assign justify_mobile = 'center' -%}
  {%- when 'right' -%}
    {%- assign h_class_mobile = 'items-end text-right' -%}
    {%- assign justify_mobile = 'flex-end' -%}
  {%- else -%}
    {%- assign h_class_mobile = 'items-start text-left' -%}
    {%- assign justify_mobile = 'flex-start' -%}
{%- endcase -%}

{%- if block.settings.enable_hover_zoom != false -%}
  {%- assign img_zoom_class = 'group-hover:scale-105' -%}
  {%- assign card_zoom_class = 'vt-collection-card--has-zoom' -%}
{%- else -%}
  {%- assign img_zoom_class = '' -%}
  {%- assign card_zoom_class = '' -%}
{%- endif -%}

{%- comment -%}
  Build animation classes and custom properties
{%- endcomment -%}
{%- assign animation_type = block.settings.animation_type | default: 'none' -%}
{%- assign vt_anim_classes = '' -%}
{%- assign vt_anim_style = '' -%}

{%- unless animation_type == 'none' or request.visual_preview_mode -%}
  {%- assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type -%}
  {%- if animation_type == 'slide' or animation_type == 'float' -%}
    {%- assign vt_anim_classes = vt_anim_classes
      | append: ' vt-animate--dir-'
      | append: block.settings.animation_direction
    -%}
  {%- endif -%}

  {%- assign vt_anim_style = vt_anim_style
    | append: ' --vt-duration: '
    | append: block.settings.animation_duration | default: 1.2
    | append: 's;'
  -%}

  {%- assign vt_anim_style = vt_anim_style
    | append: ' --vt-delay: '
    | append: block.settings.animation_delay | default: 0.2
    | append: 's;'
  -%}

  {%- if animation_type == 'slide' or animation_type == 'float' or animation_type == 'blur' -%}
    {%- case block.settings.animation_easing -%}
      {%- when 'linear' -%}
        {%- assign vt_easing_value = 'linear' -%}
      {%- when 'ease-out-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}
      {%- when 'ease-in-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)' -%}
      {%- when 'ease-in-out-sine' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)' -%}
      {%- when 'ease-in-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)' -%}
      {%- when 'ease-out-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)' -%}
      {%- when 'ease-in-out-cubic' -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)' -%}
      {%- else -%}
        {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}
    {%- endcase -%}
    {%- assign vt_anim_style = vt_anim_style | append: ' --vt-easing: ' | append: vt_easing_value | append: ';' -%}
  {%- endif -%}

  {%- if animation_type == 'blur' -%}
    {%- assign vt_anim_style = vt_anim_style
      | append: ' --vt-blur: '
      | append: block.settings.animation_blur_intensity | default: 5
      | append: 'px;'
    -%}
  {%- endif -%}
{%- endunless -%}

<div
  class="vt-collection-card {{ mobile_size_class }} {{ card_zoom_class }} {{ vt_anim_classes }} group relative isolate overflow-hidden flex flex-col {{ v_class_mobile }} {{ v_class_desktop }} text-white w-full"
  style="
    --vt-card-pad-desktop: {{ block.settings.padding_desktop | default: 32 }}px;
    --vt-card-pad-mobile: {{ block.settings.padding_mobile | default: 20 }}px;
    --vt-card-gap-desktop: {{ block.settings.gap_desktop | default: 16 }}px;
    --vt-card-gap-mobile: {{ block.settings.gap_mobile | default: 12 }}px;
    --vt-ov-color: {{ block.settings.overlay_color | default: '#003225' }};
    --vt-ov-opacity: {{ block.settings.overlay_opacity | default: 45 | divided_by: 100.0 }};
    --vt-btn-justify-m: {{ justify_mobile }};
    --vt-btn-justify-d: {{ justify_desktop }};
    {{ vt_anim_style }}
  "
  {{ block.shopify_attributes }}
>
  {%- if card_image != blank -%}
    {%- capture image_classes -%}
      vt-collection-card__image absolute inset-0 size-full object-cover transition-transform duration-500 ease-out {{ img_zoom_class }} motion-reduce:transform-none
    {%- endcapture -%}
    {{
      card_image
      | image_url: width: 1400
      | image_tag:
        loading: 'lazy',
        sizes: '(min-width: 1024px) 58vw, (min-width: 768px) 50vw, 100vw',
        widths: '400, 600, 800, 1000, 1200, 1400',
        class: image_classes | strip
    }}
  {%- else -%}
    {%- assign svg_num = card_index | default: 1 -%}
    {%- if svg_num > 6 -%}{%- assign svg_num = 1 -%}{%- endif -%}
    <div class="absolute inset-0 size-full flex items-center justify-center text-white/20">
      {{ 'collection-' | append: svg_num | placeholder_svg_tag: 'size-full object-cover opacity-25' }}
    </div>
  {%- endif -%}

  <!-- Dark gradient overlay -->
  {%- if block.settings.enable_overlay != false -%}
    <div
      class="vt-collection-card__overlay pointer-events-none absolute inset-0 transition-opacity duration-300"
      aria-hidden="true"
    ></div>
  {%- endif -%}

  <!-- Direct link overlay when link is provided on card (disabled in design mode for easy block editing) -->
  {%- if card_url != blank -%}
    {%- unless request.design_mode -%}
      <a href="{{ card_url }}" class="absolute inset-0 z-20" aria-label="Collection link"></a>
    {%- endunless -%}
  {%- endif -%}

  <!-- Content -->
  <div class="vt-collection-card__content relative z-10 flex flex-col {{ h_class_mobile }} {{ h_class_desktop }} w-full pointer-events-auto">
    {% content_for 'blocks', closest.collection: card_collection %}
  </div>
</div>

{% stylesheet %}
  .vt-collection-card {
    position: relative;
    box-sizing: border-box;
    height: 100%;
    width: 100%;
  }

  .vt-collection-card__content {
    box-sizing: border-box;
    padding: var(--vt-card-pad-desktop, 32px);
    gap: var(--vt-card-gap-desktop, 16px);
  }

  .vt-collection-card__overlay {
    background: linear-gradient(
      to top,
      var(--vt-ov-color, #003225) 0%,
      color-mix(in srgb, var(--vt-ov-color, #003225) 30%, transparent) 45%,
      transparent 100%
    );
    opacity: var(--vt-ov-opacity, 0.45);
  }

  .vt-collection-card {
    position: relative;
    box-sizing: border-box;
    height: 100%;
    width: 100%;
    min-height: 532px;
  }

  @media screen and (max-width: 768px) {
    .vt-collection-card {
      min-height: 280px;
    }

    /* Card BÉ trên mobile (Desktop 7 cột: Card 1 & 4) */
    .vt-collection-card.vt-collection-card--mobile-small {
      min-height: 280px;
    }

    /* Card TO trên mobile (Desktop 5 cột: Card 2 & 3) */
    .vt-collection-card.vt-collection-card--mobile-large {
      min-height: 480px;
    }

    .vt-collection-card__content {
      padding: var(--vt-card-pad-mobile, 20px);
      gap: var(--vt-card-gap-mobile, 12px);
    }

    /* Fallback default heading size on mobile if no specific size class override */
    .vt-collection-card .vt-heading:not([class*="vt-heading-"]):not([class*="vt-hero-"]) {
      font-size: var(--vt-font-heading-3-size, clamp(1.5rem, 5vw, 1.875rem));
      line-height: var(--vt-font-heading-3-line-height, 1.25);
    }

    /* Fallback default paragraph size on mobile if no specific size class override */
    .vt-collection-card .vt-paragraph:not([class*="vt-paragraph-"]) {
      font-size: var(--vt-font-body-size, 0.9375rem);
      line-height: var(--vt-font-body-line-height, 1.45);
    }

    .vt-collection-card .vt-button,
    .vt-collection-card .vt-button--link,
    .vt-collection-card .vt-button--link-light {
      font-size: 0.875rem;
    }

    .vt-collection-card .vt-button .vt-button-icon {
      width: 1.625rem;
      height: 1.625rem;
    }
  }

  /* Support Theme Editor <shopify-block> wrappers */
  .vt-collection-card__content > shopify-block {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Alignment helpers for button CTA inside card */
  .vt-collection-card .vt-buttons {
    width: 100%;
    display: flex;
    justify-content: var(--vt-btn-justify-m, flex-start);
  }

  .vt-collection-card__content.items-center .vt-buttons,
  .vt-collection-card__content.text-center .vt-buttons {
    justify-content: center;
  }
  .vt-collection-card__content.items-center .vt-buttons > a,
  .vt-collection-card__content.text-center .vt-buttons > a {
    margin-inline: auto;
  }
  .vt-collection-card__content.items-center .vt-heading-wrapper,
  .vt-collection-card__content.text-center .vt-heading-wrapper {
    margin-inline: auto;
    text-align: center;
  }
  .vt-collection-card__content.items-center .vt-paragraph,
  .vt-collection-card__content.text-center .vt-paragraph {
    text-align: center;
    justify-content: center;
  }

  .vt-collection-card__content.items-end .vt-buttons,
  .vt-collection-card__content.text-right .vt-buttons {
    justify-content: flex-end;
  }
  .vt-collection-card__content.items-end .vt-buttons > a,
  .vt-collection-card__content.text-right .vt-buttons > a {
    margin-left: auto;
    margin-right: 0;
  }
  .vt-collection-card__content.items-end .vt-heading-wrapper,
  .vt-collection-card__content.text-right .vt-heading-wrapper {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }
  .vt-collection-card__content.items-end .vt-paragraph,
  .vt-collection-card__content.text-right .vt-paragraph {
    text-align: right;
    justify-content: flex-end;
  }

  .vt-collection-card__content.items-start .vt-buttons,
  .vt-collection-card__content.text-left .vt-buttons {
    justify-content: flex-start;
  }
  .vt-collection-card__content.items-start .vt-buttons > a,
  .vt-collection-card__content.text-left .vt-buttons > a {
    margin-right: auto;
    margin-left: 0;
  }
  .vt-collection-card__content.items-start .vt-heading-wrapper,
  .vt-collection-card__content.text-left .vt-heading-wrapper {
    margin-right: auto;
    margin-left: 0;
    text-align: left;
  }
  .vt-collection-card__content.items-start .vt-paragraph,
  .vt-collection-card__content.text-left .vt-paragraph {
    text-align: left;
    justify-content: flex-start;
  }

  @media screen and (min-width: 1024px) {
    .vt-collection-card .vt-buttons {
      justify-content: var(--vt-btn-justify-d, flex-start);
    }

    .vt-collection-card__content.lg\:items-end .vt-buttons,
    .vt-collection-card__content.lg\:text-right .vt-buttons {
      justify-content: flex-end;
    }
    .vt-collection-card__content.lg\:items-end .vt-buttons > a,
    .vt-collection-card__content.lg\:text-right .vt-buttons > a {
      margin-left: auto;
      margin-right: 0;
    }
    .vt-collection-card__content.lg\:items-end .vt-heading-wrapper,
    .vt-collection-card__content.lg\:text-right .vt-heading-wrapper {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }
    .vt-collection-card__content.lg\:items-end .vt-heading,
    .vt-collection-card__content.lg\:text-right .vt-heading {
      text-align: right;
    }
    .vt-collection-card__content.lg\:items-end .vt-paragraph,
    .vt-collection-card__content.lg\:text-right .vt-paragraph {
      text-align: right;
      justify-content: flex-end;
    }

    .vt-collection-card__content.lg\:items-center .vt-buttons,
    .vt-collection-card__content.lg\:text-center .vt-buttons {
      justify-content: center;
    }
    .vt-collection-card__content.lg\:items-center .vt-buttons > a,
    .vt-collection-card__content.lg\:text-center .vt-buttons > a {
      margin-inline: auto;
    }
    .vt-collection-card__content.lg\:items-center .vt-heading-wrapper,
    .vt-collection-card__content.lg\:text-center .vt-heading-wrapper {
      margin-inline: auto;
      text-align: center;
    }
    .vt-collection-card__content.lg\:items-center .vt-heading,
    .vt-collection-card__content.lg\:text-center .vt-heading {
      text-align: center;
    }
    .vt-collection-card__content.lg\:items-center .vt-paragraph,
    .vt-collection-card__content.lg\:text-center .vt-paragraph {
      text-align: center;
      justify-content: center;
    }

    .vt-collection-card__content.lg\:items-start .vt-buttons,
    .vt-collection-card__content.lg\:text-left .vt-buttons {
      justify-content: flex-start;
    }
    .vt-collection-card__content.lg\:items-start .vt-buttons > a,
    .vt-collection-card__content.lg\:text-left .vt-buttons > a {
      margin-right: auto;
      margin-left: 0;
    }
    .vt-collection-card__content.lg\:items-start .vt-heading-wrapper,
    .vt-collection-card__content.lg\:text-left .vt-heading-wrapper {
      margin-right: auto;
      margin-left: 0;
      text-align: left;
    }
    .vt-collection-card__content.lg\:items-start .vt-heading,
    .vt-collection-card__content.lg\:text-left .vt-heading {
      text-align: left;
    }
    .vt-collection-card__content.lg\:items-start .vt-paragraph,
    .vt-collection-card__content.lg\:text-left .vt-paragraph {
      text-align: left;
      justify-content: flex-start;
    }
  }

  /* Scoped typography for Heading inside collection card */
  .vt-collection-card .vt-heading,
  .vt-collection-card .vt-heading-wrapper h1,
  .vt-collection-card .vt-heading-wrapper h2,
  .vt-collection-card .vt-heading-wrapper h3,
  .vt-collection-card .vt-heading-wrapper h4,
  .vt-collection-card .vt-heading-wrapper h5,
  .vt-collection-card .vt-heading-wrapper h6 {
    color: #FFFFFF;
    font-family: var(--vt-font-family-heading);
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Default heading 3 size if no specific size class override */
  .vt-collection-card .vt-heading:not([class*="vt-heading-"]):not([class*="vt-hero-"]) {
    font-size: var(--vt-font-heading-3-size, clamp(1.5rem, 1.2rem + 1vw, 2rem));
    line-height: var(--vt-font-heading-3-line-height, 1.2);
  }

  /* Scoped typography for paragraph inside collection card */
  .vt-collection-card .vt-paragraph,
  .vt-collection-card .vt-paragraph p {
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }

  .vt-collection-card .vt-paragraph:not([class*="vt-paragraph-"]) {
    font-size: var(--vt-font-body-size, 1rem);
    line-height: var(--vt-font-body-line-height, 1.5);
  }

  /* Scoped CTA button styling inside collection card */
  .vt-collection-card .vt-buttons {
    margin-top: clamp(0.25rem, 0.5vw, 0.75rem);
  }

  .vt-collection-card .vt-button,
  .vt-collection-card .vt-button--link,
  .vt-collection-card .vt-button--link-light {
    color: #FFFFFF;
    text-transform: uppercase;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .vt-collection-card .vt-button .vt-button-icon {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background-color: #FFFFFF;
    color: #003225;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .vt-collection-card .vt-button .vt-button-icon svg {
    width: 0.75rem;
    height: 0.625rem;
    color: #003225;
    fill: currentColor;
  }

  .vt-collection-card:hover .vt-button .vt-button-icon,
  .vt-collection-card .vt-button:hover .vt-button-icon {
    transform: translateX(4px);
  }

  .vt-collection-card--has-zoom:hover .vt-collection-card__image {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-collection-card:hover .vt-button .vt-button-icon,
    .vt-collection-card .vt-button:hover .vt-button-icon,
    .vt-collection-card--has-zoom:hover .vt-collection-card__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection card",
  "tag": null,
  "blocks": [
    { "type": "collection-title" },
    { "type": "collection-paragraph" },
    { "type": "collection-button" }
  ],
  "settings": [
    // {
    //   "type": "header",
    //   "content": "Media & Link"
    // },
    // {
    //   "type": "collection",
    //   "id": "collection",
    //   "label": "Collection"
    // },
    // {
    //   "type": "image_picker",
    //   "id": "image",
    //   "label": "Image override"
    // },
    // {
    //   "type": "url",
    //   "id": "link",
    //   "label": "Link override"
    // },
    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Enable image zoom on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable dark overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#003225",
      "visible_if": "{{ block.settings.enable_overlay }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 45,
      "visible_if": "{{ block.settings.enable_overlay }}"
    },
    {
      "type": "header",
      "content": "Desktop alignment"
    },
    {
      "type": "select",
      "id": "content_position_desktop",
      "label": "Vertical position (Desktop)",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "content_alignment_desktop",
      "label": "Horizontal alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "min": 12,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Card padding (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap between blocks (Desktop)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mobile alignment"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Vertical position (Mobile)",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "content_alignment_mobile",
      "label": "Horizontal alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "min": 8,
      "max": 48,
